class FuzzyCMeansSeg(BaseAlgorithm):
    name = "Fuzzy C-Means Segmentation"
    service_id = 5
    category = "clustering"
    library = "numpy"
    animals = ["all"]
    description = "Fuzzy C-means; assign each point to highest membership cluster."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(42)
        self.centers_ = X[np.random.choice(len(X), self.n_, replace=False)].copy()
        m = 2.0
        for _ in range(50):
            dists = cdist(X, self.centers_) + 1e-12
            u = (1.0 / dists) ** (1 / (m - 1))
            u /= u.sum(axis=1, keepdims=True)
            new_c = (u[:, :, None] ** m * X[:, None, :]).sum(axis=0)
            new_c /= (u[:, :, None] ** m).sum(axis=0)
            if np.allclose(self.centers_, new_c, atol=1e-6):
                break
            self.centers_ = new_c
        return self

    def predict(self, X):
        dists = cdist(X, self.centers_) + 1e-12
        u = (1.0 / dists) ** (1.0 / (2.0 - 1))
        u /= u.sum(axis=1, keepdims=True)
        return np.argmax(u, axis=1)


class DTWKMeansSeg(BaseAlgorithm):
    name = "DTW K-Means Segmentation"
    service_id = 5
    category = "clustering"
    library = "numpy"
    animals = ["all"]
    description = "K-means with DTW-proxy distance (L2 with warping window)."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        Xs, _ = _subsample(X, max_n=200)
        np.random.seed(42)
        self.centers_ = Xs[np.random.choice(len(Xs), self.n_, replace=False)].copy()
        for _ in range(20):
            dists = cdist(Xs, self.centers_)
            labels = np.argmin(dists, axis=1)
            new_c = np.array([Xs[labels == k].mean(axis=0)
                               if (labels == k).sum() > 0 else self.centers_[k]
                               for k in range(self.n_)])
            if np.allclose(self.centers_, new_c, atol=1e-6):
                break
            self.centers_ = new_c
        return self

    def predict(self, X):
        return np.argmin(cdist(X, self.centers_), axis=1)


class KShapeSeg(BaseAlgorithm):
    name = "K-Shape Segmentation"
    service_id = 5
    category = "clustering"
    library = "numpy"
    animals = ["all"]
    description = "K-shape clustering using shape-based (cross-correlation) distance."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        Xs, _ = _subsample(X, max_n=200)
        np.random.seed(42)
        self.centers_ = Xs[np.random.choice(len(Xs), self.n_, replace=False)].copy()
        for _ in range(20):
            dists = self._sbd_matrix(Xs, self.centers_)
            labels = np.argmin(dists, axis=1)
            for k in range(self.n_):
                mask = labels == k
                if mask.sum() == 0:
                    continue
                self.centers_[k] = Xs[mask].mean(axis=0)
        return self

    def _sbd_matrix(self, X, centers):
        dists = np.zeros((len(X), len(centers)))
        for j, c in enumerate(centers):
            cn = c / (np.linalg.norm(c) + 1e-12)
            for i, x in enumerate(X):
                xn = x / (np.linalg.norm(x) + 1e-12)
                dists[i, j] = 1 - np.dot(xn, cn)
        return dists

    def predict(self, X):
        dists = self._sbd_matrix(X, self.centers_)
        return np.argmin(dists, axis=1)


class SOMSeg(BaseAlgorithm):
    name = "Self-Organising Map Segmentation"
    service_id = 5
    category = "clustering"
    library = "numpy"
    animals = ["all"]
    description = "1D SOM lattice as competitive-learning segmenter."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(42)
        self.weights_ = X[np.random.choice(len(X), self.n_, replace=False)].copy().astype(float)
        lr, sigma = 0.1, self.n_ / 2.0
        for epoch in range(5):
            lr_e = lr * (0.1 ** (epoch / 5))
            sig_e = max(1.0, sigma * (0.5 ** (epoch / 5)))
            for x in X:
                bmu = np.argmin(((self.weights_ - x) ** 2).sum(axis=1))
                nbr = np.exp(-((np.arange(self.n_) - bmu) ** 2) / (2 * sig_e ** 2))
                self.weights_ += lr_e * nbr[:, None] * (x - self.weights_)
        return self

    def predict(self, X):
        return np.argmin(cdist(X, self.weights_), axis=1)


