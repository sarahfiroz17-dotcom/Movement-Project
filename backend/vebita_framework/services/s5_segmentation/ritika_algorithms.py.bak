@registry.register
class CTMMSeg(BaseAlgorithm):
    name = "CTMM Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "Continuous-time movement model proxy: velocity autocorrelation cluster."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        speed = X[:, 0]
        tau = self._tau(speed)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(np.column_stack([speed, tau]))
        return self

    def _tau(self, speed):
        tau = np.zeros(len(speed))
        for i in range(len(speed)):
            lo = max(0, i - 20)
            seg = speed[lo:i + 1]
            if len(seg) > 2 and seg.std() > 1e-12:
                cc = np.corrcoef(seg[:-1], seg[1:])[0, 1]
                tau[i] = 0.0 if np.isnan(cc) else cc
        return tau

    def predict(self, X):
        speed = X[:, 0]
        tau = self._tau(speed)
        return self.model_.predict(np.column_stack([speed, tau]))


# ═══════════════════════════════════════════════════════════════════════════════
# 5. Deep Learning Approximations (13)
# ═══════════════════════════════════════════════════════════════════════════════

class LSTMSegProxy(BaseAlgorithm):
    name = "LSTM Segmenter Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "LSTM proxy: GRU-like online update; hidden state clusters into states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(42)
        d = X.shape[1]
        h = 8
        self.Wh_ = np.random.randn(h, h) * 0.1
        self.Wx_ = np.random.randn(h, d) * 0.1
        self.bh_ = np.zeros(h)
        hidden = self._run(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(hidden)
        return self

    def _run(self, X):
        h = np.zeros(self.Wh_.shape[0])
        hidden = np.zeros((len(X), len(h)))
        for i, x in enumerate(X):
            h = np.tanh(self.Wh_ @ h + self.Wx_ @ x + self.bh_)
            hidden[i] = h
        return hidden

    def predict(self, X):
        return self.model_.predict(self._run(X))


class BiLSTMSegProxy(BaseAlgorithm):
    name = "BiLSTM Segmenter Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "Bidirectional LSTM proxy: forward + backward hidden states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(1)
        d, h = X.shape[1], 8
        self.Wf_ = (np.random.randn(h, d) * 0.1, np.random.randn(h, h) * 0.1)
        self.Wb_ = (np.random.randn(h, d) * 0.1, np.random.randn(h, h) * 0.1)
        feats = self._run(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(feats)
        return self

    def _run_dir(self, X, W):
        Wx, Wh = W
        h = np.zeros(Wx.shape[0])
        out = np.zeros((len(X), len(h)))
        for i, x in enumerate(X):
            h = np.tanh(Wx @ x + Wh @ h)
            out[i] = h
        return out

    def _run(self, X):
        fwd = self._run_dir(X, self.Wf_)
        bwd = self._run_dir(X[::-1], self.Wb_)[::-1]
        return np.hstack([fwd, bwd])

    def predict(self, X):
        return self.model_.predict(self._run(X))


class GRUSegProxy(BaseAlgorithm):
    name = "GRU Segmenter Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "GRU-like update gate proxy for sequential segmentation."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(2)
        d, h = X.shape[1], 8
        self.Wz_ = np.random.randn(h, d + h) * 0.1
        self.Wr_ = np.random.randn(h, d + h) * 0.1
        self.Wn_ = np.random.randn(h, d + h) * 0.1
        hidden = self._run(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(hidden)
        return self

    def _sigmoid(self, x):
        return 1 / (1 + np.exp(-np.clip(x, -10, 10)))

    def _run(self, X):
        h = np.zeros(self.Wz_.shape[0])
        out = np.zeros((len(X), len(h)))
        for i, x in enumerate(X):
            xh = np.r_[x, h]
            z = self._sigmoid(self.Wz_ @ xh)
            r = self._sigmoid(self.Wr_ @ xh)
            n = np.tanh(self.Wn_ @ np.r_[x, r * h])
            h = (1 - z) * h + z * n
            out[i] = h
        return out

    def predict(self, X):
        return self.model_.predict(self._run(X))


class TCNSegProxy(BaseAlgorithm):
    name = "TCN Segmenter Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "Temporal convolutional network proxy: multi-scale dilated features."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        feats = self._tcn_features(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(feats)
        return self

    def _tcn_features(self, X):
        x = X[:, 0]
        feats = []
        for dilation in [1, 2, 4, 8]:
            kernel = np.array([1.0, -1.0])
            padded = np.pad(x, (dilation, 0), mode='edge')
            conv = np.convolve(padded, kernel, mode='valid')[:len(x)]
            feats.append(conv)
        return np.column_stack(feats)

    def predict(self, X):
        feats = self._tcn_features(X)
        return self.model_.predict(feats)


class TransformerSegProxy(BaseAlgorithm):
    name = "Transformer Segmenter Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "Self-attention proxy: weighted context representation per point."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        Xs, _ = _subsample(X, max_n=200)
        np.random.seed(3)
        d = X.shape[1]
        self.Wq_ = np.random.randn(d, d) * 0.1
        self.Wk_ = np.random.randn(d, d) * 0.1
        ctx = self._attn(Xs)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(ctx)
        self.Xs_ = Xs
        return self

    def _attn(self, X):
        Q = X @ self.Wq_
        K = X @ self.Wk_
        scale = np.sqrt(X.shape[1])
        ctx = np.zeros_like(X)
        for i in range(len(X)):
            scores = (Q[i] @ K.T) / scale
            w = np.exp(scores - scores.max())
            w /= w.sum() + 1e-12
            ctx[i] = (w[:, None] * X).sum(axis=0)
        return ctx

    def predict(self, X):
        Xs = self.Xs_
        Q = X @ self.Wq_
        K = Xs @ self.Wk_
        scale = np.sqrt(X.shape[1])
        ctx = np.zeros_like(X)
        for i in range(len(X)):
            scores = (Q[i] @ K.T) / scale
            w = np.exp(scores - scores.max())
            w /= w.sum() + 1e-12
            ctx[i] = (w[:, None] * Xs).sum(axis=0)
        return self.model_.predict(ctx)


class Conv1DSegProxy(BaseAlgorithm):
    name = "1D CNN Segmenter Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "1D convolutional feature extractor; k-means on pooled features."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(4)
        n_filters = 8
        self.kernels_ = np.random.randn(n_filters, 5) * 0.1
        feats = self._conv_features(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(feats)
        return self

    def _conv_features(self, X):
        x = X[:, 0]
        out = np.zeros((len(x), len(self.kernels_)))
        for j, k in enumerate(self.kernels_):
            out[:, j] = np.convolve(x, k[::-1], mode='same')
        return out

    def predict(self, X):
        return self.model_.predict(self._conv_features(X))


class UNet1DSegProxy(BaseAlgorithm):
    name = "Encoder-Decoder U-Net 1D Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "U-Net proxy: encode + decode with skip connections on speed signal."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        enc, dec = self._unet(X)
        feats = np.column_stack([enc, dec])
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(feats)
        return self

    def _unet(self, X):
        x = X[:, 0]
        enc = _rolling_mean(x, 10)
        dec = _rolling_mean(enc + (x - enc) * 0.5, 5)
        return enc, x - dec

    def predict(self, X):
        enc, dec = self._unet(X)
        feats = np.column_stack([enc, dec])
        return self.model_.predict(feats)


class VAEClusterSeg(BaseAlgorithm):
    name = "VAE Clustering Segmentation"
    service_id = 5
    category = "deep_learning"
    library = "scikit-learn"
    animals = ["all"]
    description = "VAE-proxy: PCA latent + noise perturbation; GMM clusters states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        n_comp = min(4, X.shape[1], X.shape[0] - 1)
        self.pca_ = PCA(n_components=n_comp)
        Z = self.pca_.fit_transform(X)
        np.random.seed(5)
        Z_noisy = Z + np.random.randn(*Z.shape) * 0.1
        self.model_ = GaussianMixture(n_components=self.n_, random_state=42)
        self.model_.fit(Z_noisy)
        return self

    def predict(self, X):
        Z = self.pca_.transform(X)
        return self.model_.predict(Z)


class DECSegProxy(BaseAlgorithm):
    name = "Deep Embedded Clustering Proxy"
    service_id = 5
    category = "deep_learning"
    library = "scikit-learn"
    animals = ["all"]
    description = "DEC proxy: iteratively refine cluster centres in PCA space."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        n_comp = min(4, X.shape[1], X.shape[0] - 1)
        self.pca_ = PCA(n_components=n_comp)
        Z = self.pca_.fit_transform(X)
        km = KMeans(n_clusters=self.n_, random_state=42, n_init=10)
        km.fit(Z)
        self.centers_ = km.cluster_centers_.copy()
        alpha = 1.0
        for _ in range(10):
            dists = cdist(Z, self.centers_) ** 2
            q = 1.0 / (1 + dists / alpha)
            q = (q.T / q.sum(axis=1)).T
            p = (q ** 2 / q.sum(axis=0))
            p = (p.T / p.sum(axis=1)).T
            labels = np.argmax(q, axis=1)
            for k in range(self.n_):
                mask = labels == k
                if mask.sum() > 0:
                    self.centers_[k] = Z[mask].mean(axis=0)
        return self

    def predict(self, X):
        Z = self.pca_.transform(X)
        return np.argmin(cdist(Z, self.centers_), axis=1)


class LSTMHMMHybridSeg(BaseAlgorithm):
    name = "LSTM-HMM Hybrid Segmentation"
    service_id = 5
    category = "deep_learning"
    library = "hmmlearn"
    animals = ["all"]
    description = "LSTM proxy extracts temporal features fed into Gaussian HMM."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(6)
        d, h = X.shape[1], 4
        self.Wx_ = np.random.randn(h, d) * 0.1
        self.Wh_ = np.random.randn(h, h) * 0.1
        feats = self._run(X)
        if _HMM_OK:
            self.model_ = _hmm.GaussianHMM(n_components=self.n_, covariance_type="diag",
                                             n_iter=30, random_state=42)
            if not _safe_fit_hmm(self.model_, feats):
                self.model_ = None
        else:
            self.model_ = None
        if self.model_ is None:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(feats)
        return self

    def _run(self, X):
        h = np.zeros(self.Wx_.shape[0])
        out = np.zeros((len(X), len(h)))
        for i, x in enumerate(X):
            h = np.tanh(self.Wx_ @ x + self.Wh_ @ h)
            out[i] = h
        return out

    def predict(self, X):
        feats = self._run(X)
        if self.model_ is not None:
            return _predict_hmm(self.model_, feats)
        return self.fallback_.predict(feats)


class DeepKalmanFilterSeg(BaseAlgorithm):
    name = "Deep Kalman Filter Segmentation"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "Deep Kalman proxy: latent state tracked by nonlinear filter."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        latent = self._filter(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(latent)
        return self

    def _filter(self, X):
        z = np.zeros((len(X), 2))
        prev = X[0, :2].copy()
        for i, x in enumerate(X):
            innov = x[:2] - prev
            z[i] = prev + 0.3 * innov
            prev = z[i]
        return z

    def predict(self, X):
        return self.model_.predict(self._filter(X))


class NeuralODESeg(BaseAlgorithm):
    name = "Neural ODE Segmentation"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "Neural ODE proxy: Euler-integrated learned dynamics."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(7)
        d = X.shape[1]
        self.W_ = np.random.randn(d, d) * 0.05
        integrated = self._integrate(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(integrated)
        return self

    def _integrate(self, X):
        dt = 0.1
        state = X.copy()
        for _ in range(3):
            dstate = np.tanh(state @ self.W_.T) * dt
            state = state + dstate
        return state

    def predict(self, X):
        return self.model_.predict(self._integrate(X))


class ContrastiveSelfSupSeg(BaseAlgorithm):
    name = "Contrastive Self-Supervised Segmentation"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "SimCLR proxy: augmented view similarity in PCA space."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        np.random.seed(8)
        n_comp = min(4, X.shape[1], X.shape[0] - 1)
        self.pca_ = PCA(n_components=n_comp)
        Z = self.pca_.fit_transform(X)
        noise = np.random.randn(*Z.shape) * 0.05
        Z_aug = Z + noise
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit((Z + Z_aug) / 2)
        return self

    def predict(self, X):
        Z = self.pca_.transform(X)
        return self.model_.predict(Z)


