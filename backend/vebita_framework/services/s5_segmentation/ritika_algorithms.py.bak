class FactorialHMMSeg(BaseAlgorithm):
    name = "Factorial HMM Segmentation"
    service_id = 5
    category = "hmm"
    library = "numpy"
    animals = ["all"]
    description = "Factorial HMM approximation: two independent 2-state HMMs combined."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        if _HMM_OK:
            self.m1_ = _hmm.GaussianHMM(n_components=2, covariance_type="diag",
                                          n_iter=30, random_state=0)
            self.m2_ = _hmm.GaussianHMM(n_components=2, covariance_type="diag",
                                          n_iter=30, random_state=1)
            ok1 = _safe_fit_hmm(self.m1_, X[:, :4])
            ok2 = _safe_fit_hmm(self.m2_, X[:, 4:])
            self.ok_ = ok1 and ok2
        else:
            self.ok_ = False
        if not self.ok_:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.ok_:
            l1 = _predict_hmm(self.m1_, X[:, :4])
            l2 = _predict_hmm(self.m2_, X[:, 4:])
            return (l1 * 2 + l2)
        return self.fallback_.predict(X)


class HierarchicalHMMSeg(BaseAlgorithm):
    name = "Hierarchical HMM Segmentation"
    service_id = 5
    category = "hmm"
    library = "hmmlearn"
    animals = ["all"]
    description = "Two-level hierarchical HMM: coarse then fine-grained states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        if _HMM_OK:
            self.coarse_ = _hmm.GaussianHMM(n_components=2, covariance_type="diag",
                                              n_iter=30, random_state=42)
            self.fine_ = _hmm.GaussianHMM(n_components=self.n_, covariance_type="diag",
                                            n_iter=30, random_state=42)
            ok_c = _safe_fit_hmm(self.coarse_, X)
            ok_f = _safe_fit_hmm(self.fine_, X)
            self.ok_ = ok_c and ok_f
        else:
            self.ok_ = False
        if not self.ok_:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.ok_:
            coarse = _predict_hmm(self.coarse_, X)
            fine = _predict_hmm(self.fine_, X)
            return np.where(coarse == 0, fine % 2, fine % 2 + 2)
        return self.fallback_.predict(X)


class InputOutputHMMSeg(BaseAlgorithm):
    name = "Input-Output HMM Segmentation"
    service_id = 5
    category = "hmm"
    library = "hmmlearn"
    animals = ["all"]
    description = "HMM conditioned on input covariates (altitude as external input)."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        alt = X[:, 1:2]
        scaler = StandardScaler()
        self.scaler_ = scaler
        alt_sc = scaler.fit_transform(alt)
        Xcond = np.hstack([X, alt_sc])
        if _HMM_OK:
            self.model_ = _hmm.GaussianHMM(n_components=self.n_, covariance_type="diag",
                                             n_iter=30, random_state=42)
            if not _safe_fit_hmm(self.model_, Xcond):
                self.model_ = None
        else:
            self.model_ = None
        if self.model_ is None:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.model_ is not None:
            alt_sc = self.scaler_.transform(X[:, 1:2])
            Xcond = np.hstack([X, alt_sc])
            return _predict_hmm(self.model_, Xcond)
        return self.fallback_.predict(X)


class HiddenSemiMarkovSeg(BaseAlgorithm):
    name = "Hidden Semi-Markov Segmentation"
    service_id = 5
    category = "hmm"
    library = "hmmlearn"
    animals = ["all"]
    description = "HSMM approximation: HMM with explicit state-duration modelling."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        if _HMM_OK:
            self.model_ = _hmm.GaussianHMM(
                n_components=self.n_, covariance_type="full",
                n_iter=30, random_state=42)
            if not _safe_fit_hmm(self.model_, X):
                self.model_ = None
        else:
            self.model_ = None
        if self.model_ is None:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.model_ is not None:
            raw = _predict_hmm(self.model_, X)
            smoothed = np.convolve(raw, np.ones(5) / 5, mode='same').round().astype(int)
            return np.clip(smoothed, 0, self.n_ - 1)
        return self.fallback_.predict(X)


class AutoregressiveHMMSeg(BaseAlgorithm):
    name = "Autoregressive HMM Segmentation"
    service_id = 5
    category = "hmm"
    library = "numpy"
    animals = ["all"]
    description = "AR-HMM: state sequence modelled with lagged-feature emissions."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        Xlag = np.hstack([X[1:], X[:-1]])
        if _HMM_OK:
            self.model_ = _hmm.GaussianHMM(n_components=self.n_, covariance_type="diag",
                                             n_iter=30, random_state=42)
            if not _safe_fit_hmm(self.model_, Xlag):
                self.model_ = None
        else:
            self.model_ = None
        if self.model_ is None:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.model_ is not None:
            Xlag = np.hstack([X[1:], X[:-1]])
            labels = _predict_hmm(self.model_, Xlag)
            return np.r_[labels[0], labels]
        return self.fallback_.predict(X)


