@registry.register
class SavitzkyGolaySeg(BaseAlgorithm):
    name = "Savitzky-Golay Segmentation"
    service_id = 5
    category = "statistical"
    library = "scipy"
    animals = ["all"]
    description = "SG-filtered residuals cluster into behavioral states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        x = X[:, 0]
        wl = min(21, len(x) - 1 if (len(x) - 1) % 2 != 0 else len(x) - 2)
        wl = wl if wl % 2 == 1 else wl - 1
        wl = max(wl, 5)
        smoothed = signal.savgol_filter(x, window_length=wl, polyorder=2)
        residuals = x - smoothed
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(np.column_stack([smoothed, np.abs(residuals)]))
        self.wl_ = wl
        return self

    def predict(self, X):
        x = X[:, 0]
        smoothed = signal.savgol_filter(x, window_length=self.wl_, polyorder=2)
        residuals = x - smoothed
        return self.model_.predict(np.column_stack([smoothed, np.abs(residuals)]))


@registry.register
class ACFSeg(BaseAlgorithm):
    name = "Autocorrelation Function Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "Rolling ACF features cluster into behavioural states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        feats = self._acf_features(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(feats)
        return self

    def _acf_features(self, X):
        x = X[:, 0]
        n = len(x)
        w = 20
        feats = np.zeros((n, 3))
        for i in range(n):
            lo = max(0, i - w)
            seg = x[lo:i + 1]
            if len(seg) < 4:
                feats[i] = [0, 0, 0]
                continue
            seg_c = seg - seg.mean()
            norm = (seg_c ** 2).sum() + 1e-12
            feats[i, 0] = np.dot(seg_c[:-1], seg_c[1:]) / norm
            feats[i, 1] = np.dot(seg_c[:-2], seg_c[2:]) / norm if len(seg_c) > 2 else 0
            feats[i, 2] = seg.std()
        return feats

    def predict(self, X):
        feats = self._acf_features(X)
        return self.model_.predict(feats)


class ChowStructuralBreakSeg(BaseAlgorithm):
    name = "Chow Structural Break Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "Chow F-test for structural breaks in AR coefficients."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        scores = np.zeros(n)
        w = max(10, n // 10)
        for i in range(w, n - w):
            a = x[i - w:i]
            b = x[i:i + w]
            scores[i] = abs(a.mean() - b.mean()) / (a.std() + b.std() + 1e-12)
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(scores))
            bkpts.append(peak)
            scores[max(0, peak - w):peak + w] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


