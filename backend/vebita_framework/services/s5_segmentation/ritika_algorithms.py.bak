@registry.register
class GaussianHMMDiagCov(BaseAlgorithm):
    name = "Gaussian HMM Diagonal Covariance"
    service_id = 5
    category = "hmm"
    library = "hmmlearn"
    animals = ["all"]
    description = "Gaussian HMM with diagonal (independent-feature) covariance."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        if _HMM_OK:
            self.model_ = _hmm.GaussianHMM(
                n_components=self.n_, covariance_type="diag",
                n_iter=50, random_state=42)
            if not _safe_fit_hmm(self.model_, X):
                self.model_ = None
        else:
            self.model_ = None
        if self.model_ is None:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.model_ is not None:
            return _predict_hmm(self.model_, X)
        return self.fallback_.predict(X)


