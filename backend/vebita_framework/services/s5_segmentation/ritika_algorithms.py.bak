class MultinomialHMMSeg(BaseAlgorithm):
    name = "Multinomial HMM Segmentation"
    service_id = 5
    category = "hmm"
    library = "hmmlearn"
    animals = ["all"]
    description = "HMM with multinomial emissions on discretised movement features."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        speed = X[:, 0]
        bins = np.percentile(speed, [33, 67])
        self.bins_ = bins
        Xd = np.digitize(speed, bins).reshape(-1, 1)
        if _HMM_OK:
            self.model_ = _hmm.CategoricalHMM(
                n_components=self.n_, n_iter=50, random_state=42)
            try:
                self.model_.fit(Xd, [len(Xd)])
                self.ok_ = True
            except Exception:
                self.ok_ = False
        else:
            self.ok_ = False
        if not self.ok_:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.ok_:
            Xd = np.digitize(X[:, 0], self.bins_).reshape(-1, 1)
            return _predict_hmm(self.model_, Xd)
        return self.fallback_.predict(X)


class GMMHMMSeg(BaseAlgorithm):
    name = "GMM-HMM Segmentation"
    service_id = 5
    category = "hmm"
    library = "hmmlearn"
    animals = ["all"]
    description = "HMM with Gaussian mixture model emissions per state."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        if _HMM_OK:
            self.model_ = _hmm.GMMHMM(
                n_components=self.n_, n_mix=2, covariance_type="diag",
                n_iter=30, random_state=42)
            if not _safe_fit_hmm(self.model_, X):
                self.model_ = None
        else:
            self.model_ = None
        if self.model_ is None:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(X)
        return self

    def predict(self, X):
        if self.model_ is not None:
            return _predict_hmm(self.model_, X)
        return self.fallback_.predict(X)


