@registry.register
class BCPASeg(BaseAlgorithm):
    name = "BCPA Segmentation"
    service_id = 5
    category = "ecology"
    library = "numpy"
    animals = ["all"]
    description = "Behavioural Change Point Analysis on speed and persistence."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        w = max(20, n // (self.n_ * 2))
        scores = np.zeros(n)
        for i in range(w, n - w):
            mu_l = x[i - w:i].mean()
            mu_r = x[i:i + w].mean()
            sd_l = x[i - w:i].std() + 1e-12
            sd_r = x[i:i + w].std() + 1e-12
            scores[i] = abs(mu_l - mu_r) / (sd_l + sd_r)
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(scores))
            bkpts.append(peak)
            scores[max(0, peak - w):peak + w] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


@registry.register
class EMbCSeg(BaseAlgorithm):
    name = "EMbC Segmentation"
    service_id = 5
    category = "ecology"
    library = "numpy"
    animals = ["all"]
    description = "Expectation-Maximisation Binary Clustering on speed+turning angle."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        feat = np.column_stack([X[:, 0], np.abs(X[:, 2])])
        self.med_speed_ = np.median(feat[:, 0])
        self.med_turn_ = np.median(feat[:, 1])
        return self

    def predict(self, X):
        feat = np.column_stack([X[:, 0], np.abs(X[:, 2])])
        hi_s = feat[:, 0] > self.med_speed_
        hi_t = feat[:, 1] > self.med_turn_
        labels = hi_s.astype(int) * 2 + hi_t.astype(int)
        if self.n_ < 4:
            labels = (labels * self.n_ // 4).clip(0, self.n_ - 1)
        return labels


@registry.register
class MoveHMMPortSeg(BaseAlgorithm):
    name = "moveHMM Port Segmentation"
    service_id = 5
    category = "ecology"
    library = "hmmlearn"
    animals = ["all"]
    description = "moveHMM-inspired HMM on step-length and turning angle features."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        feat = np.column_stack([X[:, 6], X[:, 2]])
        if _HMM_OK:
            self.model_ = _hmm.GaussianHMM(n_components=self.n_, covariance_type="full",
                                             n_iter=50, random_state=42)
            if not _safe_fit_hmm(self.model_, feat):
                self.model_ = None
        else:
            self.model_ = None
        if self.model_ is None:
            self.fallback_ = KMeans(n_clusters=self.n_, random_state=42).fit(feat)
        self.feat_cols_ = [6, 2]
        return self

    def predict(self, X):
        feat = X[:, self.feat_cols_]
        if self.model_ is not None:
            return _predict_hmm(self.model_, feat)
        return self.fallback_.predict(feat)


@registry.register
class RFBehavioralSeg(BaseAlgorithm):
    name = "Random Forest Behavioral Segmentation"
    service_id = 5
    category = "ecology"
    library = "scikit-learn"
    animals = ["all"]
    description = "Supervised Random Forest trained on labelled behavior classes."

    def fit(self, X, y=None):
        if y is None:
            self.fallback_ = KMeans(n_clusters=4, random_state=42).fit(X)
            self.supervised_ = False
        else:
            self.model_ = RandomForestClassifier(n_estimators=100, random_state=42)
            self.model_.fit(X, y)
            self.supervised_ = True
        return self

    def predict(self, X):
        if self.supervised_:
            return self.model_.predict(X)
        return self.fallback_.predict(X)


class GNNSegProxy(BaseAlgorithm):
    name = "GNN Segmentation Proxy"
    service_id = 5
    category = "deep_learning"
    library = "numpy"
    animals = ["all"]
    description = "Graph neural network proxy: message passing on k-NN trajectory graph."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        Xs, _ = _subsample(X, max_n=300)
        np.random.seed(9)
        d = X.shape[1]
        self.W_msg_ = np.random.randn(d, d) * 0.1
        agg = self._message_pass(Xs)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(agg)
        self.Xs_ = Xs
        self.agg_train_ = agg
        return self

    def _message_pass(self, X):
        k = min(5, len(X) - 1)
        nn = NearestNeighbors(n_neighbors=k + 1)
        nn.fit(X)
        _, idxs = nn.kneighbors(X)
        nbr_msgs = np.array([X[idxs[i, 1:]].mean(axis=0) for i in range(len(X))])
        agg = np.tanh(X @ self.W_msg_.T + nbr_msgs @ self.W_msg_.T)
        return agg

    def predict(self, X):
        k = min(5, len(self.Xs_) - 1)
        nn = NearestNeighbors(n_neighbors=k + 1)
        nn.fit(self.Xs_)
        _, idxs = nn.kneighbors(X)
        nbr_msgs = np.array([self.Xs_[idxs[i, 1:]].mean(axis=0) for i in range(len(X))])
        agg = np.tanh(X @ self.W_msg_.T + nbr_msgs @ self.W_msg_.T)
        return self.model_.predict(agg)


class MajorityVoteEnsembleSeg(BaseAlgorithm):
    name = "Majority Vote Ensemble Segmentation"
    service_id = 5
    category = "ecology"
    library = "numpy"
    animals = ["all"]
    description = "Ensemble of K-Means, GMM, and HMM by majority vote per point."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self.km_ = KMeans(n_clusters=self.n_, random_state=42, n_init=10).fit(X)
        self.gm_ = GaussianMixture(n_components=self.n_, random_state=42).fit(X)
        if _HMM_OK:
            self.hmm_ = _hmm.GaussianHMM(n_components=self.n_, covariance_type="diag",
                                           n_iter=30, random_state=42)
            if not _safe_fit_hmm(self.hmm_, X):
                self.hmm_ = None
        else:
            self.hmm_ = None
        return self

    def predict(self, X):
        p1 = self.km_.predict(X)
        p2 = self.gm_.predict(X)
        p3 = _predict_hmm(self.hmm_, X) if self.hmm_ is not None else p1
        combined = np.stack([p1, p2, p3], axis=1)
        result = np.array([np.bincount(row, minlength=self.n_).argmax()
                            for row in combined])
        return result
