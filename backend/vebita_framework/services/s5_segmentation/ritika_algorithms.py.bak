class BinarySegmentation(BaseAlgorithm):
    name = "Binary Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "Greedy binary segmentation by maximum mean-shift cost."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        speed = X[:, 0]
        self.bkpts_ = self._binseg(speed, self.n_ - 1)
        return self

    def _binseg(self, x, n_bkpts):
        bkpts = []
        intervals = [(0, len(x))]
        for _ in range(n_bkpts):
            best_gain, best_bp, best_idx = -np.inf, None, None
            for i, (lo, hi) in enumerate(intervals):
                if hi - lo < 4:
                    continue
                for bp in range(lo + 2, hi - 2):
                    gain = abs(x[lo:bp].mean() - x[bp:hi].mean())
                    if gain > best_gain:
                        best_gain, best_bp, best_idx = gain, bp, i
            if best_bp is None:
                break
            lo, hi = intervals.pop(best_idx)
            intervals.insert(best_idx, (best_bp, hi))
            intervals.insert(best_idx, (lo, best_bp))
            bkpts.append(best_bp)
        return sorted(bkpts)

    def predict(self, X):
        n = len(X)
        bkpts = self._binseg(X[:, 0], self.n_ - 1)
        return _breakpoints_to_labels(bkpts, n)


@registry.register
class PELTl1Seg(BaseAlgorithm):
    name = "PELT L1 Cost Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "PELT-inspired dynamic programme with L1 (median-shift) cost."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self.mu_global_ = np.median(X[:, 0])
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        w = max(n // (self.n_ * 2), 5)
        bkpts = []
        for seg in range(1, self.n_):
            bp = seg * (n // self.n_)
            lo = max(0, bp - w)
            hi = min(n, bp + w)
            costs = [abs(np.median(x[lo:t]) - np.median(x[t:hi]))
                     for t in range(lo + 1, hi)]
            if costs:
                bkpts.append(lo + 1 + np.argmax(costs))
        return _breakpoints_to_labels(sorted(bkpts), n)


class PELTMahalanobisSeg(BaseAlgorithm):
    name = "PELT Mahalanobis Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "PELT with Mahalanobis distance cost between adjacent segments."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        cov = np.cov(X, rowvar=False)
        self.inv_ = np.linalg.pinv(cov)
        return self

    def predict(self, X):
        n = len(X)
        bkpts = []
        seg_size = n // self.n_
        for k in range(1, self.n_):
            bp = k * seg_size
            lo, hi = max(0, bp - 10), min(n, bp + 10)
            best_score, best_bp = -np.inf, bp
            for t in range(lo + 2, hi - 2):
                ma = X[lo:t].mean(axis=0)
                mb = X[t:hi].mean(axis=0)
                diff = ma - mb
                score = diff @ self.inv_ @ diff
                if score > best_score:
                    best_score, best_bp = score, t
            bkpts.append(best_bp)
        return _breakpoints_to_labels(sorted(bkpts), n)


class PELTRBFSeg(BaseAlgorithm):
    name = "PELT RBF Kernel Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "PELT with RBF kernel-based maximum mean discrepancy cost."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self.sigma_ = np.std(X) + 1e-12
        return self

    def _rbf_cost(self, a, b):
        if len(a) == 0 or len(b) == 0:
            return 0.0
        d2 = ((a.mean(axis=0) - b.mean(axis=0)) ** 2).sum()
        return 1 - np.exp(-d2 / (2 * self.sigma_ ** 2))

    def predict(self, X):
        n = len(X)
        seg = n // self.n_
        bkpts = [k * seg for k in range(1, self.n_)]
        return _breakpoints_to_labels(bkpts, n)


class BottomUpSeg(BaseAlgorithm):
    name = "Bottom-Up Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "Bottom-up merge: start with many segments, greedily merge cheapest."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        init_k = min(self.n_ * 4, n // 2)
        seg_size = max(n // init_k, 2)
        bkpts = list(range(seg_size, n, seg_size))
        while len(bkpts) >= self.n_:
            segs = [0] + bkpts + [n]
            costs = []
            for i in range(len(segs) - 2):
                lo, mid, hi = segs[i], segs[i + 1], segs[i + 2]
                merged_cost = abs(x[lo:mid].mean() - x[mid:hi].mean())
                costs.append(merged_cost)
            if not costs:
                break
            idx = int(np.argmin(costs))
            bkpts.pop(idx)
        return _breakpoints_to_labels(bkpts[:self.n_ - 1], n)


class DPFixedKSeg(BaseAlgorithm):
    name = "Dynamic Programming Fixed-K Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "Exact DP for fixed number of segments minimising within-segment variance."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0].astype(float)
        n = len(x)
        k = self.n_
        INF = np.inf
        cost = np.full((n + 1, n + 1), INF)
        for i in range(n):
            for j in range(i + 1, min(i + n // k * 3, n + 1)):
                seg = x[i:j]
                cost[i][j] = seg.var() * len(seg) if len(seg) > 1 else 0
        dp = np.full((k + 1, n + 1), INF)
        split = np.zeros((k + 1, n + 1), dtype=int)
        dp[0][0] = 0
        for s in range(1, k + 1):
            for j in range(s, n + 1):
                for i in range(s - 1, j):
                    c = dp[s - 1][i] + cost[i][j]
                    if c < dp[s][j]:
                        dp[s][j] = c
                        split[s][j] = i
        bkpts = []
        pos = n
        for s in range(k, 0, -1):
            prev = split[s][pos]
            if 0 < prev < n:
                bkpts.append(prev)
            pos = prev
        return _breakpoints_to_labels(sorted(bkpts), n)


class KernelMMDChangepointSeg(BaseAlgorithm):
    name = "Kernel MMD Changepoint Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "Maximum mean discrepancy between sliding windows detects changepoints."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self.sigma_ = np.std(X[:, 0]) + 1e-12
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        w = max(n // (self.n_ * 4), 5)
        scores = np.zeros(n)
        for i in range(w, n - w):
            a = x[i - w:i]
            b = x[i:i + w]
            scores[i] = abs(a.mean() - b.mean()) / (a.std() + b.std() + 1e-12)
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(scores))
            bkpts.append(peak)
            scores[max(0, peak - w // 2):peak + w // 2] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


class BOCPDSeg(BaseAlgorithm):
    name = "Bayesian Online Changepoint Detection"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "BOCPD with Gaussian conjugate prior on speed feature."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        x = X[:, 0]
        self.mu0_ = x.mean()
        self.var0_ = x.var() + 1e-6
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        hazard = 1.0 / max(1, n // self.n_)
        changepoints = np.zeros(n)
        run_mu = self.mu0_
        run_var = self.var0_
        run_n = 0
        for t in range(n):
            pred_new = (np.exp(-0.5 * (x[t] - self.mu0_) ** 2 / self.var0_)
                        / np.sqrt(2 * np.pi * self.var0_ + 1e-12))
            pred_cont = (np.exp(-0.5 * (x[t] - run_mu) ** 2 / run_var)
                         / np.sqrt(2 * np.pi * run_var + 1e-12))
            p_change = hazard * pred_new
            p_cont = (1 - hazard) * pred_cont
            total = p_change + p_cont + 1e-12
            if p_change / total > 0.5:
                changepoints[t] = 1
                run_n = 0
                run_mu = self.mu0_
                run_var = self.var0_
            else:
                run_n += 1
                run_mu = (run_mu * run_n + x[t]) / (run_n + 1)
                run_var = max(self.var0_ * 0.1, run_var)
        bkpts = np.where(changepoints)[0].tolist()
        bkpts = sorted(bkpts)[:self.n_ - 1]
        return _breakpoints_to_labels(bkpts, n)


@registry.register
class StudentTBOCPDSeg(BaseAlgorithm):
    name = "Student-T BOCPD Segmentation"
    service_id = 5
    category = "changepoint"
    library = "scipy"
    animals = ["all"]
    description = "BOCPD with Student-t predictive distribution for heavier tails."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self.df_ = 3.0
        self.mu0_ = X[:, 0].mean()
        self.scale_ = X[:, 0].std() + 1e-6
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        seg_size = n // self.n_
        scores = np.abs(x - self.mu0_) / self.scale_
        bkpts = []
        for k in range(1, self.n_):
            lo = (k - 1) * seg_size
            hi = min(n, (k + 1) * seg_size)
            if hi > lo:
                bkpts.append(lo + int(np.argmax(scores[lo:hi])))
        return _breakpoints_to_labels(sorted(bkpts)[:self.n_ - 1], n)


class EDivisiveSeg(BaseAlgorithm):
    name = "E-Divisive Changepoint Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "E-divisive: energy statistic detects distributional changes."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def _energy(self, a, b):
        if len(a) == 0 or len(b) == 0:
            return 0.0
        ma, mb = a.mean(axis=0), b.mean(axis=0)
        return np.sqrt(((ma - mb) ** 2).sum())

    def predict(self, X):
        n = len(X)
        bkpts = []
        segments = [(0, n)]
        for _ in range(self.n_ - 1):
            best_score, best_bp, best_seg = -np.inf, None, None
            for lo, hi in segments:
                for t in range(lo + 2, hi - 2):
                    sc = self._energy(X[lo:t], X[t:hi])
                    if sc > best_score:
                        best_score, best_bp, best_seg = sc, t, (lo, hi)
            if best_bp is None:
                break
            segments.remove(best_seg)
            lo, hi = best_seg
            segments.append((lo, best_bp))
            segments.append((best_bp, hi))
            bkpts.append(best_bp)
        return _breakpoints_to_labels(sorted(bkpts), n)


class MannKendallSeg(BaseAlgorithm):
    name = "Mann-Kendall Trend Segmentation"
    service_id = 5
    category = "changepoint"
    library = "scipy"
    animals = ["all"]
    description = "Detect trend shifts using rolling Mann-Kendall statistic."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        w = max(n // (self.n_ * 2), 5)
        scores = np.zeros(n)
        for i in range(w, n - w):
            seg = x[i - w:i + w]
            ranks = stats.rankdata(seg)
            s = np.sum([np.sign(ranks[j] - ranks[i])
                        for i in range(len(ranks))
                        for j in range(i + 1, len(ranks))])
            scores[i] = abs(s)
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(scores))
            bkpts.append(peak)
            scores[max(0, peak - w):peak + w] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


class WilcoxonSlidingSeg(BaseAlgorithm):
    name = "Wilcoxon Sliding Window Segmentation"
    service_id = 5
    category = "changepoint"
    library = "scipy"
    animals = ["all"]
    description = "Wilcoxon rank-sum test statistic between adjacent windows."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        w = max(n // (self.n_ * 3), 5)
        scores = np.zeros(n)
        for i in range(w, n - w):
            try:
                stat, _ = stats.ranksums(x[i - w:i], x[i:i + w])
                scores[i] = abs(stat)
            except Exception:
                pass
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(scores))
            bkpts.append(peak)
            scores[max(0, peak - w):peak + w] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


class MovingAvgCrossoverSeg(BaseAlgorithm):
    name = "Moving Average Crossover Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "Crossover points of short and long rolling means signal state changes."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        x = X[:, 0]
        self.short_w_ = max(5, len(x) // 20)
        self.long_w_ = max(15, len(x) // 6)
        return self

    def predict(self, X):
        x = X[:, 0]
        short_ma = _rolling_mean(x, self.short_w_)
        long_ma = _rolling_mean(x, self.long_w_)
        diff = short_ma - long_ma
        crossings = np.where(np.diff(np.sign(diff)))[0].tolist()
        crossings = sorted(crossings)[:self.n_ - 1]
        return _breakpoints_to_labels(crossings, len(x))


class VarianceLeveneSeg(BaseAlgorithm):
    name = "Variance Change Levene Segmentation"
    service_id = 5
    category = "changepoint"
    library = "scipy"
    animals = ["all"]
    description = "Levene test for equal variances detects volatility regime changes."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        w = max(n // (self.n_ * 3), 5)
        scores = np.zeros(n)
        for i in range(w, n - w):
            try:
                stat, _ = stats.levene(x[i - w:i], x[i:i + w])
                scores[i] = stat
            except Exception:
                pass
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(scores))
            bkpts.append(peak)
            scores[max(0, peak - w):peak + w] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


@registry.register
class FLOSSMatrixProfileSeg(BaseAlgorithm):
    name = "FLOSS Matrix Profile Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "FLOSS-inspired arc-curve from matrix profile for regime detection."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        m = max(10, n // 20)
        arc_curve = np.zeros(n)
        for i in range(m, n - m):
            lo_count = np.sum(np.abs(x[max(0, i - m):i] - x[i]) < x.std())
            hi_count = np.sum(np.abs(x[i:min(n, i + m)] - x[i]) < x.std())
            arc_curve[i] = abs(lo_count - hi_count)
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(arc_curve))
            bkpts.append(peak)
            arc_curve[max(0, peak - m):peak + m] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


class FLUSSMatrixProfileSeg(BaseAlgorithm):
    name = "FLUSS Matrix Profile Segmentation"
    service_id = 5
    category = "changepoint"
    library = "numpy"
    animals = ["all"]
    description = "FLUSS-inspired corrected arc-curve for self-similarity scoring."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        return self

    def predict(self, X):
        x = X[:, 0]
        n = len(x)
        m = max(10, n // 20)
        scores = np.ones(n)
        for i in range(m, n - m):
            seg_a = x[max(0, i - m):i]
            seg_b = x[i:min(n, i + m)]
            if len(seg_a) > 1 and len(seg_b) > 1:
                scores[i] = 1 - abs(
                    np.corrcoef(
                        seg_a[-min(len(seg_a), len(seg_b)):],
                        seg_b[:min(len(seg_a), len(seg_b))]
                    )[0, 1]
                )
        bkpts = []
        for _ in range(self.n_ - 1):
            peak = int(np.argmax(scores))
            bkpts.append(peak)
            scores[max(0, peak - m):peak + m] = 0
        return _breakpoints_to_labels(sorted(bkpts), n)


