# 4. Statistical Methods (16)
# ═══════════════════════════════════════════════════════════════════════════════

@registry.register
class RuleBasedThreshSeg(BaseAlgorithm):
    name = "Rule-Based Multi-Threshold Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "Multi-feature threshold rules learned from training label quantiles."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        if y is not None:
            self.speed_thresholds_ = [
                np.percentile(X[y == c, 0], 75) if (y == c).sum() > 0 else np.inf
                for c in range(self.n_)
            ]
        else:
            q = np.percentile(X[:, 0], np.linspace(0, 100, self.n_ + 1)[1:-1])
            self.speed_thresholds_ = list(q) + [np.inf]
        return self

    def predict(self, X):
        speed = X[:, 0]
        labels = np.zeros(len(X), dtype=int)
        thrs = sorted(self.speed_thresholds_)
        for i, thr in enumerate(thrs):
            labels[speed > thr] = min(i + 1, self.n_ - 1)
        return labels


@registry.register
class FirstPassageTimeSeg(BaseAlgorithm):
    name = "First Passage Time Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "FPT-based segmentation: time to cross threshold identifies foraging."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self.thr_ = np.percentile(X[:, 0], 50)
        return self

    def predict(self, X):
        speed = X[:, 0]
        labels = np.zeros(len(X), dtype=int)
        w = 10
        for i in range(len(X)):
            lo, hi = max(0, i - w), min(len(X), i + w)
            crossings = np.sum(np.diff(np.sign(speed[lo:hi] - self.thr_)) != 0)
            labels[i] = min(crossings, self.n_ - 1)
        return labels


class NetSquaredDispSeg(BaseAlgorithm):
    name = "Net Squared Displacement Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "NSD-based segmentation; curvature changes mark behavioral transitions."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        step = X[:, 6]
        nsd = np.cumsum(step ** 2)
        acc = np.abs(np.diff(np.diff(nsd, prepend=nsd[0]), prepend=0))
        thr95 = np.percentile(acc, 100 * (1 - 1 / self.n_))
        self.thr_ = thr95
        return self

    def predict(self, X):
        step = X[:, 6]
        nsd = np.cumsum(step ** 2)
        acc = np.abs(np.diff(np.diff(nsd, prepend=nsd[0]), prepend=0))
        labels = np.zeros(len(X), dtype=int)
        labels[acc > self.thr_] = 1
        if self.n_ > 2:
            hi_thr = np.percentile(acc, 99)
            labels[acc > hi_thr] = 2
        return labels


