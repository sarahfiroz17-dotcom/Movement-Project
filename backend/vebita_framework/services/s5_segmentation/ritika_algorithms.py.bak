@registry.register
class KMedoidsSeg(BaseAlgorithm):
    name = "K-Medoids Segmentation"
    service_id = 5
    category = "clustering"
    library = "numpy"
    animals = ["all"]
    description = "K-medoids (PAM) using L2 distance; robust to outliers."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        Xs, _ = _subsample(X, max_n=300)
        n = len(Xs)
        np.random.seed(42)
        medoid_idx = np.random.choice(n, self.n_, replace=False)
        for _ in range(20):
            dists = cdist(Xs, Xs[medoid_idx])
            labels = np.argmin(dists, axis=1)
            new_med = []
            for k in range(self.n_):
                mask = labels == k
                if mask.sum() == 0:
                    new_med.append(medoid_idx[k])
                    continue
                cluster_pts = Xs[mask]
                inner_d = cdist(cluster_pts, cluster_pts).sum(axis=1)
                new_med.append(np.where(mask)[0][np.argmin(inner_d)])
            if new_med == list(medoid_idx):
                break
            medoid_idx = np.array(new_med)
        self.centers_ = Xs[medoid_idx]
        return self

    def predict(self, X):
        dists = cdist(X, self.centers_)
        return np.argmin(dists, axis=1)


class DBSCANSeg(BaseAlgorithm):
    name = "DBSCAN Trajectory Segmentation"
    service_id = 5
    category = "clustering"
    library = "scikit-learn"
    animals = ["all"]
    description = "DBSCAN density clustering; noise mapped to nearest cluster."

    def fit(self, X, y=None):
        self.scaler_ = StandardScaler()
        Xsc = self.scaler_.fit_transform(X)
        db = DBSCAN(eps=0.5, min_samples=5)
        db.fit(Xsc)
        self.db_ = db
        core_mask = db.labels_ >= 0
        if core_mask.sum() > 0:
            self.core_X_ = Xsc[core_mask]
            self.core_L_ = db.labels_[core_mask]
        else:
            self.core_X_ = Xsc
            self.core_L_ = np.zeros(len(Xsc), dtype=int)
        return self

    def predict(self, X):
        Xsc = self.scaler_.transform(X)
        dists = cdist(Xsc, self.core_X_)
        nearest = np.argmin(dists, axis=1)
        return self.core_L_[nearest]


class HDBSCANSeg(BaseAlgorithm):
    name = "HDBSCAN Trajectory Segmentation"
    service_id = 5
    category = "clustering"
    library = "scikit-learn"
    animals = ["all"]
    description = "HDBSCAN hierarchical density clustering; noise assigned to nearest core."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self.scaler_ = StandardScaler()
        Xsc = self.scaler_.fit_transform(X)
        try:
            from sklearn.cluster import HDBSCAN as _HDBSCAN
            hdb = _HDBSCAN(min_cluster_size=max(5, len(X) // 20))
            hdb.fit(Xsc)
            self.labels_ = hdb.labels_
        except ImportError:
            db = DBSCAN(eps=0.4, min_samples=5)
            self.labels_ = db.fit_predict(Xsc)
        self.Xsc_train_ = Xsc
        return self

    def predict(self, X):
        Xsc = self.scaler_.transform(X)
        dists = cdist(Xsc, self.Xsc_train_)
        nearest = np.argmin(dists, axis=1)
        raw = self.labels_[nearest]
        unique = np.unique(raw)
        mapping = {v: i for i, v in enumerate(unique)}
        return np.array([mapping[v] for v in raw])


