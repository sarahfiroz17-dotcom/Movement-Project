@registry.register
class CRWFitSeg(BaseAlgorithm):
    name = "Correlated Random Walk Fit Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "CRW fit: persistence parameter estimated in rolling windows."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        angles = X[:, 2]
        self.mu_cos_ = np.cos(angles).mean()
        self.sd_cos_ = np.cos(angles).std() + 1e-12
        return self

    def predict(self, X):
        angles = X[:, 2]
        cos_a = np.cos(angles)
        w = 20
        persistence = np.zeros(len(X))
        for i in range(len(X)):
            lo = max(0, i - w)
            persistence[i] = abs(np.cos(angles[lo:i + 1]).mean())
        labels = np.digitize(
            persistence,
            np.linspace(0, 1, self.n_ + 1)[1:-1]
        ).clip(0, self.n_ - 1)
        return labels


@registry.register
class KalmanFilterSeg(BaseAlgorithm):
    name = "Kalman Filter Smoothing Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "Kalman-smoothed residuals cluster into behavioral states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        x = X[:, 0]
        R = x.var()
        Q = R * 0.1
        filtered = np.zeros_like(x)
        P = R
        xhat = x[0]
        for i, z in enumerate(x):
            xhat = xhat
            P += Q
            K = P / (P + R)
            xhat += K * (z - xhat)
            P *= (1 - K)
            filtered[i] = xhat
        residuals = x - filtered
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(np.column_stack([filtered, residuals]))
        return self

    def predict(self, X):
        x = X[:, 0]
        R = x.var() + 1e-12
        Q = R * 0.1
        filtered = np.zeros_like(x)
        P = R
        xhat = x[0]
        for i, z in enumerate(x):
            P += Q
            K = P / (P + R)
            xhat += K * (z - xhat)
            P *= (1 - K)
            filtered[i] = xhat
        residuals = x - filtered
        return self.model_.predict(np.column_stack([filtered, residuals]))


@registry.register
class KalmanSmootherRTSSeg(BaseAlgorithm):
    name = "Kalman Smoother RTS Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "Rauch-Tung-Striebel smoother; cluster on smoothed trajectory."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        self._fit_smoother(X)
        smoothed = self._rts_smooth(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(smoothed)
        return self

    def _rts_smooth(self, X):
        x = X[:, 0]
        n = len(x)
        Q, R = x.var() * 0.1, x.var()
        xf = np.zeros(n)
        Pf = np.zeros(n)
        P = R
        xhat = x[0]
        for i, z in enumerate(x):
            P += Q
            K = P / (P + R)
            xhat += K * (z - xhat)
            P *= (1 - K)
            xf[i], Pf[i] = xhat, P
        xs = xf.copy()
        for i in range(n - 2, -1, -1):
            G = Pf[i] / (Pf[i] + Q + 1e-12)
            xs[i] += G * (xs[i + 1] - xf[i])
        return np.column_stack([xs, x - xs])

    def _fit_smoother(self, X):
        pass

    def predict(self, X):
        smoothed = self._rts_smooth(X)
        return self.model_.predict(smoothed)


class EMDSeg(BaseAlgorithm):
    name = "Empirical Mode Decomposition Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "EMD-based intrinsic mode functions cluster into behavioral states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        imfs = self._emd(X[:, 0], n_imf=3)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(imfs.T)
        return self

    def _emd(self, x, n_imf=3):
        imfs = []
        residue = x.copy()
        for _ in range(n_imf):
            h = residue.copy()
            for _ in range(10):
                maxima_idx = signal.argrelextrema(h, np.greater, order=3)[0]
                minima_idx = signal.argrelextrema(h, np.less, order=3)[0]
                if len(maxima_idx) < 2 or len(minima_idx) < 2:
                    break
                t = np.arange(len(h))
                upper = np.interp(t, maxima_idx, h[maxima_idx])
                lower = np.interp(t, minima_idx, h[minima_idx])
                mean_env = (upper + lower) / 2
                h -= mean_env
            imfs.append(h)
            residue -= h
        return np.array(imfs)

    def predict(self, X):
        imfs = self._emd(X[:, 0], n_imf=3)
        return self.model_.predict(imfs.T)


@registry.register
class WaveletDWTSeg(BaseAlgorithm):
    name = "Wavelet DWT Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "DWT decomposition detail coefficients cluster behavioral states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        coeffs = self._dwt_features(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(coeffs)
        return self

    def _dwt_features(self, X):
        x = X[:, 0]
        lo = np.convolve(x, np.array([0.5, 0.5]), mode='same')
        hi = np.convolve(x, np.array([0.5, -0.5]), mode='same')
        lo2 = np.convolve(lo, np.array([0.5, 0.5]), mode='same')
        hi2 = np.convolve(lo, np.array([0.5, -0.5]), mode='same')
        return np.column_stack([lo2, hi2, hi])

    def predict(self, X):
        coeffs = self._dwt_features(X)
        return self.model_.predict(coeffs)


class FFTPeriodicitySeg(BaseAlgorithm):
    name = "FFT Periodicity Segmentation"
    service_id = 5
    category = "statistical"
    library = "numpy"
    animals = ["all"]
    description = "FFT band-power features per point cluster into behavioral states."

    def fit(self, X, y=None):
        self.n_ = _n_states(y)
        feats = self._fft_features(X)
        self.model_ = KMeans(n_clusters=self.n_, random_state=42)
        self.model_.fit(feats)
        return self

    def _fft_features(self, X):
        x = X[:, 0]
        w = 20
        feats = np.zeros((len(x), 3))
        for i in range(len(x)):
            lo = max(0, i - w)
            seg = x[lo:i + 1]
            if len(seg) < 4:
                continue
            mag = np.abs(np.fft.rfft(seg))
            n_mag = len(mag)
            feats[i, 0] = mag[:max(1, n_mag // 3)].mean()
            feats[i, 1] = mag[n_mag // 3:2 * n_mag // 3].mean()
            feats[i, 2] = mag[2 * n_mag // 3:].mean()
        return feats

    def predict(self, X):
        feats = self._fft_features(X)
        return self.model_.predict(feats)


