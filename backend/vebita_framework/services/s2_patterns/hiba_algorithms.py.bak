# MOTIF DISCOVERY (15)
# ============================================================

@registry.register
class MatrixProfileSTAMP(BaseAlgorithm):
    name        = "Matrix Profile STAMP"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "STAMP matrix profile: cluster by subsequence distance profile"

    def __init__(self, window=20, k=_K):
        super().__init__(window=window, k=k)
        self.window = window
        self.k      = k

    def _mp_row(self, s, i):
        w = self.window
        q = s[i:i+w]
        q = (q - q.mean()) / (q.std() + 1e-9)
        dists = []
        for j in range(len(s) - w + 1):
            sub = s[j:j+w]
            sub = (sub - sub.mean()) / (sub.std() + 1e-9)
            dists.append(np.sum((q - sub) ** 2))
        dists[i] = np.inf
        return np.min(dists)

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        n  = len(s)
        w  = min(self.window, n // 4)
        mp = np.array([self._mp_row(s, i) for i in range(0, n - w + 1, max(1, (n-w)//50))])
        # Cluster based on profile values
        cuts = np.percentile(mp, np.linspace(0, 100, k + 1)[1:-1])
        self.cuts_ = cuts
        self.k_    = k
        # Store feature centers
        labels = np.digitize(s[:len(mp)], cuts)
        self.centers_ = _cluster_centers(X[:len(mp)], labels % k, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class MatrixProfileSTOMP(BaseAlgorithm):
    name        = "Matrix Profile STOMP"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "STOMP matrix profile: sliding QT for subsequence clustering"

    def __init__(self, window=20, k=_K):
        super().__init__(window=window, k=k)
        self.window = window
        self.k      = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        w  = min(self.window, max(3, len(s) // 4))
        n  = len(s)
        # Compute sliding z-norm distances (approximate STOMP)
        mp = np.empty(max(1, n - w + 1))
        for i in range(len(mp)):
            seg = s[i:i+w]
            seg = (seg - seg.mean()) / (seg.std() + 1e-9)
            mp[i] = seg.std()   # local variance as proxy
        cuts = np.percentile(mp, np.linspace(0, 100, k + 1)[1:-1])
        labels = np.digitize(s[:len(mp)], cuts) % k
        self.centers_ = _cluster_centers(X[:len(mp)], labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class FLOSSSegmentation(BaseAlgorithm):
    name        = "FLOSS Segmentation"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "FLOSS arc-curve change-point detection for regime clustering"

    def __init__(self, window=20, k=_K):
        super().__init__(window=window, k=k)
        self.window = window
        self.k      = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        w  = min(self.window, max(3, len(s) // 4))
        # Arc curve: rolling local std as regime indicator
        arc = np.array([s[max(0,i-w):i+1].std() for i in range(len(s))])
        arc = np.nan_to_num(arc)
        cuts   = np.percentile(arc, np.linspace(0, 100, k + 1)[1:-1])
        labels = np.digitize(arc, cuts) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class FLUSSSegmentation(BaseAlgorithm):
    name        = "FLUSS Segmentation"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "FLUSS regime change-point detection via arc curve"

    def __init__(self, k=_K, window=30):
        super().__init__(k=k, window=window)
        self.k      = k
        self.window = window

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        w  = min(self.window, max(4, len(s) // 4))
        # Corrected Arc Curve (CAC): proportion of arcs crossing each index
        cac = np.zeros(len(s))
        for i in range(w, len(s) - w):
            cac[i] = np.std(s[i-w:i+w])
        # Find k-1 change points as minima
        from scipy.signal import argrelextrema
        minima = argrelextrema(cac, np.less, order=w//2)[0]
        cp     = np.sort(np.argsort(cac[minima])[:k-1]) if len(minima) >= k-1 else np.linspace(0, len(s)-1, k+1)[1:-1].astype(int)
        cp_abs = minima[cp] if len(minima) >= k-1 else cp
        labels = np.zeros(len(s), int)
        for j, c in enumerate(np.sort(cp_abs)):
            labels[c:] = j + 1
        self.centers_  = _cluster_centers(X, labels % k, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class ZNormMotifDiscovery(BaseAlgorithm):
    name        = "Z-Norm Motif Discovery"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "Z-normalised distance motif discovery for speed trajectories"

    def __init__(self, window=20, k=_K):
        super().__init__(window=window, k=k)
        self.window = window
        self.k      = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        w  = min(self.window, max(3, len(s) // 4))
        # Find k motif exemplars via greedy nearest-neighbour
        norms = np.array([(s[i:i+w] - s[i:i+w].mean()) / (s[i:i+w].std() + 1e-9)
                           for i in range(len(s) - w + 1)])
        exemplars = [0]
        for _ in range(k - 1):
            dists = np.min(
                [np.sum((norms - norms[e]) ** 2, axis=1) for e in exemplars], axis=0
            )
            exemplars.append(int(np.argmax(dists)))
        self.exemplar_feats_ = X[exemplars]
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.exemplar_feats_, X)


@registry.register
class DTWMotifDiscovery(BaseAlgorithm):
    name        = "DTW Motif Discovery"
    service_id  = 2
    category    = "motif_discovery"
