@registry.register
class ClusterGANClustering(BaseAlgorithm):
    name        = "ClusterGAN Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "ClusterGAN: GAN latent-space clustering approximation (numpy)"

    def __init__(self, k=_K, noise_dim=4):
        super().__init__(k=k, noise_dim=noise_dim)
        self.k         = k
        self.noise_dim = noise_dim

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        np.random.seed(42)
        # Simulate GAN encoding: project + add structured noise
        from sklearn.preprocessing import StandardScaler
        from sklearn.decomposition import PCA
        self.scaler_  = StandardScaler().fit(X)
        Xs            = self.scaler_.transform(X)
        n_comp        = min(k, X.shape[1])
        self.pca_     = PCA(n_components=n_comp).fit(Xs)
        Xp            = self.pca_.transform(Xs)
        noise         = np.random.randn(len(X), self.noise_dim) * 0.05
        Xaug          = np.column_stack([Xp, noise[:, :min(self.noise_dim, 2)]])
        self.km_      = _safe_kmeans(Xaug, k)
        self.nd_      = min(self.noise_dim, 2)
        self.is_fitted = True
        return self

    def predict(self, X):
        np.random.seed(42)
        Xp    = self.pca_.transform(self.scaler_.transform(X))
        noise = np.random.randn(len(X), self.nd_) * 0.05
        return self.km_.predict(np.column_stack([Xp, noise]))


@registry.register
class SOMVAEClustering(BaseAlgorithm):
    name        = "SOM-VAE Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "SOM-VAE: SOM topology on VAE latent space (numpy approximation)"

    def __init__(self, k=_K, epochs=20):
        super().__init__(k=k, epochs=epochs)
        self.k      = k
        self.epochs = epochs

    def fit(self, X, y=None):
        k   = _nc(y) if y is not None else self.k
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        # VAE latent approx
        Xenc         = _encode(Xs, hidden=6, seed=3)
        # SOM on latent
        np.random.seed(3)
        nodes = Xenc[np.random.choice(len(Xenc), k, replace=False)].copy()
        for ep in range(self.epochs):
            lr = 0.3 * (1 - ep / self.epochs)
            for i in np.random.permutation(len(Xenc)):
                d   = np.sum((nodes - Xenc[i]) ** 2, axis=1)
                bmu = np.argmin(d)
                nodes[bmu] += lr * (Xenc[i] - nodes[bmu])
        self.nodes_  = nodes
        self.scaler_ = self.scaler_
        self.is_fitted = True
        return self

    def predict(self, X):
        Xenc = _encode(self.scaler_.transform(X), hidden=6, seed=3)
        return _nearest(self.nodes_, Xenc)


@registry.register
class DEPICTClustering(BaseAlgorithm):
    name        = "DEPICT Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "DEPICT deep embedding with cluster size regularisation (numpy)"

    def fit(self, X, y=None):
        k  = _nc(y)
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        Xenc         = _encode(Xs, hidden=8, seed=4)
        # Softmax cluster assignment with size balancing
        km           = _safe_kmeans(Xenc, k)
        labels       = km.labels_
        # Balance: oversample under-represented clusters
        counts = np.bincount(labels, minlength=k)
        for j in np.where(counts == 0)[0]:
            labels[np.argmax(np.sum((Xenc - km.cluster_centers_[j]) ** 2, axis=1))] = j
        self.centers_ = _cluster_centers(Xenc, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        Xenc = _encode(self.scaler_.transform(X), hidden=8, seed=4)
        return _nearest(self.centers_, Xenc)


@registry.register
class SpectralNetClustering(BaseAlgorithm):
    name        = "SpectralNet Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "sklearn"
    animals     = ["all"]
    description = "SpectralNet: spectral clustering via neural embedding (numpy approx)"

    def fit(self, X, y=None):
        k   = _nc(y)
        from sklearn.preprocessing import StandardScaler
        from sklearn.manifold import SpectralEmbedding
        Xs0, _       = _subsample(X, y, max_n=250)
        self.scaler_ = StandardScaler().fit(Xs0)
        Xs           = self.scaler_.transform(Xs0)
        self.se_     = SpectralEmbedding(n_components=k, random_state=42)
        Xp           = self.se_.fit_transform(Xs)
        km           = _safe_kmeans(Xp, k)
        self.centers_feat_ = _cluster_centers(Xs0, km.labels_, k)
        self.is_fitted     = True
        return self

    def predict(self, X):
        return _nearest(self.centers_feat_, X)


@registry.register
class SDCNClustering(BaseAlgorithm):
    name        = "SDCN Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "SDCN: structural deep clustering via graph smoothing (numpy)"

    def fit(self, X, y=None):
        k   = _nc(y)
        from sklearn.preprocessing import StandardScaler
        Xs0, _       = _subsample(X, y, max_n=250)
        self.scaler_ = StandardScaler().fit(Xs0)
        Xs           = self.scaler_.transform(Xs0)
        dists = np.sum((Xs[:, None, :] - Xs[None, :, :]) ** 2, axis=2)
        knn   = 5
        Xsmooth = np.zeros_like(Xs)
        for i in range(len(Xs)):
            nbrs = np.argsort(dists[i])[:knn+1]
            Xsmooth[i] = Xs[nbrs].mean(axis=0)
        Xenc             = _encode(Xsmooth, hidden=6, seed=5)
        self.km_         = _safe_kmeans(Xenc, k)
        self.train_Xs_   = Xs
        self.knn_        = knn
        self.is_fitted   = True
        return self

    def predict(self, X):
        Xs = self.scaler_.transform(X)
        # use training points as neighbours to avoid O(n_test^2)
        dists = np.sum((Xs[:, None, :] - self.train_Xs_[None, :, :]) ** 2, axis=2)
        Xsmooth = np.zeros_like(Xs)
        for i in range(len(Xs)):
            nbrs = np.argsort(dists[i])[:self.knn_+1]
            Xsmooth[i] = self.train_Xs_[nbrs].mean(axis=0)
        Xenc = _encode(Xsmooth, hidden=6, seed=5)
        return self.km_.predict(Xenc)


@registry.register
class DAEGCClustering(BaseAlgorithm):
    name        = "DAEGC Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "DAEGC: deep attentional embedded graph clustering (numpy)"

    def fit(self, X, y=None):
        k   = _nc(y)
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        # Attention: weight each feature by its variance
        attn         = np.var(Xs, axis=0) + 1e-10
        attn        /= attn.sum()
        Xw           = Xs * attn
        Xenc         = _encode(Xw, hidden=6, seed=6)
        self.km_     = _safe_kmeans(Xenc, k)
        self.attn_   = attn
        self.is_fitted = True
        return self

    def predict(self, X):
        Xs   = self.scaler_.transform(X) * self.attn_
        Xenc = _encode(Xs, hidden=6, seed=6)
        return self.km_.predict(Xenc)


