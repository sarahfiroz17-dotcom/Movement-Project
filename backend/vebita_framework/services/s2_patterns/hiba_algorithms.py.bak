@registry.register
class NMFTrajectoryCluster(BaseAlgorithm):
    name        = "NMF Trajectory Clustering"
    service_id  = 2
    category    = "dimensionality_reduction"
    library     = "sklearn"
    animals     = ["all"]
    description = "NMF non-negative factorisation followed by K-Means"

    def __init__(self, n_components=2, k=_K):
        super().__init__(n_components=n_components, k=k)
        self.n_components = n_components
        self.k            = k

    def fit(self, X, y=None):
        from sklearn.decomposition import NMF
        k           = _nc(y) if y is not None else self.k
        self.shift_ = -X.min(axis=0) + 1e-6
        Xpos        = X + self.shift_
        n           = min(self.n_components, X.shape[1])
        self.nmf_   = NMF(n_components=n, max_iter=500, random_state=42).fit(Xpos)
        Xp          = self.nmf_.transform(Xpos)
        self.km_    = _safe_kmeans(Xp, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.km_.predict(self.nmf_.transform(X + self.shift_))


@registry.register
class UMAPCluster(BaseAlgorithm):
    name        = "UMAP Clustering"
    service_id  = 2
    category    = "dimensionality_reduction"
    library     = "sklearn"
    animals     = ["all"]
    description = "UMAP manifold embedding (ISOMAP fallback) + K-Means"

    def __init__(self, n_components=2, k=_K):
        super().__init__(n_components=n_components, k=k)
        self.n_components = n_components
        self.k            = k

    def fit(self, X, y=None):
        k = _nc(y) if y is not None else self.k
        try:
            import umap
            self.reducer_ = umap.UMAP(n_components=self.n_components, random_state=42)
            Xp = self.reducer_.fit_transform(X)
            self.use_umap_ = True
        except ImportError:
            from sklearn.manifold import Isomap
            n = min(self.n_components, X.shape[1] - 1)
            self.reducer_  = Isomap(n_components=n, n_neighbors=min(10, len(X)-1))
            Xp             = self.reducer_.fit_transform(X)
            self.use_umap_ = False
        self.km_       = _safe_kmeans(Xp, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        if self.use_umap_:
            Xp = self.reducer_.transform(X)
        else:
            Xp = self.reducer_.transform(X)
        return self.km_.predict(Xp)


