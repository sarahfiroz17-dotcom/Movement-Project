@registry.register
class DCRNClustering(BaseAlgorithm):
    name        = "DCRN Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "DCRN: dual-correlation reduction network clustering (numpy)"

    def fit(self, X, y=None):
        k  = _nc(y)
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        # Decorrelation: remove cross-feature correlations
        C    = np.cov(Xs.T)
        eigv, eigvc = np.linalg.eigh(C)
        Xdecorr     = Xs @ eigvc
        Xenc        = _encode(Xdecorr, hidden=6, seed=9)
        self.km_    = _safe_kmeans(Xenc, k)
        self.eigvc_ = eigvc
        self.is_fitted = True
        return self

    def predict(self, X):
        Xs      = self.scaler_.transform(X) @ self.eigvc_
        Xenc    = _encode(Xs, hidden=6, seed=9)
        return self.km_.predict(Xenc)


@registry.register
class MGAEClustering(BaseAlgorithm):
    name        = "MGAE Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "MGAE: marginalised graph autoencoder clustering (numpy)"

    def fit(self, X, y=None):
        k  = _nc(y)
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        # Marginalisation: average over multiple noise levels
        np.random.seed(10)
        encodings = []
        for sigma in [0.01, 0.05, 0.1]:
            noisy = Xs + np.random.normal(0, sigma, Xs.shape)
            encodings.append(_encode(noisy, hidden=6, seed=10))
        Xenc         = np.mean(encodings, axis=0)
        self.km_     = _safe_kmeans(Xenc, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        np.random.seed(10)
        Xs = self.scaler_.transform(X)
        encodings = []
        for sigma in [0.01, 0.05, 0.1]:
            noisy = Xs + np.random.normal(0, sigma, Xs.shape)
            encodings.append(_encode(noisy, hidden=6, seed=10))
        Xenc = np.mean(encodings, axis=0)
        return self.km_.predict(Xenc)


@registry.register
class O2MACClustering(BaseAlgorithm):
    name        = "O2MAC Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "O2MAC: one-to-multiple graph autoencoder clustering (numpy)"

    def fit(self, X, y=None):
        k  = _nc(y)
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        # One-to-multiple: encode to k different latent subspaces
        np.random.seed(11)
        subspace_codes = []
        for j in range(k):
            W   = np.random.randn(X.shape[1], 3) * 0.1
            subspace_codes.append(np.tanh(Xs @ W))
        Xenc         = np.concatenate(subspace_codes, axis=1)
        self.km_     = _safe_kmeans(Xenc, k)
        self.W_list_ = [np.random.randn(X.shape[1], 3) * 0.1 for j in range(k)]
        self.is_fitted = True
        return self

    def predict(self, X):
        np.random.seed(11)
        Xs = self.scaler_.transform(X)
        subspace_codes = []
        for W in self.W_list_:
            subspace_codes.append(np.tanh(Xs @ W))
        Xenc = np.concatenate(subspace_codes, axis=1)
        return self.km_.predict(Xenc)
