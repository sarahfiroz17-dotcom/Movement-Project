@registry.register
class MeanShiftClustering(BaseAlgorithm):
    name        = "Mean Shift Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "sklearn"
    animals     = ["all"]
    description = "Mean shift mode-seeking clustering of movement features"

    def fit(self, X, y=None):
        from sklearn.cluster import MeanShift, estimate_bandwidth
        Xs, _          = _subsample(X, y, max_n=300)
        bw             = estimate_bandwidth(Xs, quantile=0.2, n_samples=min(300, len(Xs)))
        bw             = max(bw, 0.5)
        ms             = MeanShift(bandwidth=bw, n_jobs=1)
        labels         = ms.fit_predict(Xs)
        self.centers_  = ms.cluster_centers_
        self.k_        = len(self.centers_)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class AffinityPropagationClustering(BaseAlgorithm):
    name        = "Affinity Propagation Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "sklearn"
    animals     = ["all"]
    description = "Affinity propagation exemplar-based clustering"

    def fit(self, X, y=None):
        from sklearn.cluster import AffinityPropagation
        Xs, _          = _subsample(X, y, max_n=200)
        ap             = AffinityPropagation(random_state=42, max_iter=200)
        labels         = ap.fit_predict(Xs)
        k              = max(2, len(np.unique(labels)))
        self.centers_  = _cluster_centers(Xs, labels % k, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


