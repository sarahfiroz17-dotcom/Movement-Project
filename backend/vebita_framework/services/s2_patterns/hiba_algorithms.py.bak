    animals     = ["all"]
    description = "DTW-distance motif discovery for speed trajectory patterns"

    def __init__(self, k=_K):
        super().__init__(k=k)
        self.k = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        km = _safe_kmeans(X, k)
        self.centers_  = km.cluster_centers_
        self.is_fitted = True
        return self

    def predict(self, X):
        # DTW-approximate via L2 on raw features
        return _nearest(self.centers_, X)


@registry.register
class DiscordDetection(BaseAlgorithm):
    name        = "Discord Detection"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "Discord detection: cluster by anomaly score vs motif centres"

    def __init__(self, window=20, k=_K):
        super().__init__(window=window, k=k)
        self.window = window
        self.k      = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        n  = len(s)
        w  = min(self.window, max(3, n // 4))
        # Discord score: local deviation from rolling mean (efficient approximation)
        roll_mean = np.convolve(s, np.ones(w) / w, mode='same')
        score     = np.abs(s - roll_mean)
        cuts      = np.percentile(score, np.linspace(0, 100, k + 1)[1:-1])
        labels    = np.digitize(score, cuts) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class ShapeletDiscovery(BaseAlgorithm):
    name        = "Shapelet Discovery"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "Shapelet-based cluster assignment using representative subsequences"

    def __init__(self, k=_K, shapelet_len=15):
        super().__init__(k=k, shapelet_len=shapelet_len)
        self.k            = k
        self.shapelet_len = shapelet_len

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        w  = min(self.shapelet_len, len(s) // k)
        w  = max(w, 3)
        # Pick k shapelets as cluster representatives
        km = _safe_kmeans(X, k)
        labels = km.labels_
        self.shapelets_ = []
        for j in range(k):
            pts = np.where(labels == j)[0]
            if len(pts) > 0:
                centre_idx = pts[np.argmin(np.sum((X[pts] - km.cluster_centers_[j]) ** 2, axis=1))]
                start      = max(0, centre_idx - w // 2)
                self.shapelets_.append(s[start:start+w])
            else:
                self.shapelets_.append(np.zeros(w))
        self.centers_  = km.cluster_centers_
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class SAXMotifDiscovery(BaseAlgorithm):
    name        = "SAX Motif Discovery"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "SAX symbolic discretisation motif discovery on speed_ms"

    def __init__(self, alphabet=4, word_len=8, k=_K):
        super().__init__(alphabet=alphabet, word_len=word_len, k=k)
        self.alphabet  = alphabet
        self.word_len  = word_len
        self.k         = k

    def _sax(self, s, alpha):
        n   = len(s)
        s_z = (s - s.mean()) / (s.std() + 1e-9)
        breaks = np.percentile(s_z, np.linspace(0, 100, alpha + 1)[1:-1])
        return np.digitize(s_z, breaks)

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        sym = self._sax(s, self.alphabet)
        # Group by dominant symbol pattern
        wl  = min(self.word_len, len(s) // 4)
        words = {}
        for i in range(len(s) - wl + 1):
            w = tuple(sym[i:i+wl])
            words[w] = words.get(w, [])
            words[w].append(i)
        top_words = sorted(words.items(), key=lambda x: -len(x[1]))[:k]
        centers   = []
        for word, indices in top_words:
            centers.append(X[indices].mean(axis=0))
        while len(centers) < k:
            centers.append(X.mean(axis=0))
        self.centers_  = np.array(centers[:k])
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class PAAMotifDiscovery(BaseAlgorithm):
    name        = "PAA Motif Discovery"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "PAA piecewise-aggregate motif discovery on movement features"

    def __init__(self, segments=8, k=_K):
        super().__init__(segments=segments, k=k)
        self.segments = segments
        self.k        = k

    def _paa(self, X):
        n, d  = X.shape
        segs  = min(self.segments, n)
        out   = np.array([X[int(n*i/segs):int(n*(i+1)/segs)].mean(axis=0) for i in range(segs)])
        return out

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        km = _safe_kmeans(X, k)
        self.centers_  = km.cluster_centers_
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class SymbolicAggregateApprox(BaseAlgorithm):
    name        = "Symbolic Aggregate Approximation"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "SAX discretisation of all features for movement regime detection"

    def __init__(self, alphabet=4):
        super().__init__(alphabet=alphabet)
        self.alphabet = alphabet

    def fit(self, X, y=None):
        k  = _nc(y)
        self.breaks_ = np.percentile(X, np.linspace(0, 100, self.alphabet + 1)[1:-1], axis=0)
        labels = np.digitize(X[:, 0], self.breaks_[:, 0]) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class AdaptivePiecewiseConstantApprox(BaseAlgorithm):
    name        = "Adaptive Piecewise Constant Approximation"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "APCA variable-length piecewise constant approximation of speed_ms"

    def __init__(self, k=_K):
        super().__init__(k=k)
        self.k = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        # Greedy APCA: split at points of maximum local variance
        n   = len(s)
        labels = np.zeros(n, int)
        boundaries = [0, n]
        for _ in range(k - 1):
            best_gain = -np.inf
            best_pos  = 1
            best_seg  = 0
            for si in range(len(boundaries) - 1):
                lo, hi = boundaries[si], boundaries[si+1]
                seg = s[lo:hi]
                if len(seg) < 4:
                    continue
                for pos in range(lo+1, hi):
                    gain = np.var(seg[:pos-lo]) + np.var(seg[pos-lo:])
                    if gain > best_gain:
                        best_gain = gain
                        best_pos  = pos
                        best_seg  = si
            boundaries.insert(best_seg + 1, best_pos)
        boundaries = sorted(set(boundaries))
        for j, (lo, hi) in enumerate(zip(boundaries[:-1], boundaries[1:])):
            labels[lo:hi] = j % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class PerceptuallyImportantPoints(BaseAlgorithm):
    name        = "Perceptually Important Points"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "PIP-based trajectory segmentation into movement phases"

    def __init__(self, k=_K):
        super().__init__(k=k)
        self.k = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        n  = len(s)
        # Select PIPs as points farthest from current line approximation
        pips = [0, n - 1]
        while len(pips) < k + 1:
            max_dist, max_idx = -1, 1
            for i in range(1, n - 1):
                if i in pips:
                    continue
                lo = max(p for p in pips if p < i)
                hi = min(p for p in pips if p > i)
                # Distance from interpolated line
                alpha = (i - lo) / (hi - lo + 1e-10)
                interp = s[lo] * (1 - alpha) + s[hi] * alpha
                d = abs(s[i] - interp)
                if d > max_dist:
                    max_dist = d
                    max_idx  = i
            pips.append(max_idx)
        pips    = sorted(pips)
        labels  = np.zeros(n, int)
        for j in range(len(pips) - 1):
            labels[pips[j]:pips[j+1]] = j % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class TurningPointDetectionClustering(BaseAlgorithm):
    name        = "Turning Point Detection"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "Cluster movement phases using turning-angle change points"

    def __init__(self, k=_K):
        super().__init__(k=k)
        self.k = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        ta = X[:, 2].astype(float)          # turning_angle column
        n  = len(ta)
        # Label each point by cumulative turning regime
        cum = np.cumsum(np.abs(ta))
        cuts = np.percentile(cum, np.linspace(0, 100, k + 1)[1:-1])
        labels = np.digitize(cum, cuts) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class EventDetectionClustering(BaseAlgorithm):
    name        = "Event Detection"
    service_id  = 2
    category    = "motif_discovery"
    library     = "numpy"
    animals     = ["all"]
    description = "Detect behavioural events and cluster by event type"

    def __init__(self, k=_K, window=10):
        super().__init__(k=k, window=window)
        self.k      = k
        self.window = window

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        w  = min(self.window, max(3, len(s) // 10))
        # Event score: local variability change
        score = np.abs(np.convolve(s, np.ones(w)/w, mode='same') - s)
        cuts  = np.percentile(score, np.linspace(0, 100, k + 1)[1:-1])
        labels = np.digitize(score, cuts) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


# ============================================================
# DIMENSIONALITY REDUCTION (14)
# ============================================================

@registry.register
class PCATrajectoryCluster(BaseAlgorithm):
    name        = "PCA Trajectory Clustering"
    service_id  = 2
    category    = "dimensionality_reduction"
    library     = "sklearn"
    animals     = ["all"]
    description = "PCA projection followed by K-Means for movement clustering"

    def __init__(self, n_components=2, k=_K):
        super().__init__(n_components=n_components, k=k)
        self.n_components = n_components
        self.k            = k

    def fit(self, X, y=None):
        from sklearn.decomposition import PCA
        k          = _nc(y) if y is not None else self.k
        n          = min(self.n_components, X.shape[1])
        self.pca_  = PCA(n_components=n).fit(X)
        Xp         = self.pca_.transform(X)
        km         = _safe_kmeans(Xp, k)
        self.km_   = km
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.km_.predict(self.pca_.transform(X))


@registry.register
class KernelPCACluster(BaseAlgorithm):
    name        = "Kernel PCA Clustering"
    service_id  = 2
    category    = "dimensionality_reduction"
    library     = "sklearn"
    animals     = ["all"]
    description = "Kernel PCA (RBF) followed by K-Means clustering"

    def __init__(self, n_components=2, k=_K):
        super().__init__(n_components=n_components, k=k)
        self.n_components = n_components
        self.k            = k

    def fit(self, X, y=None):
        from sklearn.decomposition import KernelPCA
        k           = _nc(y) if y is not None else self.k
        self.kpca_  = KernelPCA(n_components=self.n_components, kernel='rbf').fit(X)
        Xp          = self.kpca_.transform(X)
        self.km_    = _safe_kmeans(Xp, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.km_.predict(self.kpca_.transform(X))


