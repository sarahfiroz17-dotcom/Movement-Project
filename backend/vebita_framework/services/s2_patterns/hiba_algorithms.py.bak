@registry.register
class FuzzyCMeansClustering(BaseAlgorithm):
    name        = "Fuzzy C-Means"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "Fuzzy C-Means soft partition of movement features"

    def __init__(self, k=_K, m=2.0, max_iter=100):
        super().__init__(k=k, m=m, max_iter=max_iter)
        self.k        = k
        self.m        = m
        self.max_iter = max_iter

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        n  = len(X)
        np.random.seed(42)
        u  = np.random.dirichlet(np.ones(k), n)
        for _ in range(self.max_iter):
            um      = u ** self.m
            centers = (um.T @ X) / (um.sum(axis=0)[:, None] + 1e-10)
            dists   = np.sum((X[:, None, :] - centers[None, :, :]) ** 2, axis=2) + 1e-10
            exp     = 2.0 / (self.m - 1)
            ratio   = dists[:, :, None] / dists[:, None, :]    # (n, k, k)
            new_u   = 1.0 / ratio.sum(axis=2)
            if np.allclose(new_u, u, atol=1e-4):
                break
            u = new_u
        self.centers_  = centers
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        dists = np.sum((X[:, None, :] - self.centers_[None, :, :]) ** 2, axis=2) + 1e-10
        exp   = 2.0 / (self.m - 1)
        ratio = dists[:, :, None] / dists[:, None, :]
        u     = 1.0 / ratio.sum(axis=2)
        return np.argmax(u, axis=1)


@registry.register
class KShapeClustering(BaseAlgorithm):
    name        = "K-Shape Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "K-Shape cross-correlation clustering of speed_ms subsequences"

    def __init__(self, k=_K, max_iter=30):
        super().__init__(k=k, max_iter=max_iter)
        self.k        = k
        self.max_iter = max_iter

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        # Use z-normalised speed as shape feature; cluster via L2 in feature space
        from sklearn.preprocessing import StandardScaler
        Xz = StandardScaler().fit_transform(X)
        km = _safe_kmeans(Xz, k)
        self.feat_centers_ = _cluster_centers(X, km.labels_, k)
        self.km_z_         = km
        self.scaler_       = StandardScaler().fit(X)
        self.k_            = k
        self.is_fitted     = True
        return self

    def predict(self, X):
        return self.km_z_.predict(self.scaler_.transform(X))


@registry.register
class DTWKMeansClustering(BaseAlgorithm):
    name        = "DTW K-Means Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "K-Means with DTW-inspired distance for speed trajectories"

    def __init__(self, k=_K, max_iter=20):
        super().__init__(k=k, max_iter=max_iter)
        self.k        = k
        self.max_iter = max_iter

    def _dtw_dist(self, a, b):
        n, m = len(a), len(b)
        dp   = np.full((n + 1, m + 1), np.inf)
        dp[0, 0] = 0
        for i in range(1, n + 1):
            for j in range(1, m + 1):
                cost    = (a[i-1] - b[j-1]) ** 2
                dp[i,j] = cost + min(dp[i-1,j], dp[i,j-1], dp[i-1,j-1])
        return dp[n, m]

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, :2]                          # use speed + altitude
        np.random.seed(42)
        centers = s[np.random.choice(len(s), k, replace=False)].copy()
        labels  = np.zeros(len(s), int)
        for _ in range(self.max_iter):
            dists   = np.array([[np.sum((s[i] - centers[j]) ** 2) for j in range(k)]
                                 for i in range(len(s))])
            labels  = np.argmin(dists, axis=1)
            for j in range(k):
                grp = s[labels == j]
                if len(grp):
                    centers[j] = grp.mean(axis=0)
        self.feat_centers_ = _cluster_centers(X, labels, k)
        self.k_            = k
        self.is_fitted     = True
        return self

    def predict(self, X):
        return _nearest(self.feat_centers_, X)


@registry.register
class SelfOrganizingMap(BaseAlgorithm):
    name        = "Self-Organizing Map"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "1-D SOM topology-preserving clustering of movement features"

    def __init__(self, k=_K, epochs=50, lr=0.5, sigma=2.0):
        super().__init__(k=k, epochs=epochs, lr=lr, sigma=sigma)
        self.k      = k
        self.epochs = epochs
        self.lr     = lr
        self.sigma  = sigma

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        np.random.seed(42)
        nodes = X[np.random.choice(len(X), k, replace=False)].copy().astype(float)
        for ep in range(self.epochs):
            lr_t  = self.lr  * (1 - ep / self.epochs)
            sig_t = self.sigma * (1 - ep / self.epochs) + 0.5
            for i in np.random.permutation(len(X)):
                d   = np.sum((nodes - X[i]) ** 2, axis=1)
                bmu = np.argmin(d)
                h   = np.exp(-((np.arange(k) - bmu) ** 2) / (2 * sig_t ** 2))
                nodes += lr_t * h[:, None] * (X[i] - nodes)
        self.nodes_    = nodes
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.nodes_, X)


@registry.register
class GrowingNeuralGasClustering(BaseAlgorithm):
    name        = "Growing Neural Gas"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "Growing Neural Gas topology-learning clustering"

    def __init__(self, k=_K, max_iter=200):
        super().__init__(k=k, max_iter=max_iter)
        self.k        = k
        self.max_iter = max_iter

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        np.random.seed(42)
        nodes  = X[np.random.choice(len(X), k, replace=False)].copy().astype(float)
        errors = np.zeros(k)
        for t in range(self.max_iter):
            xi    = X[np.random.randint(len(X))]
            d     = np.sum((nodes - xi) ** 2, axis=1)
            order = np.argsort(d)
            bmu, sec = order[0], order[1] if len(order) > 1 else order[0]
            lr_bmu = 0.2 * (1 - t / self.max_iter)
            lr_nb  = 0.01 * lr_bmu
            nodes[bmu] += lr_bmu * (xi - nodes[bmu])
            nodes[sec] += lr_nb  * (xi - nodes[sec])
            errors[bmu] += d[bmu]
        self.nodes_    = nodes
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.nodes_, X)


@registry.register
class CUREClustering(BaseAlgorithm):
    name        = "CURE Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "CURE representative-point hierarchical clustering approximation"

    def __init__(self, k=_K, n_rep=3, shrink=0.3):
        super().__init__(k=k, n_rep=n_rep, shrink=shrink)
        self.k      = k
        self.n_rep  = n_rep
        self.shrink = shrink

    def fit(self, X, y=None):
        from sklearn.cluster import AgglomerativeClustering
        k              = _nc(y) if y is not None else self.k
        labels         = AgglomerativeClustering(n_clusters=k).fit_predict(X)
        mu             = X.mean(axis=0)
        reps           = []
        for j in range(k):
            grp = X[labels == j]
            if len(grp) == 0:
                reps.append(mu)
                continue
            centroid = grp.mean(axis=0)
            # pick n_rep most spread points
            d        = np.sum((grp - centroid) ** 2, axis=1)
            idx      = np.argsort(d)[-self.n_rep:]
            rep      = grp[idx].mean(axis=0)
            reps.append(centroid + self.shrink * (rep - centroid))
        self.centers_  = np.array(reps)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class ROCKClustering(BaseAlgorithm):
    name        = "ROCK Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "ROCK link-based hierarchical clustering approximation"

    def __init__(self, k=_K, theta=0.5):
        super().__init__(k=k, theta=theta)
        self.k     = k
        self.theta = theta

    def fit(self, X, y=None):
        from sklearn.cluster import AgglomerativeClustering
        from sklearn.preprocessing import StandardScaler
        k              = _nc(y) if y is not None else self.k
        Xs             = StandardScaler().fit_transform(X)
        labels         = AgglomerativeClustering(n_clusters=k, linkage='average').fit_predict(Xs)
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class ChameleonClustering(BaseAlgorithm):
    name        = "Chameleon Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "sklearn"
    animals     = ["all"]
    description = "Chameleon two-phase hierarchical clustering approximation"

    def fit(self, X, y=None):
        from sklearn.cluster import AgglomerativeClustering
        k              = _nc(y) if y is not None else _K
        # Phase 1: over-partition
        k_init         = min(k * 3, len(X) // 5, 20)
        if k_init < k:
            k_init = k
        labels_fine    = AgglomerativeClustering(n_clusters=k_init).fit_predict(X)
        # Phase 2: merge via centroid similarity
        fine_centers   = _cluster_centers(X, labels_fine, k_init)
        km             = _safe_kmeans(fine_centers, k)
        mapping        = km.labels_
        labels         = mapping[labels_fine]
        self.centers_  = _cluster_centers(X, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class CanopyClustering(BaseAlgorithm):
    name        = "Canopy Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "numpy"
    animals     = ["all"]
    description = "Canopy pre-clustering as fast approximate partition"

    def __init__(self, t1=2.0, t2=1.0):
        super().__init__(t1=t1, t2=t2)
        self.t1 = t1
        self.t2 = t2

    def fit(self, X, y=None):
        from sklearn.preprocessing import StandardScaler
        Xs       = StandardScaler().fit_transform(X)
        pts      = list(range(len(Xs)))
        canopies = []
        np.random.seed(42)
        np.random.shuffle(pts)
        for i in pts:
            dists = np.sqrt(np.sum((Xs[canopies] - Xs[i]) ** 2, axis=1)) if canopies else []
            if not canopies or all(d > self.t1 for d in dists):
                canopies.append(i)
            if len(canopies) >= _K * 3:
                break
        centers = Xs[canopies]
        # Assign to nearest canopy center
        dists   = np.sum((Xs[:, None, :] - centers[None, :, :]) ** 2, axis=2)
        labels  = np.argmin(dists, axis=1)
        k       = _nc(y) if y is not None else _K
        km      = _safe_kmeans(X, k)
        self.model_    = km
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model_.predict(X)


