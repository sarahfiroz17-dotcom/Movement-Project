@registry.register
class CSPADEPatternMining(BaseAlgorithm):
    name        = "cSPADE Pattern Mining"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Constrained SPADE: mine patterns with minimum support threshold"

    def fit(self, X, y=None):
        k  = _nc(y)
        # Multi-feature discretisation
        sym = sum(_discretize(X, col=c, n_bins=k) * (k ** c) for c in range(3))
        sym = sym % k
        self.centers_ = _cluster_centers(X, sym, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class EpisodeMining(BaseAlgorithm):
    name        = "Episode Mining"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Episode mining: cluster by frequent speed+turn co-occurrence episodes"

    def fit(self, X, y=None):
        k  = _nc(y)
        # Episode: joint quantile bin of speed and turning angle
        s_sym = _discretize(X, col=0, n_bins=k)
        t_sym = _discretize(X, col=2, n_bins=k)
        labels = (s_sym + t_sym) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class FrequentMovementItemset(BaseAlgorithm):
    name        = "Frequent Movement Itemset"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Frequent itemset mining on discretised multi-feature movement"

    def fit(self, X, y=None):
        k  = _nc(y)
        # Itemset: all-feature quantile hash
        sym = np.zeros(len(X), int)
        for c in range(X.shape[1]):
            sym += _discretize(X, col=c, n_bins=2) * (2 ** c)
        labels = sym % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class AprioriMovementPhases(BaseAlgorithm):
    name        = "Apriori Movement Phases"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Apriori association mining on movement phase itemsets"

    def fit(self, X, y=None):
        k  = _nc(y)
        # High/low binarisation of top-4 features
        sym = np.zeros(len(X), int)
        for c in range(min(4, X.shape[1])):
            med = np.median(X[:, c])
            sym += (X[:, c] > med).astype(int) * (2 ** c)
        labels = sym % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class FPGrowthPatterns(BaseAlgorithm):
    name        = "FP-Growth Patterns"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "FP-Growth frequent pattern mining on movement feature bins"

    def fit(self, X, y=None):
        k  = _nc(y)
        # FP-tree-like: cluster by speed + straightness joint bin
        s_sym = _discretize(X, col=0, n_bins=k)
        r_sym = _discretize(X, col=3, n_bins=k)   # straightness
        labels = (s_sym * k + r_sym) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class MovementRuleMining(BaseAlgorithm):
    name        = "Movement Rule Mining"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Association rule mining: cluster by speed→altitude conditional rules"

    def fit(self, X, y=None):
        k  = _nc(y)
        # Rule: if speed > med AND altitude > med → class 3, etc.
        s_hi = (X[:, 0] > np.median(X[:, 0])).astype(int)
        a_hi = (X[:, 1] > np.median(X[:, 1])).astype(int)
        t_hi = (X[:, 2] > np.median(X[:, 2])).astype(int)
        labels = (s_hi * 4 + a_hi * 2 + t_hi) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class TemporalPatternMining(BaseAlgorithm):
    name        = "Temporal Pattern Mining"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Temporal pattern mining using lag-window co-occurrence"

    def __init__(self, lag=5, k=_K):
        super().__init__(lag=lag, k=k)
        self.lag = lag
        self.k   = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        n  = len(X)
        lag = min(self.lag, n - 1)
        # Feature: current + lagged speed
        feat = np.column_stack([X[:, 0],
                                 np.concatenate([X[:lag, 0], X[:-lag, 0]])])
        km = _safe_kmeans(feat, k)
        self.centers_feat_ = _cluster_centers(X, km.labels_, k)
        self.lag_  = lag
        self.km_   = km
        self.is_fitted = True
        return self

    def predict(self, X):
        n   = len(X)
        lag = min(self.lag_, n - 1)
        feat = np.column_stack([X[:, 0],
                                 np.concatenate([X[:lag, 0], X[:-lag, 0]])])
        return self.km_.predict(feat)


@registry.register
class PeriodicPatternMining(BaseAlgorithm):
    name        = "Periodic Pattern Mining"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Periodic pattern mining: cluster by dominant FFT frequency regime"

    def fit(self, X, y=None):
        k  = _nc(y)
        s  = X[:, 0].astype(float)
        n  = len(s)
        fft_mag = np.abs(np.fft.rfft(s))
        # Dominant frequency per rolling window
        w    = max(8, n // 10)
        freq_label = np.zeros(n, int)
        for i in range(n):
            lo  = max(0, i - w)
            seg = s[lo:i+1]
            if len(seg) < 4:
                continue
            mag = np.abs(np.fft.rfft(seg))
            freq_label[i] = np.argmax(mag[1:]) % k
        self.centers_ = _cluster_centers(X, freq_label, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class ContrastSequentialPatterns(BaseAlgorithm):
    name        = "Contrast Sequential Patterns"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Contrast patterns: cluster by above/below-mean feature contrasts"

    def fit(self, X, y=None):
        k  = _nc(y)
        # Contrast: deviation from rolling mean
        w  = max(5, len(X) // 20)
        contrast = np.zeros(len(X))
        for i in range(len(X)):
            lo = max(0, i - w)
            contrast[i] = X[i, 0] - X[lo:i+1, 0].mean()
        cuts  = np.percentile(contrast, np.linspace(0, 100, k + 1)[1:-1])
        labels = np.digitize(contrast, cuts) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class ClosedSequentialPatterns(BaseAlgorithm):
    name        = "Closed Sequential Patterns"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Closed sequential patterns: cluster by maximal repeated subsequences"

    def fit(self, X, y=None):
        k  = _nc(y)
        s  = X[:, 0].astype(float)
        # Closed: cluster by local autocorrelation structure
        w  = max(5, len(s) // 10)
        ac = np.array([np.corrcoef(s[max(0,i-w):i+1],
                                    np.arange(min(w+1, i+1)))[0, 1]
                        if i >= 1 else 0.0 for i in range(len(s))])
        ac = np.nan_to_num(ac)
        cuts  = np.percentile(ac, np.linspace(0, 100, k + 1)[1:-1])
        labels = np.digitize(ac, cuts) % k
        self.centers_  = _cluster_centers(X, labels, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class MaximalSequentialPatterns(BaseAlgorithm):
    name        = "Maximal Sequential Patterns"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Maximal sequential patterns: cluster by peak movement regimes"

    def fit(self, X, y=None):
        from scipy.signal import argrelextrema
        k  = _nc(y)
        s  = X[:, 0].astype(float)
        # Cluster around local maxima (regime peaks)
        order = max(3, len(s) // 20)
        peaks = argrelextrema(s, np.greater, order=order)[0]
        if len(peaks) < k:
            peaks = np.linspace(0, len(s)-1, k+2)[1:-1].astype(int)
        km = _safe_kmeans(X[peaks[:len(X)//2 + 1]], min(k, len(peaks)))
        self.centers_  = km.cluster_centers_
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class GapConstrainedPatterns(BaseAlgorithm):
    name        = "Gap-Constrained Patterns"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Gap-constrained sequential patterns on movement feature windows"

    def __init__(self, min_gap=2, max_gap=10, k=_K):
        super().__init__(min_gap=min_gap, max_gap=max_gap, k=k)
        self.min_gap = min_gap
        self.max_gap = max_gap
        self.k       = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        s  = X[:, 0].astype(float)
        # Gap-constrained: look at pairs of points with gap in [min_gap, max_gap]
        feat = np.column_stack([
            s,
            np.array([s[max(0, i - self.min_gap)] for i in range(len(s))]),
            np.array([s[max(0, i - self.max_gap)] for i in range(len(s))])
        ])
        km = _safe_kmeans(feat, k)
        self.centers_feat_ = _cluster_centers(X, km.labels_, k)
        self.km_gap_       = km
        self.is_fitted     = True
        return self

    def predict(self, X):
        n = len(X)
        s = X[:, 0].astype(float)
        feat = np.column_stack([
            s,
            np.array([s[max(0, i - self.min_gap)] for i in range(n)]),
            np.array([s[max(0, i - self.max_gap)] for i in range(n)])
        ])
        return self.km_gap_.predict(feat)


@registry.register
class WindowBasedPatterns(BaseAlgorithm):
    name        = "Window-Based Patterns"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Window-based sequential patterns: cluster by sliding window features"

    def __init__(self, window=10, k=_K):
        super().__init__(window=window, k=k)
        self.window = window
        self.k      = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        w  = min(self.window, max(3, len(X) // 4))
        # Window features: mean, std, max, min of speed in window
        means = np.array([X[max(0,i-w):i+1, 0].mean() for i in range(len(X))])
        stds  = np.array([X[max(0,i-w):i+1, 0].std()  for i in range(len(X))])
        feat  = np.column_stack([means, stds])
        km    = _safe_kmeans(feat, k)
        self.km_win_       = km
        self.centers_feat_ = _cluster_centers(X, km.labels_, k)
        self.w_            = w
        self.is_fitted     = True
        return self

    def predict(self, X):
        w     = self.w_
        means = np.array([X[max(0,i-w):i+1, 0].mean() for i in range(len(X))])
        stds  = np.array([X[max(0,i-w):i+1, 0].std()  for i in range(len(X))])
        return self.km_win_.predict(np.column_stack([means, stds]))


@registry.register
class HierarchicalSequentialPatterns(BaseAlgorithm):
    name        = "Hierarchical Sequential Patterns"
    service_id  = 2
    category    = "sequential_pattern"
    library     = "numpy"
    animals     = ["all"]
    description = "Hierarchical sequential patterns at multiple time scales"

    def __init__(self, k=_K, scales=(1, 4, 16)):
        super().__init__(k=k, scales=scales)
        self.k      = k
        self.scales = scales

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        n  = len(X)
        feat_list = []
        for sc in self.scales:
            w    = min(sc, n)
            vals = np.array([X[max(0,i-w):i+1, 0].mean() for i in range(n)])
            feat_list.append(vals)
        feat = np.column_stack(feat_list)
        km   = _safe_kmeans(feat, k)
        self.km_hier_      = km
        self.centers_feat_ = _cluster_centers(X, km.labels_, k)
        self.scales_       = self.scales
        self.is_fitted     = True
        return self

    def predict(self, X):
        n = len(X)
        feat_list = []
        for sc in self.scales_:
            w    = min(sc, n)
            vals = np.array([X[max(0,i-w):i+1, 0].mean() for i in range(n)])
            feat_list.append(vals)
        return self.km_hier_.predict(np.column_stack(feat_list))


# ============================================================
# DEEP LEARNING — numpy/sklearn approximations (16)
# ============================================================

def _encode(X, hidden=8, seed=42):
    """Simple 2-layer random projection as encoder approximation."""
    np.random.seed(seed)
    d   = X.shape[1]
    W1  = np.random.randn(d, hidden) * 0.1
    h   = np.tanh(X @ W1)
    W2  = np.random.randn(hidden, hidden // 2 + 1) * 0.1
    return np.tanh(h @ W2)


@registry.register
class AutoencoderClustering(BaseAlgorithm):
    name        = "Autoencoder Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "Autoencoder latent representation followed by K-Means (numpy)"

    def __init__(self, hidden=8, k=_K):
        super().__init__(hidden=hidden, k=k)
        self.hidden = hidden
        self.k      = k

    def fit(self, X, y=None):
        k           = _nc(y) if y is not None else self.k
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        Xenc         = _encode(Xs, self.hidden)
        self.km_     = _safe_kmeans(Xenc, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        Xenc = _encode(self.scaler_.transform(X), self.hidden)
        return self.km_.predict(Xenc)


@registry.register
class VAEClustering(BaseAlgorithm):
    name        = "VAE Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "VAE reparameterised latent space clustering (numpy approximation)"

    def __init__(self, latent=4, k=_K):
        super().__init__(latent=latent, k=k)
        self.latent = latent
        self.k      = k

    def fit(self, X, y=None):
        k  = _nc(y) if y is not None else self.k
        from sklearn.preprocessing import StandardScaler
        from sklearn.decomposition import PCA
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        self.pca_    = PCA(n_components=min(self.latent, X.shape[1])).fit(Xs)
        Xp           = self.pca_.transform(Xs)
        # VAE: add noise to simulate reparameterisation
        np.random.seed(42)
        Xp_noisy     = Xp + np.random.normal(0, 0.1, Xp.shape)
        self.km_     = _safe_kmeans(Xp_noisy, k)
        self.is_fitted = True
        return self

    def predict(self, X):
        Xp = self.pca_.transform(self.scaler_.transform(X))
        return self.km_.predict(Xp)


@registry.register
class DeepEmbeddedClustering(BaseAlgorithm):
    name        = "Deep Embedded Clustering"
    service_id  = 2
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "DEC: autoencoder + soft cluster assignment refinement (numpy)"

    def __init__(self, k=_K, n_iter=10):
        super().__init__(k=k, n_iter=n_iter)
        self.k      = k
        self.n_iter = n_iter

    def fit(self, X, y=None):
        k   = _nc(y) if y is not None else self.k
        from sklearn.preprocessing import StandardScaler
        self.scaler_ = StandardScaler().fit(X)
        Xs           = self.scaler_.transform(X)
        Xenc         = _encode(Xs, hidden=8, seed=0)
        km           = _safe_kmeans(Xenc, k)
        centers      = km.cluster_centers_
        # Refine: soft assignment target distribution
        for _ in range(self.n_iter):
            diff   = Xenc[:, None, :] - centers[None, :, :]
            q      = 1.0 / (1.0 + np.sum(diff ** 2, axis=2))
            q     /= q.sum(axis=1, keepdims=True)
            f      = q.sum(axis=0)
            p      = (q ** 2 / f) / ((q ** 2 / f).sum(axis=1, keepdims=True) + 1e-10)
            # Update centers toward target
            for j in range(k):
                centers[j] = (p[:, j][:, None] * Xenc).sum(axis=0) / (p[:, j].sum() + 1e-10)
        self.centers_ = centers
        self.is_fitted = True
        return self

    def predict(self, X):
        Xenc = _encode(self.scaler_.transform(X), hidden=8, seed=0)
        diff = Xenc[:, None, :] - self.centers_[None, :, :]
        q    = 1.0 / (1.0 + np.sum(diff ** 2, axis=2))
        return np.argmax(q, axis=1)


