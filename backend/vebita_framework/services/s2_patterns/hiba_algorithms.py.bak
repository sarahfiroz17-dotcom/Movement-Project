        valid          = labels >= 0
        self.centers_  = _cluster_centers(X[valid] if valid.any() else X,
                                          labels[valid] if valid.any() else np.zeros(len(X), int), k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


@registry.register
class AgglomerativeWardClustering(BaseAlgorithm):
    name        = "Agglomerative Ward Clustering"
    service_id  = 2
    category    = "clustering"
    library     = "sklearn"
    animals     = ["all"]
    description = "Agglomerative clustering with Ward linkage"

    def fit(self, X, y=None):
        from sklearn.cluster import AgglomerativeClustering
        k              = _nc(y)
        Xs, _          = _subsample(X, y, max_n=300)
        labels         = AgglomerativeClustering(n_clusters=k, linkage='ward').fit_predict(Xs)
        self.centers_  = _cluster_centers(Xs, labels, k)
        self.k_        = k
        self.is_fitted = True
        return self

    def predict(self, X):
        return _nearest(self.centers_, X)


