    description = "Mean absolute deviation anomaly score across features"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.mu_ = X.mean(0)
        self.thr_ = _thr(np.abs(X - self.mu_).mean(1))
        self.is_fitted = True; return self
    def predict(self, X):
