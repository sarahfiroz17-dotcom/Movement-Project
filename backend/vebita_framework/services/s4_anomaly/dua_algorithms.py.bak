@registry.register
class AD_B43_KMeansDistance(BaseAlgorithm):
    """B43 — Distance to nearest K-Means centroid (k=8)."""
    name = "AD B43 K-Means Distance"
    service_id = 4; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "Nearest centroid distance anomaly score via K-Means"

    def __init__(self, k=8): super().__init__(k=k); self.k = k
    def fit(self, X, y=None):
        k = min(self.k, len(X) // 5)
        self.km_ = KMeans(n_clusters=k, random_state=42, n_init=10).fit(X)
        s = np.min(np.linalg.norm(X[:, None] - self.km_.cluster_centers_[None], axis=2), 1)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        s = np.min(np.linalg.norm(X[:, None] - self.km_.cluster_centers_[None], axis=2), 1)
        return (s > self.thr_).astype(float)


@registry.register
