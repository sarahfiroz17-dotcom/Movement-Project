@registry.register
class AD_E84_PCAMaxFeatureError(BaseAlgorithm):
    """E84 — Max per-feature PCA reconstruction error."""
    name = "AD E84 PCA Max Feature Error"
    service_id = 4; category = "E_deep"; library = "sklearn"; animals = ["all"]
    description = "Max single-feature PCA reconstruction error"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        nc = min(2, X.shape[1], X.shape[0] - 1)
        self.pca_ = PCA(n_components=nc).fit(X)
