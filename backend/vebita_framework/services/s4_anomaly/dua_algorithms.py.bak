        s = np.min(np.linalg.norm(X[:, None] - self.km_.cluster_centers_[None], axis=2), 1)
        self.thr_ = _thr(s, 97); self.is_fitted = True; return self
    def predict(self, X):
        s = np.min(np.linalg.norm(X[:, None] - self.km_.cluster_centers_[None], axis=2), 1)
        return (s > self.thr_).astype(float)


