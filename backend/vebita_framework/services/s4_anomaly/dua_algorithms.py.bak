@registry.register
class AD_B55_RandomSubspaceEnsemble(BaseAlgorithm):
    """B55 — Ensemble of 5 IF models on random feature subsets."""
    name = "AD B55 Random Subspace IF Ensemble"
    service_id = 4; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "5-model IF ensemble each using random feature subsets"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        np.random.seed(42); self.models_ = []
        for s in range(5):
            cols = np.random.choice(X.shape[1], max(2, X.shape[1] // 2), replace=False)
            m = IsolationForest(contamination=0.05, random_state=s).fit(X[:, cols])
            self.models_.append((m, cols))
        self.is_fitted = True; return self
    def predict(self, X):
        votes = np.stack([_sk_binary(m.predict(X[:, c])) for m, c in self.models_]).mean(0)
        return (votes >= 0.5).astype(float)


