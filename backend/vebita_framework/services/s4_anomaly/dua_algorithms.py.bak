@registry.register
class AD_E85_AutoencoderTanh(BaseAlgorithm):
    """E85 — Numpy 1-hidden-layer autoencoder (tanh)."""
    name = "AD E85 Autoencoder Tanh"
    service_id = 4; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "1-hidden-layer numpy autoencoder with tanh activations"

    def __init__(self, epochs=50, lr=0.01): super().__init__(epochs=epochs, lr=lr); self.epochs=epochs; self.lr=lr
    def fit(self, X, y=None):
        self.sc_ = StandardScaler().fit(X); Xs = self.sc_.transform(X)
        d = X.shape[1]; h = max(2, d // 2); np.random.seed(42)
        self.W1_ = np.random.randn(d, h) * 0.1; self.b1_ = np.zeros(h)
        self.W2_ = np.random.randn(h, d) * 0.1; self.b2_ = np.zeros(d)
        for _ in range(self.epochs):
            z = np.tanh(Xs @ self.W1_ + self.b1_)
            Xh = z @ self.W2_ + self.b2_; e = Xh - Xs
            self.W2_ -= self.lr * z.T @ e / len(Xs); self.b2_ -= self.lr * e.mean(0)
            dz = (e @ self.W2_.T) * (1 - z ** 2)
            self.W1_ -= self.lr * Xs.T @ dz / len(Xs); self.b1_ -= self.lr * dz.mean(0)
        self.thr_ = _thr(self._err(Xs)); self.is_fitted = True; return self
    def _err(self, Xs):
        z = np.tanh(Xs @ self.W1_ + self.b1_)
        return np.mean((Xs - (z @ self.W2_ + self.b2_)) ** 2, 1)
    def predict(self, X):
        return (self._err(self.sc_.transform(X)) > self.thr_).astype(float)


@registry.register
class AD_E86_AutoencoderReLU(BaseAlgorithm):
    """E86 — Deeper 2-hidden-layer autoencoder (ReLU)."""
    name = "AD E86 Autoencoder ReLU Deep"
    service_id = 4; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "2-hidden-layer numpy autoencoder with ReLU activations"

    def __init__(self, epochs=30, lr=0.005): super().__init__(epochs=epochs, lr=lr); self.epochs=epochs; self.lr=lr
    def fit(self, X, y=None):
        self.sc_ = StandardScaler().fit(X); Xs = self.sc_.transform(X)
        d = X.shape[1]; h1 = max(4, d); h2 = max(2, d // 2); np.random.seed(7)
        self.W1_=np.random.randn(d,h1)*0.1; self.b1_=np.zeros(h1)
        self.W2_=np.random.randn(h1,h2)*0.1; self.b2_=np.zeros(h2)
        self.W3_=np.random.randn(h2,h1)*0.1; self.b3_=np.zeros(h1)
        self.W4_=np.random.randn(h1,d)*0.1;  self.b4_=np.zeros(d)
        r = lambda z: np.maximum(0, z)
        for _ in range(self.epochs):
            z1=r(Xs@self.W1_+self.b1_); z2=r(z1@self.W2_+self.b2_)
            z3=r(z2@self.W3_+self.b3_); Xh=z3@self.W4_+self.b4_; e=Xh-Xs
            self.W4_-=self.lr*z3.T@e/len(Xs); self.b4_-=self.lr*e.mean(0)
            g3=(e@self.W4_.T)*(z3>0); self.W3_-=self.lr*z2.T@g3/len(Xs); self.b3_-=self.lr*g3.mean(0)
            g2=(g3@self.W3_.T)*(z2>0); self.W2_-=self.lr*z1.T@g2/len(Xs); self.b2_-=self.lr*g2.mean(0)
            g1=(g2@self.W2_.T)*(z1>0); self.W1_-=self.lr*Xs.T@g1/len(Xs); self.b1_-=self.lr*g1.mean(0)
        self.thr_ = _thr(self._err(Xs)); self.is_fitted = True; return self
    def _err(self, Xs):
        r = lambda z: np.maximum(0, z)
        z1=r(Xs@self.W1_+self.b1_); z2=r(z1@self.W2_+self.b2_)
        z3=r(z2@self.W3_+self.b3_); Xh=z3@self.W4_+self.b4_
        return np.mean((Xs - Xh) ** 2, 1)
    def predict(self, X):
        return (self._err(self.sc_.transform(X)) > self.thr_).astype(float)


@registry.register
class AD_E87_VariationalAEProxy(BaseAlgorithm):
    """E87 — Variational AE proxy (PCA + noise perturbation)."""
    name = "AD E87 Variational AE Proxy"
    service_id = 4; category = "E_deep"; library = "sklearn"; animals = ["all"]
    description = "VAE proxy: PCA latent + noise perturbation reconstruction"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        nc = min(3, X.shape[1], X.shape[0] - 1)
        self.sc_ = StandardScaler().fit(X)
        self.pca_ = PCA(n_components=nc).fit(self.sc_.transform(X))
        Xs = self.sc_.transform(X)
        Xr = self.pca_.inverse_transform(self.pca_.transform(Xs))
        s = np.mean((Xs - Xr) ** 2, 1) + np.abs(np.random.randn(len(Xs))) * 0.01
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        Xs = self.sc_.transform(X)
        Xr = self.pca_.inverse_transform(self.pca_.transform(Xs))
        return (np.mean((Xs - Xr) ** 2, 1) > self.thr_).astype(float)


@registry.register
class AD_E88_AR3Residual(BaseAlgorithm):
    """E88 — AR(3) residual on all features (LSTM-AE proxy)."""
    name = "AD E88 AR3 Residual LSTM Proxy"
    service_id = 4; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "AR(3) prediction residual summed across features"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.coefs_ = []; n = len(X); total = np.zeros(n)
        for j in range(X.shape[1]):
            x = X[:, j]
            if n > 4:
                Y = x[3:]; A = np.column_stack([x[2:n-1], x[1:n-2], x[:n-3]])
                c, _, _, _ = np.linalg.lstsq(A, Y, rcond=None)
                res = np.abs(Y - A @ c); full = np.r_[0, 0, 0, res]
            else:
                c = np.zeros(3); full = np.zeros(n)
            self.coefs_.append(c); total += full
        self.thr_ = _thr(total); self.is_fitted = True; return self
    def predict(self, X):
        n = len(X); total = np.zeros(n)
        for j, c in enumerate(self.coefs_):
            x = X[:, j]
            if n > 4:
                A = np.column_stack([x[2:n-1], x[1:n-2], x[:n-3]])
                res = np.abs(x[3:] - A @ c); total += np.r_[0, 0, 0, res]
        return (total > self.thr_).astype(float)


@registry.register
class AD_E89_MemoryAugAE(BaseAlgorithm):
    """E89 — Memory-augmented AE proxy (distance to prototypes)."""
    name = "AD E89 Memory Augmented AE"
    service_id = 4; category = "E_deep"; library = "sklearn"; animals = ["all"]
    description = "Distance to prototypes in PCA latent space"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        nc = min(4, X.shape[1], X.shape[0] - 1)
        self.pca_ = PCA(n_components=nc).fit(X); Z = self.pca_.transform(X)
        k = min(10, len(Z)); np.random.seed(3)
        self.protos_ = Z[np.random.choice(len(Z), k, replace=False)]
        dists = np.min(np.linalg.norm(Z[:, None] - self.protos_[None], axis=2), 1)
        self.thr_ = _thr(dists); self.is_fitted = True; return self
    def predict(self, X):
        Z = self.pca_.transform(X)
        dists = np.min(np.linalg.norm(Z[:, None] - self.protos_[None], axis=2), 1)
        return (dists > self.thr_).astype(float)


@registry.register
class AD_E90_SelfSupervisedAE(BaseAlgorithm):
    """E90 — Self-supervised AE: predict each feature from all others."""
    name = "AD E90 Self-Supervised AE"
    service_id = 4; category = "E_deep"; library = "sklearn"; animals = ["all"]
    description = "Leave-one-feature-out Ridge prediction residual"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.sc_ = StandardScaler().fit(X); Xs = self.sc_.transform(X)
        self.models_ = []; total = np.zeros(len(X))
        for j in range(X.shape[1]):
            cols = [c for c in range(X.shape[1]) if c != j]
            lr = Ridge(alpha=0.1).fit(Xs[:, cols], Xs[:, j])
            self.models_.append((lr, cols))
            total += (Xs[:, j] - lr.predict(Xs[:, cols])) ** 2
        self.thr_ = _thr(total); self.is_fitted = True; return self
    def predict(self, X):
        Xs = self.sc_.transform(X); total = np.zeros(len(X))
        for j, (lr, cols) in enumerate(self.models_):
            total += (Xs[:, j] - lr.predict(Xs[:, cols])) ** 2
        return (total > self.thr_).astype(float)


