        t = np.abs((X - self.mu_) / self.sd_).max(1)
        self.thr_ = _thr(t); self.is_fitted = True; return self
    def predict(self, X):
        t = np.abs((X - self.mu_) / self.sd_).max(1)
        return (t > self.thr_).astype(float)


@registry.register
class AD_A17_PoissonRate(BaseAlgorithm):
    """A17 — Poisson-rate anomaly on speed."""
    name = "AD A17 Poisson Rate"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Poisson-rate deviation on speed feature"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        x = np.abs(X[:, 0]); self.lam_ = x.mean() + 1e-12
        s = np.abs(x - self.lam_) / np.sqrt(self.lam_)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        x = np.abs(X[:, 0])
        s = np.abs(x - self.lam_) / np.sqrt(self.lam_)
        return (s > self.thr_).astype(float)


@registry.register
class AD_A18_ExtremePercentile(BaseAlgorithm):
    """A18 — Flag top-1% / bottom-1% percentile per feature."""
    name = "AD A18 Extreme Percentile"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Flag any feature at extreme 1st or 99th percentile"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.lo_ = np.percentile(X, 1, 0)
        self.hi_ = np.percentile(X, 99, 0)
        self.is_fitted = True; return self
