@registry.register
class AD_C63_NNRatio(BaseAlgorithm):
    """C63 — 1-NN / mean-kNN distance ratio."""
    name = "AD C63 NN Distance Ratio"
    service_id = 4; category = "C_kernel"; library = "sklearn"; animals = ["all"]
    description = "Ratio of 1-NN to mean-kNN distance as outlier score"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        k = min(6, len(X) - 1)
        self.nn_ = NearestNeighbors(n_neighbors=k).fit(X)
        dists, _ = self.nn_.kneighbors(X)
        s = dists[:, 1] / (dists[:, 1:].mean(1) + 1e-12)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        dists, _ = self.nn_.kneighbors(X)
        s = dists[:, 1] / (dists[:, 1:].mean(1) + 1e-12)
        return (s > self.thr_).astype(float)


@registry.register
class AD_C64_KernelDensityGaussian(BaseAlgorithm):
    """C64 — Gaussian KDE negative log-density."""
    name = "AD C64 Gaussian KDE"
    service_id = 4; category = "C_kernel"; library = "sklearn"; animals = ["all"]
    description = "Negative Gaussian KDE log-density anomaly score"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.sc_ = StandardScaler().fit(X)
        Xs = self.sc_.transform(X)
        self.kde_ = KernelDensity(kernel="gaussian", bandwidth=1.0).fit(Xs)
        self.thr_ = _thr(-self.kde_.score_samples(Xs))
        self.is_fitted = True; return self
    def predict(self, X):
        Xs = self.sc_.transform(X)
        return (-self.kde_.score_samples(Xs) > self.thr_).astype(float)


@registry.register
class AD_C65_RBFKernelScore(BaseAlgorithm):
    """C65 — RBF kernel similarity to training set."""
    name = "AD C65 RBF Kernel Score"
    service_id = 4; category = "C_kernel"; library = "numpy"; animals = ["all"]
    description = "Mean RBF similarity to training points; low = anomaly"

    def __init__(self, sigma=1.0): super().__init__(sigma=sigma); self.sigma = sigma
    def fit(self, X, y=None):
        self.sc_ = StandardScaler().fit(X)
        self.Xtr_ = self.sc_.transform(X)
        s = self._score(self.Xtr_)
        self.thr_ = _thr(-s); self.is_fitted = True; return self
    def _score(self, Xs):
        n = min(200, len(self.Xtr_))
        ref = self.Xtr_[np.linspace(0, len(self.Xtr_) - 1, n, dtype=int)]
        dists = np.sum((Xs[:, None] - ref[None]) ** 2, 2)
        return np.exp(-dists / (2 * self.sigma ** 2)).mean(1)
    def predict(self, X):
        return (-self._score(self.sc_.transform(X)) > self.thr_).astype(float)


@registry.register
class AD_C66_LocalReachDensity(BaseAlgorithm):
    """C66 — Local Reachability Density."""
    name = "AD C66 Local Reachability Density"
    service_id = 4; category = "C_kernel"; library = "sklearn"; animals = ["all"]
    description = "LRD proxy: inverse mean reach distance"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        k = min(11, len(X) - 1)
        self.nn_ = NearestNeighbors(n_neighbors=k).fit(X)
        dists, _ = self.nn_.kneighbors(X)
        lrd = 1 / (dists[:, 1:].mean(1) + 1e-12)
        self.thr_ = _thr(-lrd); self.is_fitted = True; return self
    def predict(self, X):
        dists, _ = self.nn_.kneighbors(X)
        lrd = 1 / (dists[:, 1:].mean(1) + 1e-12)
        return (-lrd > self.thr_).astype(float)


@registry.register
class AD_C67_MeanShiftDist(BaseAlgorithm):
    """C67 — Distance from K-Means mode (mean-shift proxy)."""
    name = "AD C67 Mean Shift Distance"
    service_id = 4; category = "C_kernel"; library = "sklearn"; animals = ["all"]
    description = "Distance from single-cluster K-Means centroid (mode proxy)"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.km_ = KMeans(n_clusters=1, n_init=10, random_state=42).fit(X)
        s = np.linalg.norm(X - self.km_.cluster_centers_[0], axis=1)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        s = np.linalg.norm(X - self.km_.cluster_centers_[0], axis=1)
        return (s > self.thr_).astype(float)


@registry.register
class AD_C68_NeighbourhoodVariance(BaseAlgorithm):
    """C68 — Rolling window local variance vs global variance ratio."""
    name = "AD C68 Neighbourhood Variance"
    service_id = 4; category = "C_kernel"; library = "numpy"; animals = ["all"]
    description = "Rolling window variance ratio anomaly"

    def __init__(self, w=10): super().__init__(w=w); self.w = w
    def _score(self, X):
        out = np.zeros(len(X))
        for i in range(len(X)):
            chunk = X[max(0, i - self.w): i + self.w + 1]
            out[i] = chunk.var() / self.gvar_
        return out
    def fit(self, X, y=None):
        self.gvar_ = X.var() + 1e-12
        self.thr_ = _thr(self._score(X)); self.is_fitted = True; return self
    def predict(self, X):
        return (self._score(X) > self.thr_).astype(float)


@registry.register
class AD_C69_ReachDistRatio(BaseAlgorithm):
    """C69 — Reach-distance ratio (1-NN vs k-NN mean)."""
    name = "AD C69 Reach Distance Ratio"
    service_id = 4; category = "C_kernel"; library = "sklearn"; animals = ["all"]
