@registry.register
class AD_B39_BootstrapIF(BaseAlgorithm):
    """B39 — Bootstrap ensemble of three IF models (majority vote)."""
    name = "AD B39 Bootstrap IF Ensemble"
    service_id = 4; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "Majority vote of 3 bootstrap IF models"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.models_ = []
        for seed in [1, 2, 3]:
            np.random.seed(seed)
            idx = np.random.choice(len(X), len(X), replace=True)
            m = IsolationForest(contamination=0.05, random_state=seed)
            m.fit(X[idx]); self.models_.append(m)
        self.is_fitted = True; return self
    def predict(self, X):
        votes = np.stack([_sk_binary(m.predict(X)) for m in self.models_]).mean(0)
        return (votes >= 0.5).astype(float)


