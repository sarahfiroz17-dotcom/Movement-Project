@registry.register
class AD_A11_CUSUM(BaseAlgorithm):
    """A11 — CUSUM (cumulative sum control) on speed."""
    name = "AD A11 CUSUM"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "CUSUM change detection on speed feature"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        x = X[:, 0]; self.mu_ = x.mean()
        cusum = np.maximum.accumulate(np.abs(np.cumsum(x - self.mu_)))
        self.thr_ = _thr(cusum); self.is_fitted = True; return self
    def predict(self, X):
        x = X[:, 0]
        cusum = np.maximum.accumulate(np.abs(np.cumsum(x - self.mu_)))
        return (cusum > self.thr_).astype(float)


@registry.register
class AD_A12_EWMA(BaseAlgorithm):
    """A12 — EWMA residual anomaly detection on speed."""
    name = "AD A12 EWMA"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Exponentially Weighted Moving Average residual on speed"

    def __init__(self, alpha=0.1): super().__init__(alpha=alpha); self.alpha = alpha
    def _ewma(self, x):
        out = np.zeros(len(x)); out[0] = x[0]
        for i in range(1, len(x)):
            out[i] = self.alpha * x[i] + (1 - self.alpha) * out[i - 1]
        return out
    def fit(self, X, y=None):
        x = X[:, 0]; s = np.abs(x - self._ewma(x))
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        x = X[:, 0]; s = np.abs(x - self._ewma(x))
        return (s > self.thr_).astype(float)


@registry.register
class AD_A13_EllipticEnvelope(BaseAlgorithm):
    """A13 — Robust covariance elliptic envelope."""
    name = "AD A13 Elliptic Envelope"
    service_id = 4; category = "A_statistical"; library = "sklearn"; animals = ["all"]
    description = "sklearn EllipticEnvelope robust covariance anomaly detector"

    def __init__(self): super().__init__(); self.model_ = None
    def fit(self, X, y=None):
        try:
            self.model_ = EllipticEnvelope(contamination=0.05, support_fraction=0.9)
            self.model_.fit(X)
        except Exception:
            self.model_ = None
        self.is_fitted = True; return self
    def predict(self, X):
        if self.model_ is None:
            return np.zeros(len(X), dtype=float)
        return _sk_binary(self.model_.predict(X))


@registry.register
class AD_A14_GMMSingleGaussian(BaseAlgorithm):
    """A14 — Single Gaussian log-likelihood anomaly score."""
    name = "AD A14 GMM Single Gaussian"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Single Gaussian model negative log-likelihood"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.mu_ = X.mean(0)
        self.cov_ = np.cov(X, rowvar=False) + 1e-6 * np.eye(X.shape[1])
        self.inv_ = np.linalg.pinv(self.cov_)
        s = _mahal(X, self.mu_, self.inv_)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (_mahal(X, self.mu_, self.inv_) > self.thr_).astype(float)


@registry.register
class AD_A15_BoxplotMultiFeature(BaseAlgorithm):
    """A15 — Multi-feature boxplot fence."""
    name = "AD A15 Boxplot Multi-Feature"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Count features outside 1.5×IQR fence; threshold at 1"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        iqr = np.percentile(X, 75, 0) - np.percentile(X, 25, 0)
        self.lo_ = np.percentile(X, 25, 0) - 1.5 * iqr
        self.hi_ = np.percentile(X, 75, 0) + 1.5 * iqr
        self.is_fitted = True; return self
    def predict(self, X):
        return ((X < self.lo_) | (X > self.hi_)).any(1).astype(float)


