@registry.register
class AD_B49_GradientBoostProxy(BaseAlgorithm):
    """B49 — Gradient Boosting pseudo-anomaly score."""
    name = "AD B49 Gradient Boost Proxy"
    service_id = 4; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "GBM trained on z-score pseudo-labels for anomaly detection"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        mu, sd = X.mean(0), X.std(0) + 1e-12
        s = np.abs((X - mu) / sd).max(1)
        pseudo_y = (s > _thr(s, 95)).astype(int)
        if pseudo_y.sum() < 2: pseudo_y[:2] = 1
        self.m_ = GradientBoostingClassifier(n_estimators=50, random_state=42)
        self.m_.fit(X, pseudo_y); self.is_fitted = True; return self
    def predict(self, X):
        return (self.m_.predict_proba(X)[:, 1] > 0.5).astype(float)


@registry.register
class AD_B50_IFPartitionCount(BaseAlgorithm):
    """B50 — IF rare-leaf partition count anomaly."""
    name = "AD B50 IF Partition Count"
    service_id = 4; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "IF rare tree-leaf frequency as anomaly proxy"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.m_ = IsolationForest(n_estimators=50, random_state=42).fit(X)
        s = -self.m_.score_samples(X)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (-self.m_.score_samples(X) > self.thr_).astype(float)


@registry.register
class AD_B51_FeatureWeightedIF(BaseAlgorithm):
    """B51 — Feature-importance weighted z-score anomaly."""
    name = "AD B51 Feature Weighted IF"
    service_id = 4; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "Random Forest feature importance weighted anomaly score"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        mu, sd = X.mean(0), X.std(0) + 1e-12
        s = np.abs((X - mu) / sd).max(1)
        pseudo_y = (s > _thr(s, 95)).astype(int)
        if pseudo_y.sum() < 2: pseudo_y[:2] = 1
        rf = RandomForestClassifier(n_estimators=50, random_state=42).fit(X, pseudo_y)
        fi = rf.feature_importances_
        self.w_ = fi / (fi.sum() + 1e-12)
        self.mu_ = (X * self.w_).mean(0); self.sd_ = (X * self.w_).std(0) + 1e-12
        s2 = np.abs((X * self.w_ - self.mu_) / self.sd_).max(1)
        self.thr_ = _thr(s2); self.is_fitted = True; return self
    def predict(self, X):
        s = np.abs((X * self.w_ - self.mu_) / self.sd_).max(1)
        return (s > self.thr_).astype(float)


