@registry.register
class AD_A19_TrimmedMeanDistance(BaseAlgorithm):
    """A19 — Distance from 10%-trimmed mean."""
    name = "AD A19 Trimmed Mean Distance"
    service_id = 4; category = "A_statistical"; library = "scipy"; animals = ["all"]
    description = "Euclidean distance from trimmed mean centroid"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.mu_ = stats.trim_mean(X, 0.1, axis=0)
        s = np.linalg.norm(X - self.mu_, axis=1)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (np.linalg.norm(X - self.mu_, axis=1) > self.thr_).astype(float)


@registry.register
class AD_A20_WinsorisedResidual(BaseAlgorithm):
    """A20 — Winsorised mean residual."""
    name = "AD A20 Winsorised Residual"
    service_id = 4; category = "A_statistical"; library = "scipy"; animals = ["all"]
    description = "Residual from 5%-Winsorised mean per feature"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        from scipy.stats import mstats
        self.wmu_ = np.array([mstats.winsorize(X[:, j], (0.05, 0.05)).mean()
                               for j in range(X.shape[1])])
        s = np.linalg.norm(X - self.wmu_, axis=1)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (np.linalg.norm(X - self.wmu_, axis=1) > self.thr_).astype(float)


@registry.register
class AD_A21_LinearRegressionResidual(BaseAlgorithm):
    """A21 — OLS residual: speed predicted from step_length."""
    name = "AD A21 Linear Regression Residual"
    service_id = 4; category = "A_statistical"; library = "sklearn"; animals = ["all"]
    description = "OLS residual of speed on step_length as anomaly score"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.lr_ = LinearRegression()
        self.lr_.fit(X[:, [6]], X[:, 0])
        s = np.abs(X[:, 0] - self.lr_.predict(X[:, [6]]))
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        s = np.abs(X[:, 0] - self.lr_.predict(X[:, [6]]))
        return (s > self.thr_).astype(float)


