@registry.register
class AD_A24_SkewnessAnomaly(BaseAlgorithm):
    """A24 — Rolling skewness deviation on speed."""
    name = "AD A24 Rolling Skewness"
    service_id = 4; category = "A_statistical"; library = "scipy"; animals = ["all"]
    description = "Rolling skewness deviation from global skewness on speed"

    def __init__(self, w=15): super().__init__(w=w); self.w = w
    def _score(self, x):
        out = np.zeros(len(x))
        for i in range(len(x)):
            chunk = x[max(0, i - self.w): i + 1]
            if len(chunk) > 2:
                out[i] = abs(float(stats.skew(chunk)) - self.gskew_)
        return out
    def fit(self, X, y=None):
        x = X[:, 0]; self.gskew_ = float(stats.skew(x))
        self.thr_ = _thr(self._score(x)); self.is_fitted = True; return self
    def predict(self, X):
        return (self._score(X[:, 0]) > self.thr_).astype(float)


@registry.register
class AD_A25_KurtosisAnomaly(BaseAlgorithm):
    """A25 — Rolling kurtosis deviation on speed."""
    name = "AD A25 Rolling Kurtosis"
    service_id = 4; category = "A_statistical"; library = "scipy"; animals = ["all"]
    description = "Rolling kurtosis deviation from global kurtosis on speed"

    def __init__(self, w=15): super().__init__(w=w); self.w = w
    def _score(self, x):
        out = np.zeros(len(x))
        for i in range(len(x)):
            chunk = x[max(0, i - self.w): i + 1]
            if len(chunk) > 3:
                out[i] = abs(float(stats.kurtosis(chunk)) - self.gkurt_)
        return out
    def fit(self, X, y=None):
        x = X[:, 0]; self.gkurt_ = float(stats.kurtosis(x))
        self.thr_ = _thr(self._score(x)); self.is_fitted = True; return self
    def predict(self, X):
        return (self._score(X[:, 0]) > self.thr_).astype(float)


