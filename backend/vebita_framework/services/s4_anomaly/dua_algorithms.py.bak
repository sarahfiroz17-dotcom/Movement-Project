@registry.register
class AD_A27_VarianceRatio(BaseAlgorithm):
    """A27 — Local window variance vs global variance ratio."""
    name = "AD A27 Variance Ratio"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Rolling window variance ratio for local volatility detection"

    def __init__(self, w=10): super().__init__(w=w); self.w = w
    def _score(self, X):
        out = np.zeros(len(X))
        for i in range(len(X)):
            chunk = X[max(0, i - self.w): i + 1]
            out[i] = np.max(chunk.var(0) / (self.gvar_ + 1e-12))
        return out
    def fit(self, X, y=None):
        self.gvar_ = X.var(0) + 1e-12
        self.thr_ = _thr(self._score(X)); self.is_fitted = True; return self
    def predict(self, X):
        return (self._score(X) > self.thr_).astype(float)


@registry.register
class AD_A28_CorrelationBreak(BaseAlgorithm):
    """A28 — Detect break in feature correlation structure."""
    name = "AD A28 Correlation Break"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Deviation of local correlation from global correlation matrix"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.C_ = np.corrcoef(X, rowvar=False)
        s = np.array([np.abs((X - X.mean(0)) / (X.std(0) + 1e-12)).max(1)[i]
                      for i in range(len(X))])
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        s = np.abs((X - X.mean(0)) / (X.std(0) + 1e-12)).max(1)
        return (s > self.thr_).astype(float)


@registry.register
class AD_A29_FeatureEntropy(BaseAlgorithm):
    """A29 — Feature entropy deviation anomaly."""
    name = "AD A29 Feature Entropy"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Sum of per-feature z-scores as entropy-style anomaly score"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.mu_ = X.mean(0); self.sd_ = X.std(0) + 1e-12
        s = np.abs((X - self.mu_) / self.sd_).sum(1)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (np.abs((X - self.mu_) / self.sd_).sum(1) > self.thr_).astype(float)


@registry.register
class AD_A30_BayesianChangePoint(BaseAlgorithm):
    """A30 — Bayesian changepoint proxy via speed jump detection."""
    name = "AD A30 Bayesian Changepoint Proxy"
    service_id = 4; category = "A_statistical"; library = "numpy"; animals = ["all"]
    description = "Bayesian online changepoint proxy on speed differences"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        x = X[:, 0]
        diffs = np.abs(np.diff(x, prepend=x[0]))
        self.mu_d_ = diffs.mean(); self.sd_d_ = diffs.std() + 1e-12
        self.thr_ = _thr((diffs - self.mu_d_) / self.sd_d_)
        self.is_fitted = True; return self
    def predict(self, X):
        x = X[:, 0]
        diffs = np.abs(np.diff(x, prepend=x[0]))
        s = (diffs - self.mu_d_) / self.sd_d_
        return (s > self.thr_).astype(float)


