        self.nn_ = NearestNeighbors(n_neighbors=k).fit(X)
        dists, _ = self.nn_.kneighbors(X)
        s = dists[:, 1] / (dists[:, 1:].mean(1) + 1e-12)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        dists, _ = self.nn_.kneighbors(X)
