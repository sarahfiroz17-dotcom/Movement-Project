@registry.register
class AD_C70_NNLocalDensity(BaseAlgorithm):
    """C70 — Fraction of kNN within radius (local density)."""
    name = "AD C70 NN Local Density"
    service_id = 4; category = "C_kernel"; library = "sklearn"; animals = ["all"]
    description = "Low local density (few neighbours in radius) = anomaly"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        k = min(11, len(X) - 1)
        self.nn_ = NearestNeighbors(n_neighbors=k).fit(X)
        dists, _ = self.nn_.kneighbors(X)
        self.r_ = dists[:, 1:].mean()
        density = (dists[:, 1:] < self.r_).sum(1)
        self.thr_ = _thr(-density.astype(float))
        self.is_fitted = True; return self
    def predict(self, X):
        dists, _ = self.nn_.kneighbors(X)
        density = (dists[:, 1:] < self.r_).sum(1)
        return (-density.astype(float) > self.thr_).astype(float)


