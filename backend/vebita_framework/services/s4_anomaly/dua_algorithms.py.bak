@registry.register
class AD_C59_LOF_Manhattan(BaseAlgorithm):
    """C59 — LOF with Manhattan distance metric."""
    name = "AD C59 LOF Manhattan"
    service_id = 4; category = "C_kernel"; library = "sklearn"; animals = ["all"]
    description = "LOF using Manhattan (L1) distance"

    def __init__(self): super().__init__()
    def fit(self, X, y=None): self.is_fitted = True; return self
    def predict(self, X):
        k = min(20, len(X) - 1)
        return _sk_binary(LocalOutlierFactor(n_neighbors=k, metric="manhattan").fit_predict(X))


