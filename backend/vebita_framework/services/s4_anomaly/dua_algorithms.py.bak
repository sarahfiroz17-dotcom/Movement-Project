@registry.register
class AD_D71_GaussianLikelihood(BaseAlgorithm):
    """D71 — Negative Gaussian log-likelihood per point."""
    name = "AD D71 Gaussian Log-Likelihood"
    service_id = 4; category = "D_probabilistic"; library = "numpy"; animals = ["all"]
    description = "Multivariate Gaussian negative log-likelihood anomaly"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.mu_ = X.mean(0)
        cov = np.cov(X, rowvar=False) + 1e-6 * np.eye(X.shape[1])
        self.inv_ = np.linalg.pinv(cov)
        self.thr_ = _thr(_mahal(X, self.mu_, self.inv_))
        self.is_fitted = True; return self
    def predict(self, X):
        return (_mahal(X, self.mu_, self.inv_) > self.thr_).astype(float)


@registry.register
class AD_D72_NaiveBayesAnomaly(BaseAlgorithm):
    """D72 — Independent per-feature Gaussian anomaly score."""
    name = "AD D72 Naive Bayes Anomaly"
    service_id = 4; category = "D_probabilistic"; library = "numpy"; animals = ["all"]
    description = "Feature-independent Gaussian log-likelihood anomaly"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.mu_ = X.mean(0); self.var_ = X.var(0) + 1e-12
        self.thr_ = _thr(((X - self.mu_) ** 2 / self.var_).sum(1))
        self.is_fitted = True; return self
    def predict(self, X):
        return (((X - self.mu_) ** 2 / self.var_).sum(1) > self.thr_).astype(float)


@registry.register
class AD_D73_GammaDistribution(BaseAlgorithm):
    """D73 — Gamma distribution tail on speed."""
    name = "AD D73 Gamma Distribution Tail"
    service_id = 4; category = "D_probabilistic"; library = "scipy"; animals = ["all"]
    description = "Gamma-distribution negative log-likelihood on speed"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        x = np.abs(X[:, 0]) + 1e-6
        self.a_, self.loc_, self.scale_ = stats.gamma.fit(x, floc=0)
        self.thr_ = _thr(-stats.gamma.logpdf(x, self.a_, self.loc_, self.scale_))
        self.is_fitted = True; return self
    def predict(self, X):
        x = np.abs(X[:, 0]) + 1e-6
        return (-stats.gamma.logpdf(x, self.a_, self.loc_, self.scale_) > self.thr_).astype(float)


@registry.register
class AD_D74_ExponentialTail(BaseAlgorithm):
    """D74 — Exponential distribution tail on step_length."""
    name = "AD D74 Exponential Tail"
    service_id = 4; category = "D_probabilistic"; library = "scipy"; animals = ["all"]
    description = "Exponential distribution tail on step_length feature"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        x = np.abs(X[:, 6]) + 1e-6
        self.rate_ = 1.0 / (x.mean() + 1e-12)
        self.thr_ = _thr(-stats.expon.logpdf(x, scale=1 / self.rate_))
        self.is_fitted = True; return self
    def predict(self, X):
        x = np.abs(X[:, 6]) + 1e-6
        return (-stats.expon.logpdf(x, scale=1 / self.rate_) > self.thr_).astype(float)


@registry.register
class AD_D75_BetaDistribution(BaseAlgorithm):
    """D75 — Beta distribution tail on normalised speed."""
    name = "AD D75 Beta Distribution Tail"
    service_id = 4; category = "D_probabilistic"; library = "scipy"; animals = ["all"]
    description = "Beta distribution tail on 0-1 normalised speed"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        x = X[:, 0]; self.xmin_ = x.min(); self.xptp_ = np.ptp(x) + 1e-12
        xn = np.clip((x - self.xmin_) / self.xptp_, 1e-6, 1 - 1e-6)
        self.a_, self.b_, _, _ = stats.beta.fit(xn, floc=0, fscale=1)
        self.thr_ = _thr(-stats.beta.logpdf(xn, self.a_, self.b_))
        self.is_fitted = True; return self
    def predict(self, X):
        xn = np.clip((X[:, 0] - self.xmin_) / self.xptp_, 1e-6, 1 - 1e-6)
        return (-stats.beta.logpdf(xn, self.a_, self.b_) > self.thr_).astype(float)


@registry.register
class AD_D76_MarkovChain(BaseAlgorithm):
    """D76 — Markov chain transition probability anomaly."""
    name = "AD D76 Markov Chain Transition"
    service_id = 4; category = "D_probabilistic"; library = "numpy"; animals = ["all"]
    description = "Rare Markov state transitions on discretised speed"

    def __init__(self, n_bins=10): super().__init__(n_bins=n_bins); self.n_bins = n_bins
    def fit(self, X, y=None):
        x = X[:, 0]
        self.bins_ = np.percentile(x, np.linspace(0, 100, self.n_bins + 1))
        self.bins_[-1] += 1e-6
        states = np.clip(np.digitize(x, self.bins_) - 1, 0, self.n_bins - 1)
        trans = np.ones((self.n_bins, self.n_bins))
        for i in range(len(states) - 1):
            trans[states[i], states[i + 1]] += 1
        self.trans_ = trans / trans.sum(1, keepdims=True)
        self.is_fitted = True; return self
    def predict(self, X):
        x = X[:, 0]
        states = np.clip(np.digitize(x, self.bins_) - 1, 0, self.n_bins - 1)
        probs = np.ones(len(x))
        probs[1:] = self.trans_[states[:-1], states[1:]]
        s = -np.log(probs + 1e-12)
        return (s > _thr(s)).astype(float)


@registry.register
class AD_D77_CopulaAnomaly(BaseAlgorithm):
    """D77 — Gaussian copula anomaly score."""
    name = "AD D77 Gaussian Copula"
    service_id = 4; category = "D_probabilistic"; library = "scipy"; animals = ["all"]
    description = "Gaussian copula: transform marginals to Normal then Mahalanobis"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        from scipy.stats import rankdata
        n = len(X)
        U = np.column_stack([rankdata(X[:, j]) / (n + 1) for j in range(X.shape[1])])
        Zn = stats.norm.ppf(U)
        self.mu_z_ = Zn.mean(0)
        self.inv_z_ = np.linalg.pinv(np.cov(Zn, rowvar=False) + 1e-6 * np.eye(X.shape[1]))
        self.train_sorted_ = np.sort(X, axis=0)
        self.thr_ = _thr(_mahal(Zn, self.mu_z_, self.inv_z_))
        self.is_fitted = True; return self
    def predict(self, X):
        U = np.clip(
            np.column_stack([np.searchsorted(self.train_sorted_[:, j], X[:, j]) / len(self.train_sorted_)
                             for j in range(X.shape[1])]), 1e-6, 1 - 1e-6)
        Zn = stats.norm.ppf(U)
        return (_mahal(Zn, self.mu_z_, self.inv_z_) > self.thr_).astype(float)


@registry.register
class AD_D78_ParzenWindow(BaseAlgorithm):
    """D78 — Parzen window density estimate."""
    name = "AD D78 Parzen Window Density"
    service_id = 4; category = "D_probabilistic"; library = "numpy"; animals = ["all"]
    description = "Parzen window (Gaussian kernel) density anomaly"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        self.Xtr_ = X.copy()
        h = 1.06 * X.std() * len(X) ** (-0.2) + 1e-12; self.h_ = h
        self.thr_ = _thr(-self._density(X))
        self.is_fitted = True; return self
    def _density(self, X):
        n = min(200, len(self.Xtr_))
        ref = self.Xtr_[np.linspace(0, len(self.Xtr_) - 1, n, dtype=int)]
        dists = np.sum((X[:, None] - ref[None]) ** 2, 2)
        return np.exp(-dists / (2 * self.h_ ** 2)).mean(1)
    def predict(self, X):
        return (-self._density(X) > self.thr_).astype(float)


@registry.register
class AD_D79_DirichletEntropy(BaseAlgorithm):
    """D79 — Entropy of softmax-normalised feature values."""
    name = "AD D79 Dirichlet Entropy"
    service_id = 4; category = "D_probabilistic"; library = "numpy"; animals = ["all"]
    description = "Low entropy (peaky softmax) feature values flagged as anomaly"

    def __init__(self): super().__init__()
    def _score(self, X):
        Xs = np.exp(X - X.max(1, keepdims=True))
        p = Xs / Xs.sum(1, keepdims=True)
        return -np.sum(p * np.log(p + 1e-12), 1)
    def fit(self, X, y=None):
        self.thr_ = _thr(-self._score(X)); self.is_fitted = True; return self
    def predict(self, X):
        return (-self._score(X) > self.thr_).astype(float)


@registry.register
class AD_D80_GMMLogLikelihood(BaseAlgorithm):
    """D80 — Multi-component GMM log-likelihood."""
    name = "AD D80 GMM Log-Likelihood"
    service_id = 4; category = "D_probabilistic"; library = "sklearn"; animals = ["all"]
    description = "Gaussian Mixture Model negative log-likelihood anomaly"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        from sklearn.mixture import GaussianMixture
        self.gm_ = GaussianMixture(n_components=3, random_state=42).fit(X)
        self.thr_ = _thr(-self.gm_.score_samples(X))
        self.is_fitted = True; return self
    def predict(self, X):
        return (-self.gm_.score_samples(X) > self.thr_).astype(float)


