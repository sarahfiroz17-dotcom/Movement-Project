@registry.register
class AD_F91_VelocityJerk(BaseAlgorithm):
    """F91 — High jerk (3rd derivative of speed) = abrupt change."""
    name = "AD F91 Velocity Jerk"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Jerk (3rd-order derivative of speed) anomaly detection"

    def __init__(self): super().__init__()
    def _jerk(self, X):
        x = X[:, 0]; vel = np.diff(x, prepend=x[0])
        acc = np.diff(vel, prepend=vel[0])
        return np.abs(np.diff(acc, prepend=acc[0]))
    def fit(self, X, y=None):
        self.thr_ = _thr(self._jerk(X)); self.is_fitted = True; return self
    def predict(self, X):
        return (self._jerk(X) > self.thr_).astype(float)


@registry.register
class AD_F92_TurningSpeedProduct(BaseAlgorithm):
    """F92 — Large turning angle × high speed anomaly."""
    name = "AD F92 Turning × Speed"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Product of speed and turning angle as abrupt change score"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        s = X[:, 0] * np.abs(X[:, 2])
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (X[:, 0] * np.abs(X[:, 2]) > self.thr_).astype(float)


@registry.register
class AD_F93_AltitudeDrop(BaseAlgorithm):
    """F93 — Sudden altitude drop (crash/dive detection)."""
    name = "AD F93 Altitude Drop"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Sudden negative altitude change as anomaly"

    def __init__(self): super().__init__()
    def _drops(self, X):
        alt = X[:, 1]
        return np.r_[0, np.maximum(0, -np.diff(alt))]
    def fit(self, X, y=None):
        self.thr_ = _thr(self._drops(X)); self.is_fitted = True; return self
    def predict(self, X):
        return (self._drops(X) > self.thr_).astype(float)


@registry.register
class AD_F94_StepLengthOutlier(BaseAlgorithm):
    """F94 — Step length unusually large vs rolling baseline."""
    name = "AD F94 Step Length Outlier"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Rolling step_length baseline deviation anomaly"

    def __init__(self, w=20): super().__init__(w=w); self.w = w
    def fit(self, X, y=None):
        s = X[:, 6] - _rolling_mean(X[:, 6], self.w)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (X[:, 6] - _rolling_mean(X[:, 6], self.w) > self.thr_).astype(float)


@registry.register
class AD_F95_SinuositySpeed(BaseAlgorithm):
    """F95 — Low straightness at high speed anomaly."""
    name = "AD F95 Sinuosity × Speed"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "High speed + low straightness = anomalous movement"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        # straightness feature [3]: 0=winding, 1=straight
        s = X[:, 0] / (X[:, 3] + 1e-12)
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (X[:, 0] / (X[:, 3] + 1e-12) > self.thr_).astype(float)


@registry.register
class AD_F96_SpeedRollStdSpike(BaseAlgorithm):
    """F96 — Rolling speed standard deviation spike."""
    name = "AD F96 Speed Roll Std Spike"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Spike in rolling speed standard deviation — volatility anomaly"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        s = X[:, 5]  # speed_roll_std
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        return (X[:, 5] > self.thr_).astype(float)


@registry.register
class AD_F97_MultiFeatureTemporalChange(BaseAlgorithm):
    """F97 — Cumulative absolute first-differences across features."""
    name = "AD F97 Multi-Feature Temporal Change"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Sum of absolute temporal differences across all features"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        diffs = np.abs(np.diff(X, axis=0, prepend=X[:1]))
        self.thr_ = _thr(diffs.sum(1)); self.is_fitted = True; return self
    def predict(self, X):
        diffs = np.abs(np.diff(X, axis=0, prepend=X[:1]))
        return (diffs.sum(1) > self.thr_).astype(float)


@registry.register
class AD_F98_RestBoutTransition(BaseAlgorithm):
    """F98 — Sudden rest bout: speed drops below rolling mean."""
    name = "AD F98 Rest Bout Transition"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Sudden speed below rolling mean signals abrupt rest"

    def __init__(self, w=5): super().__init__(w=w); self.w = w
    def fit(self, X, y=None):
        s = np.maximum(0, _rolling_mean(X[:, 0], self.w) - X[:, 0])
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        s = np.maximum(0, _rolling_mean(X[:, 0], self.w) - X[:, 0])
        return (s > self.thr_).astype(float)


@registry.register
class AD_F99_AltitudeSpeedMismatch(BaseAlgorithm):
    """F99 — Altitude-speed mismatch: high altitude + low speed anomaly."""
    name = "AD F99 Altitude Speed Mismatch"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "High altitude with very low speed — biologically anomalous"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        alt_z = (X[:, 1] - X[:, 1].mean()) / (X[:, 1].std() + 1e-12)
        spd_z = (X[:, 0] - X[:, 0].mean()) / (X[:, 0].std() + 1e-12)
        s = alt_z - spd_z  # high alt + low speed = high score
        self.thr_ = _thr(s); self.is_fitted = True; return self
    def predict(self, X):
        alt_z = (X[:, 1] - X[:, 1].mean()) / (X[:, 1].std() + 1e-12)
        spd_z = (X[:, 0] - X[:, 0].mean()) / (X[:, 0].std() + 1e-12)
        return (alt_z - spd_z > self.thr_).astype(float)


@registry.register
class AD_F100_CompositeMovementScore(BaseAlgorithm):
    """F100 — Composite movement anomaly: z-sum over key features."""
    name = "AD F100 Composite Movement Score"
    service_id = 4; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Composite z-score across speed, altitude, turning, step_length"

    def __init__(self): super().__init__()
    def fit(self, X, y=None):
        cols = [0, 1, 2, 6]  # speed, altitude, turning_angle, step_length
        Xs = X[:, cols]
        self.mu_ = Xs.mean(0); self.sd_ = Xs.std(0) + 1e-12
        self.thr_ = _thr(np.abs((Xs - self.mu_) / self.sd_).sum(1))
        self.is_fitted = True; return self
    def predict(self, X):
        Xs = X[:, [0, 1, 2, 6]]
        return (np.abs((Xs - self.mu_) / self.sd_).sum(1) > self.thr_).astype(float)


