"""
services/s1_timeseries/abdul_algorithms.py
==========================================
Service 1 - Time Series Analysis (Abdul Rehman)
83 algorithms for animal GPS movement data.
Features: speed_ms, altitude_m, turning_angle, straightness,
          speed_roll_mean, speed_roll_std, step_length_m, alt_roll_mean
"""

import numpy as np
import warnings
warnings.filterwarnings("ignore")

from core.base import BaseAlgorithm
from core.registry import registry


# ---- helpers ---------------------------------------------------------------

def _speed(X):
    return X[:, 0].astype(float)

def _ema(arr, alpha):
    out = np.empty_like(arr, dtype=float)
    out[0] = arr[0]
    for i in range(1, len(arr)):
        out[i] = alpha * arr[i] + (1.0 - alpha) * out[i - 1]
    return out


# ============================================================
# STATISTICAL METHODS (22)
# ============================================================

@registry.register
class WeightedMovingAverage(BaseAlgorithm):
    name        = "Weighted Moving Average"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Linearly-weighted moving average of speed_ms"

    def __init__(self, window=5):
        super().__init__(window=window)
        self.window = window

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        w = np.arange(1, self.window + 1, dtype=float)
        w /= w.sum()
        return np.convolve(s, w[::-1], mode='same')


@registry.register
class DoubleExpSmoothTransform(BaseAlgorithm):
    name        = "Double Exponential Smoothing Transform"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Holt double exponential smoothing of speed_ms"

    def __init__(self, alpha=0.3, beta=0.1):
        super().__init__(alpha=alpha, beta=beta)
        self.alpha = alpha
        self.beta  = beta

    def fit(self, X, y=None):
        s = _speed(X)
        self.l_ = s[-1]
        self.b_ = float(np.mean(np.diff(s[-10:]))) if len(s) > 10 else 0.0
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        l, b = self.l_, self.b_
        out = np.empty(len(s))
        for i, v in enumerate(s):
            lp = l
            l = self.alpha * v + (1 - self.alpha) * (lp + b)
            b = self.beta * (l - lp) + (1 - self.beta) * b
            out[i] = l + b
        return out


@registry.register
class ARIMATransform(BaseAlgorithm):
    name        = "ARIMA Transform"
    service_id  = 1
    category    = "statistical"
    library     = "statsmodels"
    animals     = ["all"]
    description = "AR(1) approximation of ARIMA fitted values for speed_ms"

    def fit(self, X, y=None):
        s = _speed(X)
        self.phi_  = np.corrcoef(s[:-1], s[1:])[0, 1] if len(s) > 1 else 0.5
        self.mean_ = s.mean()
        self.last_ = s[-1]
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        out  = np.empty(len(s))
        prev = self.last_
        for i, v in enumerate(s):
            out[i] = self.mean_ + self.phi_ * (prev - self.mean_)
            prev = v
        return out


@registry.register
class HoltWintersTransform(BaseAlgorithm):
    name        = "Holt-Winters Transform"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Triple exponential smoothing (Holt-Winters) of speed_ms"

    def __init__(self, alpha=0.3, beta=0.1, gamma=0.1, period=12):
        super().__init__(alpha=alpha, beta=beta, gamma=gamma, period=period)
        self.alpha  = alpha
        self.beta   = beta
        self.gamma  = gamma
        self.period = period

    def fit(self, X, y=None):
        s = _speed(X)
        p = min(self.period, max(2, len(s) // 2))
        self.l_      = np.mean(s[:p])
        self.b_      = (np.mean(s[p:2*p]) - self.l_) / p if len(s) >= 2*p else 0.0
        self.season_ = s[:p] - self.l_
        self.p_      = p
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        p = self.p_
        l, b   = self.l_, self.b_
        season = self.season_.copy()
        out    = np.empty(len(s))
        for i, v in enumerate(s):
            si    = i % p
            out[i]= l + b + season[si]
            lp    = l
            l     = self.alpha * (v - season[si]) + (1 - self.alpha) * (l + b)
            b     = self.beta  * (l - lp)          + (1 - self.beta)  * b
            season[si] = self.gamma * (v - l) + (1 - self.gamma) * season[si]
        return out


@registry.register
class PolynomialTrendTransform(BaseAlgorithm):
    name        = "Polynomial Trend"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Quadratic polynomial trend fitted to speed_ms"

    def __init__(self, degree=2):
        super().__init__(degree=degree)
        self.degree = degree

    def fit(self, X, y=None):
        s = _speed(X)
        t = np.arange(len(s))
        self.coef_ = np.polyfit(t, s, self.degree)
        self.n_    = len(s)
        self.is_fitted = True
        return self

    def predict(self, X):
        t = np.arange(self.n_, self.n_ + len(X))
        return np.polyval(self.coef_, t)


@registry.register
class CubicSplineTrend(BaseAlgorithm):
    name        = "Cubic Spline Trend"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Degree-3 polynomial trend of speed_ms"

    def fit(self, X, y=None):
        s = _speed(X)
        t = np.arange(len(s))
        self.coef_ = np.polyfit(t, s, 3)
        self.n_    = len(s)
        self.is_fitted = True
        return self

    def predict(self, X):
        t = np.arange(self.n_, self.n_ + len(X))
        return np.polyval(self.coef_, t)


@registry.register
class STLTrendTransform(BaseAlgorithm):
    name        = "STL Trend"
    service_id  = 1
    category    = "statistical"
    library     = "scipy"
    animals     = ["all"]
    description = "STL-like trend via uniform smoothing of speed_ms"

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        from scipy.ndimage import uniform_filter1d
        s  = _speed(X)
        sz = max(3, len(s) // 10)
        return uniform_filter1d(s, size=sz)


@registry.register
class SeasonalDecomposeTrend(BaseAlgorithm):
    name        = "Seasonal Decompose Trend"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Moving-average trend from classical seasonal decomposition"

    def __init__(self, period=12):
        super().__init__(period=period)
        self.period = period

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        p = min(self.period, max(2, len(s) // 2))
        return np.convolve(s, np.ones(p) / p, mode='same')


@registry.register
class AutocorrelationForecast(BaseAlgorithm):
    name        = "Autocorrelation Forecast"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "AR(p) forecast using lag autocorrelation structure of speed_ms"

    def __init__(self, lags=3):
        super().__init__(lags=lags)
        self.lags = lags

    def fit(self, X, y=None):
        s = _speed(X)
        n = len(s)
        if n > self.lags:
            Y = s[self.lags:]
            Z = np.column_stack([s[self.lags-i-1:n-i-1] for i in range(self.lags)])
            res = np.linalg.lstsq(np.column_stack([np.ones(len(Y)), Z]), Y, rcond=None)
            self.coef_ = res[0]
        else:
            self.coef_ = np.array([s.mean()] + [0.5] * self.lags)
        self.last_ = list(s[-self.lags:])
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        buf = list(self.last_)
        out = np.empty(len(s))
        for i, v in enumerate(s):
            z = np.array(buf[-self.lags:])
            out[i] = self.coef_[0] + np.dot(self.coef_[1:], z)
            buf.append(v)
        return out


@registry.register
class PACFForecast(BaseAlgorithm):
    name        = "PACF Forecast"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Lag-1 partial autocorrelation forecast of speed_ms"

    def fit(self, X, y=None):
        s = _speed(X)
        self.phi_  = np.corrcoef(s[:-1], s[1:])[0, 1] if len(s) > 1 else 0.0
        self.mean_ = s.mean()
        self.last_ = s[-1]
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        out  = np.empty(len(s))
        prev = self.last_
        for i, v in enumerate(s):
            out[i] = self.mean_ + self.phi_ * (prev - self.mean_)
            prev   = v
        return out


@registry.register
class RollingVarianceTransform(BaseAlgorithm):
    name        = "Rolling Variance"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Rolling variance of speed_ms as a stationarity proxy"

    def __init__(self, window=10):
        super().__init__(window=window)
        self.window = window

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s   = _speed(X)
        out = np.empty(len(s))
        for i in range(len(s)):
            lo     = max(0, i - self.window + 1)
            out[i] = np.var(s[lo:i+1])
        return out


@registry.register
class RollingSkewnessTransform(BaseAlgorithm):
    name        = "Rolling Skewness"
    service_id  = 1
    category    = "statistical"
    library     = "scipy"
    animals     = ["all"]
    description = "Rolling skewness of speed_ms"

    def __init__(self, window=10):
        super().__init__(window=window)
        self.window = window

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        from scipy.stats import skew
        s   = _speed(X)
        out = np.empty(len(s))
        for i in range(len(s)):
            lo     = max(0, i - self.window + 1)
            seg    = s[lo:i+1]
            out[i] = float(skew(seg)) if len(seg) > 2 else 0.0
        return out


@registry.register
class RollingKurtosisTransform(BaseAlgorithm):
    name        = "Rolling Kurtosis"
    service_id  = 1
