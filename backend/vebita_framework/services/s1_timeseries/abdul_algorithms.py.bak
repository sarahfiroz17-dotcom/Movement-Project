        from scipy.stats import kurtosis
        s   = _speed(X)
        out = np.empty(len(s))
        for i in range(len(s)):
            lo     = max(0, i - self.window + 1)
            seg    = s[lo:i+1]
            out[i] = float(kurtosis(seg)) if len(seg) > 3 else 0.0
        return out


@registry.register
class ZScoreTransform(BaseAlgorithm):
    name        = "Z-Score Transform"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Z-score normalisation of speed_ms using training statistics"

    def fit(self, X, y=None):
        s           = _speed(X)
        self.mu_    = s.mean()
        self.sigma_ = s.std() + 1e-9
        self.is_fitted = True
        return self

    def predict(self, X):
        return (_speed(X) - self.mu_) / self.sigma_


@registry.register
class MinMaxTransform(BaseAlgorithm):
    name        = "Min-Max Transform"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Min-max normalisation of speed_ms to [0, 1]"

    def fit(self, X, y=None):
        s            = _speed(X)
        self.min_    = s.min()
        self.range_  = s.max() - s.min() + 1e-9
        self.is_fitted = True
        return self

    def predict(self, X):
        return (_speed(X) - self.min_) / self.range_


@registry.register
class RobustScaleTransform(BaseAlgorithm):
    name        = "Robust Scale Transform"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Robust scaling using median and IQR of speed_ms"

    def fit(self, X, y=None):
        s              = _speed(X)
        self.median_   = np.median(s)
        self.iqr_      = np.percentile(s, 75) - np.percentile(s, 25) + 1e-9
        self.is_fitted = True
        return self

    def predict(self, X):
        return (_speed(X) - self.median_) / self.iqr_


@registry.register
class DifferencingTransform(BaseAlgorithm):
    name        = "First Difference"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "First-order differencing to remove trend from speed_ms"

    def fit(self, X, y=None):
        self.last_     = _speed(X)[-1]
        self.is_fitted = True
        return self

    def predict(self, X):
        s    = _speed(X)
        prev = np.concatenate([[self.last_], s[:-1]])
        return s - prev


@registry.register
class LogTransform(BaseAlgorithm):
    name        = "Log Transform"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Natural log transform of speed_ms (shifted to positive)"

    def fit(self, X, y=None):
        self.shift_    = max(0.0, -_speed(X).min()) + 1.0
        self.is_fitted = True
        return self

    def predict(self, X):
        return np.log(_speed(X) + self.shift_)


@registry.register
class BoxCoxTransform(BaseAlgorithm):
    name        = "Box-Cox Transform"
    service_id  = 1
    category    = "statistical"
    library     = "scipy"
    animals     = ["all"]
    description = "Box-Cox power transform of speed_ms"

    def fit(self, X, y=None):
        from scipy.stats import boxcox
        s              = _speed(X)
        self.shift_    = max(0.0, -s.min()) + 1.0
        _, self.lam_   = boxcox(s + self.shift_)
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X) + self.shift_
        if abs(self.lam_) < 1e-10:
            return np.log(s)
        return (s ** self.lam_ - 1) / self.lam_


@registry.register
class YeoJohnsonTransform(BaseAlgorithm):
    name        = "Yeo-Johnson Transform"
    service_id  = 1
    category    = "statistical"
    library     = "sklearn"
    animals     = ["all"]
    description = "Yeo-Johnson power transform of speed_ms for normality"

    def fit(self, X, y=None):
        from sklearn.preprocessing import PowerTransformer
        self.pt_       = PowerTransformer(method='yeo-johnson')
        self.pt_.fit(_speed(X).reshape(-1, 1))
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.pt_.transform(_speed(X).reshape(-1, 1)).ravel()


@registry.register
class FourierReconstruction(BaseAlgorithm):
    name        = "Fourier Reconstruction"
    service_id  = 1
    category    = "statistical"
    library     = "numpy"
    animals     = ["all"]
    description = "Top-k Fourier components reconstruction of speed_ms"

    def __init__(self, n_components=10):
        super().__init__(n_components=n_components)
        self.n_components = n_components

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s   = _speed(X)
        fft = np.fft.rfft(s)
        k   = min(self.n_components, len(fft))
        idx = np.argsort(np.abs(fft))[-k:]
        mask = np.zeros_like(fft)
        mask[idx] = fft[idx]
        return np.fft.irfft(mask, n=len(s))


@registry.register
class LagFeatureForecast(BaseAlgorithm):
    name        = "Lag Feature Forecast"
    service_id  = 1
    category    = "statistical"
    library     = "sklearn"
    animals     = ["all"]
    description = "Linear regression on lag features of speed_ms"

    def __init__(self, lags=5):
        super().__init__(lags=lags)
        self.lags = lags

    def fit(self, X, y=None):
        s = _speed(X)
        n = len(s)
        if n <= self.lags:
            self.coef_      = np.zeros(self.lags)
            self.intercept_ = s.mean()
        else:
            Xlag = np.column_stack([s[self.lags-i-1:n-i-1] for i in range(self.lags)])
            Ytgt = s[self.lags:]
            from sklearn.linear_model import LinearRegression
            lr              = LinearRegression().fit(Xlag, Ytgt)
            self.coef_      = lr.coef_
            self.intercept_ = lr.intercept_
        self.last_ = list(s[-self.lags:])
        self.is_fitted = True
        return self

    def predict(self, X):
        s   = _speed(X)
        buf = list(self.last_)
        out = np.empty(len(s))
        for i, v in enumerate(s):
            z      = np.array(buf[-self.lags:])
            out[i] = self.intercept_ + np.dot(self.coef_, z)
            buf.append(v)
        return out


# ============================================================
# FORECASTING METHODS (18)
# ============================================================

@registry.register
class ARIMAForecast(BaseAlgorithm):
    name        = "ARIMA Forecast"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "AR(2) ARIMA-style one-step-ahead forecast of speed_ms"

    def fit(self, X, y=None):
        s = _speed(X)
        n = len(s)
        if n > 3:
            r0    = np.var(s)
            r1    = np.cov(s[:-1], s[1:])[0, 1]
            r2    = np.cov(s[:-2], s[2:])[0, 1]
            denom = r0**2 - r1**2 + 1e-10
            self.phi1_ = (r1 * r0 - r1 * r2) / denom
            self.phi2_ = (r0 * r2 - r1**2)   / denom
        else:
            self.phi1_, self.phi2_ = 0.5, 0.1
        self.mean_  = s.mean()
        self.last2_ = list(s[-2:])
        self.is_fitted = True
        return self

    def predict(self, X):
        s   = _speed(X)
        buf = list(self.last2_)
        out = np.empty(len(s))
        for i, v in enumerate(s):
            out[i] = (self.mean_
                      + self.phi1_ * (buf[-1] - self.mean_)
                      + self.phi2_ * (buf[-2] - self.mean_))
            buf.append(v)
        return out


@registry.register
class SARIMAForecast(BaseAlgorithm):
    name        = "SARIMA Forecast"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Seasonal AR forecast with period=12 for speed_ms"

    def __init__(self, period=12):
        super().__init__(period=period)
        self.period = period

    def fit(self, X, y=None):
        s = _speed(X)
        p = min(self.period, max(2, len(s) // 2))
        self.seasonal_mean_ = np.array([s[i::p].mean() for i in range(p)])
        self.overall_mean_  = s.mean()
        self.phi_           = np.corrcoef(s[:-1], s[1:])[0, 1] if len(s) > 1 else 0.5
        self.last_          = s[-1]
        self.p_             = p
        self.n_             = len(s)
        self.is_fitted = True
        return self

    def predict(self, X):
        s   = _speed(X)
        out = np.empty(len(s))
        prev = self.last_
        for i, v in enumerate(s):
            si     = (self.n_ + i) % self.p_
            out[i] = (self.overall_mean_
                      + self.phi_ * (prev - self.overall_mean_)
                      + 0.3 * (self.seasonal_mean_[si] - self.overall_mean_))
            prev = v
        return out


@registry.register
class SimpleExpSmoothing(BaseAlgorithm):
    name        = "Simple Exponential Smoothing"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "SES one-step-ahead forecast of speed_ms"

    def __init__(self, alpha=0.2):
        super().__init__(alpha=alpha)
        self.alpha = alpha

    def fit(self, X, y=None):
        self.level_    = _speed(X)[-1]
        self.is_fitted = True
        return self

    def predict(self, X):
        s     = _speed(X)
        out   = np.empty(len(s))
        level = self.level_
        for i, v in enumerate(s):
            out[i] = level
            level  = self.alpha * v + (1 - self.alpha) * level
        return out


@registry.register
class DoubleExpSmoothing(BaseAlgorithm):
    name        = "Double Exponential Smoothing"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Holt double exponential smoothing one-step forecast"

    def __init__(self, alpha=0.3, beta=0.1):
        super().__init__(alpha=alpha, beta=beta)
        self.alpha = alpha
        self.beta  = beta

    def fit(self, X, y=None):
        s          = _speed(X)
        self.l_    = s[-1]
        self.b_    = float(np.mean(np.diff(s[-5:]))) if len(s) > 5 else 0.0
        self.is_fitted = True
        return self

    def predict(self, X):
        s   = _speed(X)
        l, b = self.l_, self.b_
        out = np.empty(len(s))
        for i, v in enumerate(s):
            out[i] = l + b
            ln     = self.alpha * v + (1 - self.alpha) * (l + b)
            b      = self.beta * (ln - l) + (1 - self.beta) * b
            l      = ln
        return out


@registry.register
class TripleExpSmoothing(BaseAlgorithm):
    name        = "Triple Exponential Smoothing"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Holt-Winters triple exponential smoothing forecast"

    def __init__(self, alpha=0.3, beta=0.1, gamma=0.1, period=12):
        super().__init__(alpha=alpha, beta=beta, gamma=gamma, period=period)
        self.alpha  = alpha
        self.beta   = beta
        self.gamma  = gamma
        self.period = period

    def fit(self, X, y=None):
        s = _speed(X)
        p = min(self.period, max(2, len(s) // 4))
        self.l_      = np.mean(s[:p])
        self.b_      = (np.mean(s[p:2*p]) - self.l_) / p if len(s) >= 2*p else 0.0
        self.season_ = s[:p] - self.l_
        self.p_      = p
        self.is_fitted = True
        return self

    def predict(self, X):
        s = _speed(X)
        p = self.p_
        l, b   = self.l_, self.b_
        season = self.season_.copy()
        out    = np.empty(len(s))
        for i, v in enumerate(s):
            si     = i % p
            out[i] = l + b + season[si]
            ln     = self.alpha * (v - season[si]) + (1 - self.alpha) * (l + b)
            b      = self.beta  * (ln - l)          + (1 - self.beta)  * b
            season[si] = self.gamma * (v - ln) + (1 - self.gamma) * season[si]
            l = ln
        return out


@registry.register
class ThetaMethodForecast(BaseAlgorithm):
    name        = "Theta Method"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Theta method: average of linear trend and SES forecast"

    def fit(self, X, y=None):
        s = _speed(X)
        n = len(s)
        t = np.arange(n)
        self.slope_     = np.polyfit(t, s, 1)[0]
        self.intercept_ = s[0]
        level = s[0]
        for v in s[1:]:
            level = 0.5 * v + 0.5 * level
        self.ses_level_ = level
        self.n_         = n
        self.is_fitted  = True
        return self

    def predict(self, X):
        n = len(X)
        t       = np.arange(self.n_, self.n_ + n)
        theta0  = self.intercept_ + self.slope_ * t
        theta2  = np.full(n, self.ses_level_)
        return 0.5 * (theta0 + theta2)


@registry.register
class NaiveForecast(BaseAlgorithm):
    name        = "Naive Forecast"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Naive forecast: repeat last training value"

    def fit(self, X, y=None):
        self.last_     = _speed(X)[-1]
        self.is_fitted = True
        return self

    def predict(self, X):
        return np.full(len(X), self.last_)


@registry.register
class SeasonalNaiveForecast(BaseAlgorithm):
    name        = "Seasonal Naive Forecast"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Seasonal naive: repeat last full seasonal cycle"

    def __init__(self, period=12):
        super().__init__(period=period)
        self.period = period

    def fit(self, X, y=None):
        s              = _speed(X)
        p              = min(self.period, len(s))
        self.season_   = s[-p:]
        self.is_fitted = True
        return self

    def predict(self, X):
        n = len(X)
        p = len(self.season_)
        return np.array([self.season_[i % p] for i in range(n)])


@registry.register
class DriftMethodForecast(BaseAlgorithm):
    name        = "Drift Method Forecast"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Random walk with drift forecast for speed_ms"

    def fit(self, X, y=None):
        s              = _speed(X)
        n              = len(s)
        self.last_     = s[-1]
        self.drift_    = (s[-1] - s[0]) / (n - 1) if n > 1 else 0.0
        self.is_fitted = True
        return self

    def predict(self, X):
        n = len(X)
        return np.array([self.last_ + (i + 1) * self.drift_ for i in range(n)])


