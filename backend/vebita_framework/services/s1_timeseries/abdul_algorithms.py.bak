    animals     = ["all"]
    description = "Constant forecast equal to training mean — baseline"

    def fit(self, X, y=None):
        self.mean_     = _speed(X).mean()
        self.is_fitted = True
        return self

    def predict(self, X):
        return np.full(len(X), self.mean_)


@registry.register
class RandomWalkForecast(BaseAlgorithm):
    name        = "Random Walk Forecast"
    service_id  = 1
    category    = "forecasting"
    library     = "numpy"
    animals     = ["all"]
    description = "Random walk forecast: last value plus Gaussian noise steps"

    def fit(self, X, y=None):
        s              = _speed(X)
        self.last_     = s[-1]
        self.sigma_    = float(np.std(np.diff(s))) if len(s) > 1 else 0.1
        self.is_fitted = True
        return self

    def predict(self, X):
        np.random.seed(42)
        n     = len(X)
        steps = np.random.normal(0, self.sigma_, n)
        return self.last_ + np.cumsum(steps)


