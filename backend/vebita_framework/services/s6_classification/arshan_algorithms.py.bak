@registry.register
class BC_A22_StepwiseLogistic(BaseAlgorithm):
    """A22 — Forward stepwise logistic regression."""
    name = "BC A22 Stepwise Logistic"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Forward feature selection then multinomial logistic regression"
    def __init__(self, max_features=5):
        super().__init__(max_features=max_features)
        self.max_features = max_features
        self.selected_ = None
        self.m = LogisticRegression(max_iter=300,
                                    solver="lbfgs")
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        selected, remaining = [], list(range(X.shape[1]))
        for _ in range(min(self.max_features, X.shape[1])):
            best_score, best_f = -np.inf, None
            for f in remaining:
                cols = selected + [f]
                tmp = LogisticRegression(max_iter=200,
                                         solver="lbfgs")
                tmp.fit(X[:, cols], y_)
                s = tmp.score(X[:, cols], y_)
                if s > best_score:
                    best_score, best_f = s, f
            if best_f is not None:
                selected.append(best_f); remaining.remove(best_f)
        self.selected_ = selected
        self.m.fit(X[:, self.selected_], y_)
        self.is_fitted = True; return self
    def predict(self, X):
        return self.m.predict(X[:, self.selected_]).astype(float)


@registry.register
class BC_A23_OrdinalClassifier(BaseAlgorithm):
    """A23 — Ordinal threshold classifier (resting→foraging→migrating)."""
    name = "BC A23 Ordinal Classifier"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Treats behaviour as ordered intensity states via LDA scores"
    def __init__(self):
        super().__init__()
        self.lda = LinearDiscriminantAnalysis(n_components=1)
        self.thresholds_ = None
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        scores = self.lda.fit_transform(X, y_).ravel()
        K = len(np.unique(y_))
        self.thresholds_ = np.percentile(scores, np.linspace(0, 100, K + 1)[1:-1])
        self.is_fitted = True; return self
    def predict(self, X):
        scores = self.lda.transform(X).ravel()
        return np.clip(np.digitize(scores, self.thresholds_), 0, 99).astype(float)


