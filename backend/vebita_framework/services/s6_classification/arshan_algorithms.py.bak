@registry.register
class BC_B45_RandomSubspace(BaseAlgorithm):
    """B45 — Random Subspace Ensemble."""
    name = "BC B45 Random Subspace"
    service_id = 6; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "Each classifier uses a random feature subset — reduces correlation"
    def __init__(self, n_estimators=20, max_features=5):
        super().__init__(n_estimators=n_estimators, max_features=max_features)
        self.n_est = n_estimators; self.max_f = max_features
        self.estimators_ = []; self.feat_sets_ = []
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); n = X.shape[1]; np.random.seed(42)
        self.estimators_, self.feat_sets_ = [], []
        for _ in range(self.n_est):
            fidx = np.random.choice(n, min(self.max_f, n), replace=False)
            m = DecisionTreeClassifier(max_depth=5, random_state=42)
            m.fit(X[:, fidx], y_)
            self.estimators_.append(m); self.feat_sets_.append(fidx)
        self.is_fitted = True; return self
    def predict(self, X):
        votes = np.array([m.predict(X[:, f])
                          for m, f in zip(self.estimators_, self.feat_sets_)])
        return np.apply_along_axis(
            lambda col: np.bincount(col.astype(int)).argmax(), 0, votes).astype(float)


