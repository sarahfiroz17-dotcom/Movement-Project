    description = "Nu-SVC sets explicit upper bound on support vector fraction"
    def __init__(self, nu=0.3):
        super().__init__(nu=nu)
        self.nu = min(nu, 0.49)
        self._fallback = SVC(kernel="rbf")
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        try:
            self.m = NuSVC(nu=self.nu, kernel="rbf", decision_function_shape="ovr")
            self.m.fit(X, y_)
        except Exception:
            self.m = self._fallback
            self.m.fit(X, y_)
        self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(X).astype(float)


