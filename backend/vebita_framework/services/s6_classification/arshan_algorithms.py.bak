@registry.register
class BC_C68_LVQ(BaseAlgorithm):
    """C68 — Learning Vector Quantisation (prototype-based)."""
    name = "BC C68 LVQ"
    service_id = 6; category = "C_kernel"; library = "numpy"; animals = ["all"]
    description = "LVQ prototypes updated online to represent each behaviour"
    def __init__(self, epochs=50, lr=0.1):
        super().__init__(epochs=epochs, lr=lr)
        self.epochs = epochs; self.lr = lr
        self.proto_ = None; self.proto_labels_ = None
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.classes_ = np.unique(y_)
        self.proto_ = np.array([X[y_ == c].mean(0) for c in self.classes_])
        self.proto_labels_ = self.classes_.copy()
        lr = self.lr
        for _ in range(self.epochs):
            for i in np.random.permutation(len(X)):
                d = np.linalg.norm(self.proto_ - X[i], axis=1)
                w = np.argmin(d)
                if self.proto_labels_[w] == y_[i]:
                    self.proto_[w] += lr * (X[i] - self.proto_[w])
                else:
                    self.proto_[w] -= lr * (X[i] - self.proto_[w])
            lr *= 0.99
        self.is_fitted = True; return self
    def predict(self, X):
        return self.proto_labels_[
            cdist(X, self.proto_).argmin(axis=1)].astype(float)


@registry.register
class BC_C69_MahalanobisClassifier(BaseAlgorithm):
    """C69 — Mahalanobis distance nearest-class classifier."""
    name = "BC C69 Mahalanobis Classifier"
    service_id = 6; category = "C_kernel"; library = "numpy"; animals = ["all"]
    description = "Assigns fix to class with smallest Mahalanobis distance"
    def __init__(self):
        super().__init__()
        self.means_ = {}; self.cov_inv_ = {}
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.classes_ = np.unique(y_)
        for c in self.classes_:
            Xc = X[y_ == c]
            self.means_[c] = Xc.mean(0)
            cov = np.cov(Xc.T) + np.eye(X.shape[1]) * 1e-6
            self.cov_inv_[c] = np.linalg.inv(cov)
        self.is_fitted = True; return self
    def predict(self, X):
        dists = np.array([
            [np.sqrt((x - self.means_[c]) @ self.cov_inv_[c] @ (x - self.means_[c]))
             for c in self.classes_] for x in X])
        return self.classes_[np.argmin(dists, axis=1)].astype(float)


