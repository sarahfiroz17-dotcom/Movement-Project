@registry.register
class BC_A18_PLSDA(BaseAlgorithm):
    """A18 — PLS-Discriminant Analysis."""
    name = "BC A18 PLS-DA"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "PLS-DA finds latent dimensions linking movement to behaviour"
    def __init__(self, n_components=3):
        super().__init__(n_components=n_components)
        self.pls = PLSRegression(n_components=n_components)
        self.classes_ = None
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.classes_ = np.unique(y_)
        Y = np.eye(len(self.classes_))[y_]
        self.pls.fit(X, Y); self.is_fitted = True; return self
    def predict(self, X):
        Y_hat = self.pls.predict(X)
        return self.classes_[np.argmax(Y_hat, axis=1)].astype(float)


@registry.register
class BC_A19_CanonicalDA(BaseAlgorithm):
    """A19 — Canonical Discriminant Analysis (LDA projection + kNN)."""
    name = "BC A19 Canonical DA"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Projects to canonical space then uses kNN for classification"
    def __init__(self, n_components=3):
        super().__init__(n_components=n_components)
        self.lda = LinearDiscriminantAnalysis(n_components=n_components)
        self.knn = KNeighborsClassifier(n_neighbors=5)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        Xc = self.lda.fit_transform(X, y_)
        self.knn.fit(Xc, y_); self.is_fitted = True; return self
    def predict(self, X):
        return self.knn.predict(self.lda.transform(X)).astype(float)


