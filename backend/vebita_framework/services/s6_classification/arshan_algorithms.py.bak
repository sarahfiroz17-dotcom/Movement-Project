@registry.register
class BC_A25_MixtureLDA(BaseAlgorithm):
    """A25 — Mixture Discriminant Analysis (per-class GMM)."""
    name = "BC A25 Mixture DA"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Per-class GMM models heterogeneous subgroups within each behaviour"
    def __init__(self, n_mix=2):
        super().__init__(n_mix=n_mix)
        self.n_mix = n_mix
        self.gmms_ = {}; self.priors_ = {}
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.classes_ = np.unique(y_); n = len(y_)
        for c in self.classes_:
            Xc = X[y_ == c]
            if len(Xc) >= self.n_mix:
                gm = GaussianMixture(n_components=self.n_mix, random_state=42)
                gm.fit(Xc); self.gmms_[c] = gm
            self.priors_[c] = len(Xc) / n
        self.is_fitted = True; return self
    def predict(self, X):
        scores = np.array([
            self.gmms_[c].score_samples(X) + np.log(self.priors_[c] + 1e-9)
            if c in self.gmms_ else np.full(len(X), np.log(self.priors_[c] + 1e-9))
            for c in self.classes_]).T
        return self.classes_[np.argmax(scores, axis=1)].astype(float)


@registry.register
class BC_A26_BayesianDirichlet(BaseAlgorithm):
    """A26 — Bayesian classifier with Dirichlet prior."""
    name = "BC A26 Bayesian Dirichlet"
    service_id = 6; category = "A_linear"; library = "numpy"; animals = ["all"]
    description = "Dirichlet-smoothed Gaussian NB with class-conditional priors"
    def __init__(self, alpha=1.0):
        super().__init__(alpha=alpha)
        self.alpha = alpha
        self.means_ = {}; self.stds_ = {}; self.priors_ = {}
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.classes_ = np.unique(y_); n = len(y_); K = len(self.classes_)
        for c in self.classes_:
            Xc = X[y_ == c]
            self.means_[c] = Xc.mean(0); self.stds_[c] = Xc.std(0) + 1e-6
            self.priors_[c] = (len(Xc) + self.alpha) / (n + self.alpha * K)
        self.is_fitted = True; return self
    def predict(self, X):
        lp = np.zeros((len(X), len(self.classes_)))
        for i, c in enumerate(self.classes_):
            lp[:, i] = np.log(self.priors_[c]) + np.sum(
                -0.5 * ((X - self.means_[c]) / self.stds_[c]) ** 2
                - np.log(self.stds_[c] * np.sqrt(2 * np.pi)), axis=1)
        return self.classes_[np.argmax(lp, axis=1)].astype(float)


@registry.register
class BC_A27_GLMClassifier(BaseAlgorithm):
    """A27 — Generalised Linear Model classifier (OvR logit link)."""
    name = "BC A27 GLM Classifier"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Binomial GLM extended to multi-class via One-vs-Rest"
    def __init__(self):
        super().__init__()
        self.m = OneVsRestClassifier(
            LogisticRegression(solver="lbfgs", max_iter=300))
    def fit(self, X, y=None):
        self.m.fit(X, _y(y, len(X))); self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(X).astype(float)


@registry.register
class BC_A28_KalmanThreshold(BaseAlgorithm):
    """A28 — Kalman-filtered speed + percentile thresholds."""
    name = "BC A28 Kalman Threshold"
    service_id = 6; category = "A_linear"; library = "numpy"; animals = ["all"]
    description = "Kalman-smoothed speed then percentile thresholds for states"
    def __init__(self, Q=1e-3, R=0.5):
        super().__init__(Q=Q, R=R)
        self.Q = Q; self.R = R; self.thresh_ = None
    def _kal(self, s):
        x, P, out = s[0], 1.0, np.zeros(len(s))
        for i in range(len(s)):
            P += self.Q; K = P / (P + self.R)
            x = x + K * (s[i] - x); P = (1 - K) * P; out[i] = x
        return out
    def fit(self, X, y=None):
        s = self._kal(X[:, 0])
        self.thresh_ = np.percentile(s, [25, 50, 75])
        self.is_fitted = True; return self
    def predict(self, X):
        return np.digitize(self._kal(X[:, 0]), self.thresh_).astype(float)


@registry.register
class BC_A29_SpeedAltitudeRules(BaseAlgorithm):
    """A29 — Expert rule-based classifier (speed + altitude thresholds)."""
    name = "BC A29 Expert Rules"
    service_id = 6; category = "A_linear"; library = "numpy"; animals = ["all"]
    description = "Domain rules: speed/altitude percentile thresholds → states"
    def __init__(self):
        super().__init__()
        self.sp_ = None; self.al_ = None
    def fit(self, X, y=None):
        self.sp_ = np.percentile(X[:, 0], [25, 60])
        self.al_ = np.percentile(X[:, 1], 50)
        self.is_fitted = True; return self
    def predict(self, X):
        sp, al = X[:, 0], X[:, 1]
        labels = np.zeros(len(X), dtype=int)
        labels[(sp >= self.sp_[0]) & (sp < self.sp_[1])] = 1
        labels[(sp >= self.sp_[1]) & (al < self.al_)] = 2
        labels[(sp >= self.sp_[0]) & (al >= self.al_)] = 3
        return labels.astype(float)


@registry.register
class BC_A30_ADWINLogistic(BaseAlgorithm):
    """A30 — ADWIN drift-aware logistic regression."""
    name = "BC A30 ADWIN Logistic"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Shrinks training window when behaviour distribution drifts"
    def __init__(self, delta=0.002):
        super().__init__(delta=delta)
        self.delta = delta
        self.m = LogisticRegression(max_iter=300,
                                    solver="lbfgs")
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); spd = X[:, 0]
        ws = 0
        for i in range(1, len(spd)):
            w1, w2 = spd[ws:i], spd[i:]
            if len(w2) < 5: break
            mu1, mu2 = w1.mean(), w2.mean()
            sp = np.sqrt((w1.var() * len(w1) + w2.var() * len(w2)) /
                         (len(w1) + len(w2)) + 1e-9)
            bound = np.sqrt(np.log(2 / self.delta) / (2 * min(len(w1), len(w2))))
            if abs(mu1 - mu2) / sp > bound:
                ws = i
        Xw, yw = X[ws:], y_[ws:]
        try:
            self.m.fit(Xw if len(Xw) >= 5 else X, yw if len(yw) >= 5 else y_)
        except Exception:
            self.m.fit(X, y_)
        self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(X).astype(float)


