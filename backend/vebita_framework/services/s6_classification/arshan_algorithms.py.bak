@registry.register
class BC_A09_BernoulliNB(BaseAlgorithm):
    """A09 — Bernoulli Naive Bayes on binarised features."""
    name = "BC A09 Bernoulli Naive Bayes"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Binarises movement features at median, then applies Bernoulli NB"
    def __init__(self):
        super().__init__()
        self.m = BernoulliNB()
        self.med_ = None
    def fit(self, X, y=None):
        self.med_ = np.median(X, axis=0)
        self.m.fit((X > self.med_).astype(float), _y(y, len(X)))
        self.is_fitted = True; return self
    def predict(self, X):
        return self.m.predict((X > self.med_).astype(float)).astype(float)


@registry.register
class BC_A10_MultinomialNB(BaseAlgorithm):
    """A10 — Multinomial Naive Bayes on binned features."""
    name = "BC A10 Multinomial Naive Bayes"
    service_id = 6; category = "A_linear"; library = "sklearn"; animals = ["all"]
    description = "Discretises features into 5 bins then applies Multinomial NB"
    def __init__(self, n_bins=5):
        super().__init__(n_bins=n_bins)
        self.n_bins = n_bins
        self.m = MultinomialNB()
        self.bins_ = None
    def _disc(self, X):
        out = np.zeros_like(X, dtype=float)
        for j in range(X.shape[1]):
            out[:, j] = np.digitize(X[:, j], self.bins_[j][1:-1])
        return out
    def fit(self, X, y=None):
        self.bins_ = [np.percentile(X[:, j], np.linspace(0, 100, self.n_bins + 1))
                      for j in range(X.shape[1])]
        self.m.fit(self._disc(X), _y(y, len(X)))
        self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(self._disc(X)).astype(float)


