@registry.register
class BC_B52_AdaptiveBoosting(BaseAlgorithm):
    """B52 — Adaptive Boosting with concept drift detection."""
    name = "BC B52 Adaptive Boosting Drift"
    service_id = 6; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "Re-weights recent data when behaviour distribution drifts"
    def __init__(self, n_estimators=50):
        super().__init__(n_estimators=n_estimators)
        self.n_estimators = n_estimators
        self.m = AdaBoostClassifier(n_estimators=n_estimators,
                                    random_state=42)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        mid = len(X) // 2
        if abs(X[:mid, 0].var() - X[mid:, 0].var()) / (X[:mid, 0].var() + 1e-9) > 0.5:
            w = np.ones(len(X)); w[mid:] = 2.0; w /= w.sum()
            idx = np.random.choice(len(X), len(X), p=w, replace=True)
            X, y_ = X[idx], y_[idx]
        self.m.fit(X, y_); self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(X).astype(float)


@registry.register
class BC_B53_BalancedRF(BaseAlgorithm):
    """B53 — Class-weighted Random Forest for imbalanced behaviour data."""
    name = "BC B53 Balanced Random Forest"
    service_id = 6; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "class_weight='balanced' handles rare behaviour states better"
    def __init__(self, n_estimators=100):
        super().__init__(n_estimators=n_estimators)
        self.m = RandomForestClassifier(n_estimators=n_estimators,
                                        class_weight="balanced",
                                        random_state=42, n_jobs=-1)
    def fit(self, X, y=None):
        self.m.fit(X, _y(y, len(X))); self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(X).astype(float)


@registry.register
class BC_B54_RotationForest(BaseAlgorithm):
    """B54 — Rotation Forest proxy (PCA per feature subset + RF)."""
    name = "BC B54 Rotation Forest Proxy"
    service_id = 6; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "PCA rotation per feature group then Random Forest"
    def __init__(self, n_estimators=30, n_groups=4):
        super().__init__(n_estimators=n_estimators, n_groups=n_groups)
        self.n_groups = n_groups
        self.pcas_ = []
        self.m = RandomForestClassifier(n_estimators=n_estimators, random_state=42)
    def _rotate(self, X):
        cols = np.array_split(np.arange(X.shape[1]), self.n_groups)
        parts = []
        for i, c in enumerate(cols):
            if len(self.pcas_) > i:
                parts.append(self.pcas_[i].transform(X[:, c]))
        return np.hstack(parts) if parts else X
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        cols = np.array_split(np.arange(X.shape[1]), self.n_groups)
        self.pcas_ = []
        for c in cols:
            p = PCA(n_components=len(c)); p.fit(X[:, c]); self.pcas_.append(p)
        self.m.fit(self._rotate(X), y_)
        self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(self._rotate(X)).astype(float)


@registry.register
class BC_B55_SHAPWeightedRF(BaseAlgorithm):
    """B55 — SHAP-weighted Random Forest (permutation importance weighting)."""
    name = "BC B55 SHAP-Weighted RF"
    service_id = 6; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "Features weighted by RF permutation importance before training"
    def __init__(self, n_estimators=50):
        super().__init__(n_estimators=n_estimators)
        self.rf1 = RandomForestClassifier(n_estimators=n_estimators, random_state=42)
        self.rf2 = RandomForestClassifier(n_estimators=n_estimators, random_state=0)
        self.imp_ = None
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.rf1.fit(X, y_)
        self.imp_ = self.rf1.feature_importances_
        self.rf2.fit(X * self.imp_, y_)
        self.is_fitted = True; return self
    def predict(self, X): return self.rf2.predict(X * self.imp_).astype(float)


