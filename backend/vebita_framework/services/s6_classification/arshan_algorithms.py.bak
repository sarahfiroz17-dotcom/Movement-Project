@registry.register
class BC_F96_BCPA(BaseAlgorithm):
    """F96 — Behavioural Change Point Analysis (BCPA)."""
    name = "BC F96 BCPA"
    service_id = 6; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "BCPA detects behaviour transitions as change points in speed"
    def __init__(self, window=20, threshold=1.5):
        super().__init__(window=window, threshold=threshold)
        self.window = window; self.threshold = threshold
    def fit(self, X, y=None):
        self.is_fitted = True; return self
    def predict(self, X):
        spd = X[:, 0]; n = len(spd); w = self.window
        labels = np.zeros(n, dtype=int); state = 0
        for i in range(w, n - w):
            mu_l = spd[i - w: i].mean(); mu_r = spd[i: i + w].mean()
            std  = spd[i - w: i + w].std() + 1e-6
            if abs(mu_r - mu_l) / std > self.threshold:
                state = (state + 1) % 4
            labels[i] = state
        return labels.astype(float)


@registry.register
class BC_F97_FirstPassageTime(BaseAlgorithm):
    """F97 — First Passage Time classifier (area-restricted search)."""
    name = "BC F97 First Passage Time"
    service_id = 6; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "High FPT = foraging (ARS), low FPT = migration"
    def __init__(self, radius=0.5):
        super().__init__(radius=radius)
        self.radius = radius; self.thresh_ = None
    def _fpt(self, X):
        step = X[:, 6] + 1e-3; cum = np.cumsum(step); n = len(X)
        fpt = np.zeros(n)
        for i in range(n):
            j = i
            while j < n and cum[j] - cum[i] < self.radius:
                j += 1
            fpt[i] = j - i
        return fpt
    def fit(self, X, y=None):
        self.thresh_ = np.percentile(self._fpt(X), [25, 50, 75])
        self.is_fitted = True; return self
    def predict(self, X):
        return np.digitize(self._fpt(X), self.thresh_).astype(float)


@registry.register
class BC_F98_NetSquaredDisplacement(BaseAlgorithm):
    """F98 — Net Squared Displacement (NSD) behaviour classifier."""
    name = "BC F98 Net Squared Displacement"
    service_id = 6; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "NSD shape (monotone/plateau/hump) identifies migration type"
    def __init__(self):
        super().__init__()
    def fit(self, X, y=None):
        self.is_fitted = True; return self
    def predict(self, X):
        step = X[:, 6]; cum = np.cumsum(step)
        nsd  = (cum - cum[0]) ** 2; nsd_n = nsd / (nsd.max() + 1e-9)
        mid  = len(nsd) // 2
        labels = np.ones(len(X), dtype=int)  # default foraging
        labels[nsd_n > 0.7]  = 2             # migration
        labels[nsd_n < 0.1]  = 0             # roosting
        labels[mid - 10: mid + 10] = 3       # soaring peak
        return labels.astype(float)


@registry.register
class BC_F99_SpeedTurnBivariate(BaseAlgorithm):
    """F99 — Speed–Turning bivariate state classifier."""
    name = "BC F99 Speed-Turn Bivariate"
    service_id = 6; category = "F_ecological"; library = "sklearn"; animals = ["all"]
    description = "2D KDE in speed-turning space → behaviour zones"
    def __init__(self, n_states=4):
        super().__init__(n_states=n_states)
        self.km = KMeans(n_clusters=n_states, random_state=42, n_init=5)
    def fit(self, X, y=None):
        self.km.fit(X[:, [0, 2]]); self.is_fitted = True; return self
    def predict(self, X):
        return self.km.predict(X[:, [0, 2]]).astype(float)


@registry.register
class BC_F100_MovePersistence(BaseAlgorithm):
    """F100 — Move Persistence (autocorrelated movement) classifier."""
    name = "BC F100 Move Persistence"
    service_id = 6; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Directional persistence of steps classifies movement mode"
    def __init__(self, lag=5):
        super().__init__(lag=lag)
        self.lag = lag; self.thresh_ = None
    def _persist(self, X):
        turn = X[:, 2]; n = len(turn); p = np.zeros(n)
        for i in range(self.lag, n):
            p[i] = np.corrcoef(turn[i - self.lag: i],
                               turn[i - self.lag + 1: i + 1])[0, 1]
        return np.nan_to_num(p)
    def fit(self, X, y=None):
        self.thresh_ = np.percentile(self._persist(X), [25, 50, 75])
        self.is_fitted = True; return self
    def predict(self, X):
        return np.digitize(self._persist(X), self.thresh_).astype(float)


@registry.register
class BC_F101_ResidenceTime(BaseAlgorithm):
    """F101 — Residence Time threshold classifier."""
    name = "BC F101 Residence Time"
    service_id = 6; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Local residence time: long stay = roosting, short = migration"
    def __init__(self, window=10):
        super().__init__(window=window)
        self.window = window; self.thresh_ = None
    def _rt(self, X):
        spd = X[:, 0]; n = len(spd); w = self.window
        return np.array([
            1 / (spd[max(0, i - w): min(n, i + w + 1)].mean() + 0.01)
            for i in range(n)])
    def fit(self, X, y=None):
        self.thresh_ = np.percentile(self._rt(X), [33, 67])
        self.is_fitted = True; return self
    def predict(self, X):
        return np.digitize(self._rt(X), self.thresh_).astype(float)


@registry.register
class BC_F102_ISSFClassifier(BaseAlgorithm):
    """F102 — Integrated Step Selection Function (iSSF) classifier."""
    name = "BC F102 iSSF Classifier"
    service_id = 6; category = "F_ecological"; library = "sklearn"; animals = ["all"]
    description = "iSSF: logistic regression on step-level attributes"
    def __init__(self):
        super().__init__()
        self.m = LogisticRegression(max_iter=300,
                                    solver="lbfgs")
    def fit(self, X, y=None):
        step = X[:, 6:7]; turn = X[:, 2:3]
        Xssf = np.hstack([X, step * turn, step ** 2])
        self.m.fit(Xssf, _y(y, len(X))); self.is_fitted = True; return self
    def predict(self, X):
        step = X[:, 6:7]; turn = X[:, 2:3]
        return self.m.predict(np.hstack([X, step * turn, step ** 2])).astype(float)


@registry.register
class BC_F103_CTMMClassifier(BaseAlgorithm):
    """F103 — Continuous-Time Movement Model (CTMM) proxy classifier."""
    name = "BC F103 CTMM Classifier"
    service_id = 6; category = "F_ecological"; library = "sklearn"; animals = ["all"]
    description = "OU process proxy: speed + autocorrelation features → state"
    def __init__(self, n_states=4):
        super().__init__(n_states=n_states)
        self.km = KMeans(n_clusters=n_states, random_state=42, n_init=5)
    def fit(self, X, y=None):
        spd = X[:, 0]
        acf = np.full(len(X), np.corrcoef(spd[:-1], spd[1:])[0, 1])
        self.km.fit(np.column_stack([X, acf]))
        self.is_fitted = True; return self
    def predict(self, X):
        spd = X[:, 0]
        acf = np.full(len(X), np.corrcoef(spd[:-1], spd[1:])[0, 1])
        return self.km.predict(np.column_stack([X, acf])).astype(float)


@registry.register
class BC_F104_ActivityBudget(BaseAlgorithm):
    """F104 — Activity Budget Model (time allocation classifier)."""
    name = "BC F104 Activity Budget"
    service_id = 6; category = "F_ecological"; library = "numpy"; animals = ["all"]
    description = "Budget-based: classify fix into expected time-use category"
    def __init__(self, budgets=None):
        super().__init__()
        self.budgets = budgets or [0.25, 0.40, 0.20, 0.15]
        self.bounds_ = None
    def fit(self, X, y=None):
        self.bounds_ = np.percentile(X[:, 0], np.cumsum(self.budgets) * 100)
        self.is_fitted = True; return self
    def predict(self, X):
        return np.digitize(X[:, 0], self.bounds_[:-1]).astype(float)


@registry.register
class BC_F105_HMMRFHybrid(BaseAlgorithm):
    """F105 — Hybrid HMM + Random Forest (temporal + spatial)."""
    name = "BC F105 HMM+RF Hybrid"
    service_id = 6; category = "F_ecological"; library = "sklearn"; animals = ["all"]
    description = "RF for instant behaviour + HMM Viterbi for temporal coherence"
    def __init__(self, n_estimators=50, n_states=4):
        super().__init__(n_estimators=n_estimators, n_states=n_states)
        self.rf = RandomForestClassifier(n_estimators=n_estimators, random_state=42)
        self.K  = n_states; self.A_ = None; self.pi_ = None
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); self.rf.fit(X, y_)
        K = self.K
        self.A_  = np.ones((K, K)) / K
        self.pi_ = np.ones(K) / K
        for t in range(len(y_) - 1):
            self.A_[y_[t] % K, y_[t + 1] % K] += 1
        self.A_ /= self.A_.sum(1, keepdims=True) + 1e-9
        self.is_fitted = True; return self
    def predict(self, X):
        rf_p = self.rf.predict_proba(X)
        K    = min(self.K, rf_p.shape[1])
        T    = len(X)
        log_e = np.log(rf_p[:, :K] + 1e-9)
        delta = np.log(self.pi_[:K] + 1e-9) + log_e[0]
        psi   = np.zeros((T, K), dtype=int)
        for t in range(1, T):
            tr = delta[:, None] + np.log(self.A_[:K, :K] + 1e-9)
            psi[t] = tr.argmax(0); delta = tr.max(0) + log_e[t]
        path = np.zeros(T, dtype=int); path[-1] = delta.argmax()
        for t in range(T - 2, -1, -1):
            path[t] = psi[t + 1, path[t + 1]]
        return (path % K).astype(float)


