@registry.register
class BC_B49_IsolationForestProxy(BaseAlgorithm):
    """B49 — Isolation Forest anomaly score → behaviour tier."""
    name = "BC B49 Isolation Forest Proxy"
    service_id = 6; category = "B_tree"; library = "sklearn"; animals = ["all"]
    description = "Anomaly score from Isolation Forest mapped to behaviour tiers"
    def __init__(self, n_estimators=100):
        super().__init__(n_estimators=n_estimators)
        from sklearn.ensemble import IsolationForest
        self.iso = IsolationForest(n_estimators=n_estimators,
                                   random_state=42, contamination=0.1)
        self.thresh_ = None
    def fit(self, X, y=None):
        scores = self.iso.fit_predict(X).astype(float)
        score_c = -self.iso.score_samples(X)
        self.thresh_ = np.percentile(score_c, [25, 50, 75])
        self.is_fitted = True; return self
    def predict(self, X):
        sc = -self.iso.score_samples(X)
        return np.digitize(sc, self.thresh_).astype(float)


