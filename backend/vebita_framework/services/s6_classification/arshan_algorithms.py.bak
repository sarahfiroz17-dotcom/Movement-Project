# ══════════════════════════════════════════════════════════════════════════════
# D.  PROBABILISTIC & BAYESIAN  (#71 – #80)
# ══════════════════════════════════════════════════════════════════════════════

class _HMM(BaseAlgorithm):
    """Shared Viterbi-based HMM backbone used by D71–D78."""
    n_states   = 4
    service_id = 6
    category   = "D_probabilistic"
    library    = "numpy"
    animals    = ["all"]

    def _init_params(self, X, y):
        K = self.n_states
        self.means_ = np.zeros((K, X.shape[1]))
        self.stds_  = np.ones((K, X.shape[1]))
        self.A_     = np.ones((K, K)) / K
        self.pi_    = np.ones(K) / K
        for k in range(K):
            mask = (y % K) == k
            if mask.sum() > 1:
                self.means_[k] = X[mask].mean(0)
                self.stds_[k]  = X[mask].std(0) + 1e-6
        for t in range(len(y) - 1):
            self.A_[y[t] % K, y[t + 1] % K] += 1
        self.A_ /= self.A_.sum(1, keepdims=True) + 1e-9

    def _emit(self, x, k):
        return np.sum(-0.5 * ((x - self.means_[k]) / self.stds_[k]) ** 2
                      - np.log(self.stds_[k] * np.sqrt(2 * np.pi)))

    def predict(self, X):
        K  = self.n_states; T = len(X)
        delta = np.log(self.pi_ + 1e-9) + np.array([self._emit(X[0], k) for k in range(K)])
        psi = np.zeros((T, K), dtype=int)
        for t in range(1, T):
            trans = delta[:, None] + np.log(self.A_ + 1e-9)
            psi[t] = trans.argmax(0)
            delta  = trans.max(0) + np.array([self._emit(X[t], k) for k in range(K)])
        path = np.zeros(T, dtype=int); path[-1] = delta.argmax()
        for t in range(T - 2, -1, -1):
            path[t] = psi[t + 1, path[t + 1]]
        return (path % K).astype(float)


@registry.register
class BC_D71_HMM2(BaseAlgorithm):
    """D71 — 2-State HMM (active vs inactive)."""
    name = "BC D71 HMM 2-State"
    service_id = 6; category = "D_probabilistic"
    library = "numpy"; animals = ["all"]
    description = "2-state HMM: active vs resting behaviour"
    def __init__(self):
        super().__init__()
        self.n_states = 2
        self.means_ = None; self.stds_ = None
        self.A_ = None; self.pi_ = None
    def _emit(self, x, k):
        return np.sum(-0.5 * ((x - self.means_[k]) / self.stds_[k]) ** 2
                      - np.log(self.stds_[k] * np.sqrt(2 * np.pi)))
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = self.n_states
        self.means_ = np.zeros((K, X.shape[1]))
        self.stds_  = np.ones((K, X.shape[1]))
        self.A_     = np.ones((K, K)) / K
        self.pi_    = np.ones(K) / K
        for k in range(K):
            mask = (y_ % K) == k
            if mask.sum() > 1:
                self.means_[k] = X[mask].mean(0)
                self.stds_[k]  = X[mask].std(0) + 1e-6
        for t in range(len(y_) - 1):
            self.A_[y_[t] % K, y_[t + 1] % K] += 1
        self.A_ /= self.A_.sum(1, keepdims=True) + 1e-9
        self.is_fitted = True; return self
    def predict(self, X):
        K = self.n_states; T = len(X)
        delta = np.log(self.pi_ + 1e-9) + np.array([self._emit(X[0], k) for k in range(K)])
        psi = np.zeros((T, K), dtype=int)
        for t in range(1, T):
            tr = delta[:, None] + np.log(self.A_ + 1e-9)
            psi[t] = tr.argmax(0)
            delta  = tr.max(0) + np.array([self._emit(X[t], k) for k in range(K)])
        path = np.zeros(T, dtype=int); path[-1] = delta.argmax()
        for t in range(T - 2, -1, -1):
            path[t] = psi[t + 1, path[t + 1]]
        return (path % K).astype(float)


@registry.register
class BC_D72_HMM4(BC_D71_HMM2):
    """D72 — 4-State HMM (foraging / migration / roosting / soaring)."""
    name = "BC D72 HMM 4-State"
    description = "4-state Gaussian HMM — gold standard for bird behaviour"
    def __init__(self):
        super().__init__(); self.n_states = 4


@registry.register
class BC_D73_HMMVonMises(BC_D72_HMM4):
    """D73 — HMM with von Mises emissions on turning angle."""
    name = "BC D73 HMM von Mises"
    description = "Von Mises turning-angle emission + Gaussian speed emission"
    def __init__(self):
        super().__init__()
        self.mu_turn_ = None; self.kappa_ = None
    def fit(self, X, y=None):
        super().fit(X, y)
        K = self.n_states
        self.mu_turn_ = np.zeros(K); self.kappa_ = np.ones(K)
        y_ = _y(y, len(X))
        for k in range(K):
            ang = np.radians(X[(y_ % K) == k, 2])
            if len(ang) > 1:
                self.mu_turn_[k] = np.angle(np.mean(np.exp(1j * ang)))
                R = abs(np.mean(np.exp(1j * ang)))
                self.kappa_[k] = R * (2 - R ** 2) / (1 - R ** 2 + 1e-9)
        return self
    def _emit(self, x, k):
        vm = self.kappa_[k] * np.cos(np.radians(x[2]) - self.mu_turn_[k])
        gauss = np.sum(-0.5 * ((x[[0, 1, 3, 4, 5, 6, 7]] - self.means_[k, [0, 1, 3, 4, 5, 6, 7]]) /
                                self.stds_[k, [0, 1, 3, 4, 5, 6, 7]]) ** 2)
        return vm + gauss


@registry.register
class BC_D74_HMMGamma(BC_D72_HMM4):
    """D74 — HMM with Gamma emission on speed."""
    name = "BC D74 HMM Gamma Speed"
    description = "Gamma-distributed speed emissions for right-skewed GPS speeds"
    def __init__(self):
        super().__init__()
        self.shape_ = None; self.scale_ = None
    def fit(self, X, y=None):
        super().fit(X, y)
        K = self.n_states; y_ = _y(y, len(X))
        self.shape_ = np.ones(K); self.scale_ = np.ones(K)
        for k in range(K):
            spd = X[(y_ % K) == k, 0]; spd = spd[spd > 0]
            if len(spd) > 1:
                m, v = spd.mean(), spd.var() + 1e-6
                self.scale_[k] = v / m; self.shape_[k] = m / self.scale_[k]
        return self
    def _emit(self, x, k):
        s = max(x[0], 1e-6)
        lg = (self.shape_[k] - 1) * np.log(s) - s / self.scale_[k]
        gauss = np.sum(-0.5 * ((x[1:] - self.means_[k, 1:]) / self.stds_[k, 1:]) ** 2)
        return lg + gauss


@registry.register
class BC_D75_HMMContinuousTime(BC_D72_HMM4):
    """D75 — Continuous-Time HMM (irregular GPS intervals)."""
    name = "BC D75 CT-HMM"
    description = "CT-HMM scales transition probs by surrogate time intervals"
    def __init__(self, base_rate=0.01):
        super().__init__(); self.base_rate = base_rate
    def predict(self, X):
        K = self.n_states; T = len(X)
        delta = np.log(self.pi_ + 1e-9) + np.array([self._emit(X[0], k) for k in range(K)])
        psi = np.zeros((T, K), dtype=int)
        for t in range(1, T):
            dt = X[t, 0] / (X[t, 4] + 1e-3)
            A_ct = (np.exp(-self.base_rate * dt) * self.A_ +
                    (1 - np.exp(-self.base_rate * dt)) / K)
            tr = delta[:, None] + np.log(A_ct + 1e-9)
            psi[t] = tr.argmax(0)
            delta  = tr.max(0) + np.array([self._emit(X[t], k) for k in range(K)])
        path = np.zeros(T, dtype=int); path[-1] = delta.argmax()
        for t in range(T - 2, -1, -1):
            path[t] = psi[t + 1, path[t + 1]]
        return (path % K).astype(float)


@registry.register
class BC_D76_DBNProxy(BC_D72_HMM4):
    """D76 — Dynamic Bayesian Network proxy (NB + Markov transitions)."""
    name = "BC D76 Dynamic Bayesian Network"
    description = "DBN: NB emissions with Markov state transitions"
    def __init__(self):
        super().__init__()
        self.nb_ = GaussianNB()
    def fit(self, X, y=None):
        super().fit(X, y)
        self.nb_.fit(X, _y(y, len(X)) % self.n_states)
        return self
    def predict(self, X):
        log_emit = np.log(self.nb_.predict_proba(X) + 1e-9)
        K = self.n_states; T = len(X)
        delta = log_emit[0]; psi = []; path = np.zeros(T, dtype=int)
        for t in range(1, T):
            tr = delta[:, None] + np.log(self.A_ + 1e-9)
            delta = tr.max(0) + log_emit[t]; psi.append(tr.argmax(0))
        path[-1] = delta.argmax()
        for t in range(T - 2, -1, -1):
            path[t] = psi[t][path[t + 1]]
        return (path % K).astype(float)


@registry.register
class BC_D77_GMMClassifier(BaseAlgorithm):
    """D77 — Per-class GMM classifier."""
    name = "BC D77 GMM Classifier"
    service_id = 6; category = "D_probabilistic"
    library = "sklearn"; animals = ["all"]
    description = "Per-class GMM: each behaviour has its own mixture"
    def __init__(self, n_mix=2):
        super().__init__(n_mix=n_mix)
        self.n_mix = n_mix; self.gmms_ = {}; self.priors_ = {}
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); self.classes_ = np.unique(y_); n = len(y_)
        for c in self.classes_:
            Xc = X[y_ == c]
            if len(Xc) >= self.n_mix:
                gm = GaussianMixture(n_components=self.n_mix, random_state=42)
                gm.fit(Xc); self.gmms_[c] = gm
            self.priors_[c] = len(Xc) / n
        self.is_fitted = True; return self
    def predict(self, X):
        scores = np.array([
            self.gmms_[c].score_samples(X) + np.log(self.priors_[c] + 1e-9)
            if c in self.gmms_ else np.full(len(X), np.log(self.priors_[c] + 1e-9))
            for c in self.classes_]).T
        return self.classes_[np.argmax(scores, axis=1)].astype(float)


@registry.register
class BC_D78_BayesianGMM(BaseAlgorithm):
    """D78 — Variational Bayesian GMM classifier."""
    name = "BC D78 Variational Bayesian GMM"
    service_id = 6; category = "D_probabilistic"
    library = "sklearn"; animals = ["all"]
    description = "DPGMM infers behaviour component count automatically"
    def __init__(self, max_components=8):
        super().__init__(max_components=max_components)
        self.m = BayesianGaussianMixture(n_components=max_components,
                                          random_state=42)
        self.mapping_ = {}
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); self.m.fit(X)
        raw = self.m.predict(X)
        for comp in np.unique(raw):
            self.mapping_[comp] = _majority(y_[raw == comp])
        self.is_fitted = True; return self
    def predict(self, X):
        raw = self.m.predict(X)
        return np.array([self.mapping_.get(r, 0) for r in raw], dtype=float)


@registry.register
class BC_D79_GPCMatern(BaseAlgorithm):
    """D79 — Gaussian Process Classifier (Matern-1.5 kernel)."""
    name = "BC D79 GP Classifier Matern"
    service_id = 6; category = "D_probabilistic"
    library = "sklearn"; animals = ["all"]
    description = "GP Matern kernel: smoother behaviour probability surfaces"
    def __init__(self):
        super().__init__()
        self.m = GaussianProcessClassifier(
            kernel=Matern(nu=1.5), n_restarts_optimizer=0, random_state=42)
    def fit(self, X, y=None):
        self.m.fit(X[:200], _y(y, len(X))[:200])
        self.is_fitted = True; return self
    def predict(self, X): return self.m.predict(X).astype(float)


@registry.register
class BC_D80_KalmanGMM(BaseAlgorithm):
    """D80 — Kalman-smoothed features + GMM decoder."""
    name = "BC D80 Kalman + GMM"
    service_id = 6; category = "D_probabilistic"
    library = "sklearn"; animals = ["all"]
    description = "Kalman-smoothed GPS features fed into GMM for behaviour"
    def __init__(self, Q=1e-3, R=0.1, n_components=4):
        super().__init__(Q=Q, R=R, n_components=n_components)
        self.Q = Q; self.R = R
        self.m = GaussianMixture(n_components=n_components, random_state=42)
        self.mapping_ = {}
    def _smooth(self, X):
        out = np.zeros_like(X)
        for j in range(X.shape[1]):
            s = X[:, j]; x, P = s[0], 1.0; col = np.zeros(len(s))
            for i in range(len(s)):
                P += self.Q; K = P / (P + self.R)
                x = x + K * (s[i] - x); P = (1 - K) * P; col[i] = x
            out[:, j] = col
        return out
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); Xs = self._smooth(X); self.m.fit(Xs)
        raw = self.m.predict(Xs)
        for comp in np.unique(raw):
            self.mapping_[comp] = _majority(y_[raw == comp])
        self.is_fitted = True; return self
    def predict(self, X):
        raw = self.m.predict(self._smooth(X))
        return np.array([self.mapping_.get(r, 0) for r in raw], dtype=float)


# ══════════════════════════════════════════════════════════════════════════════
# E.  DEEP LEARNING  (#81 – #95)
# ══════════════════════════════════════════════════════════════════════════════

@registry.register
class BC_E81_MLP(BaseAlgorithm):
    """E81 — 2-hidden-layer MLP classifier."""
    name = "BC E81 MLP"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "2-layer neural network trained on movement features"
    def __init__(self, h=64, epochs=150, lr=0.01):
        super().__init__(h=h, epochs=epochs, lr=lr)
        self.h = h; self.epochs = epochs; self.lr = lr
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        np.random.seed(42)
        self.W1 = np.random.randn(X.shape[1], self.h) * np.sqrt(2 / X.shape[1])
        self.b1 = np.zeros(self.h)
        self.W2 = np.random.randn(self.h, K) * np.sqrt(2 / self.h)
        self.b2 = np.zeros(K)
        for _ in range(self.epochs):
            h = _relu(X @ self.W1 + self.b1)
            probs = _softmax(h @ self.W2 + self.b2)
            dL = _ce_grad(probs, y_, K)
            self.W2 -= self.lr * h.T @ dL; self.b2 -= self.lr * dL.mean(0)
            dh = (dL @ self.W2.T) * (h > 0)
            self.W1 -= self.lr * X.T @ dh; self.b1 -= self.lr * dh.mean(0)
        self.is_fitted = True; return self
    def predict(self, X):
        h = _relu(X @ self.W1 + self.b1)
        return np.argmax(h @ self.W2 + self.b2, axis=1).astype(float)


@registry.register
class BC_E82_DeepMLP(BaseAlgorithm):
    """E82 — Deep MLP (3 hidden layers)."""
    name = "BC E82 Deep MLP 3-Layer"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "3-layer MLP for deep behaviour feature abstraction"
    def __init__(self, h1=64, h2=32, h3=16, epochs=100, lr=0.01):
        super().__init__(h1=h1, h2=h2, h3=h3, epochs=epochs, lr=lr)
        self.sizes = [h1, h2, h3]; self.epochs = epochs; self.lr = lr
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        dims = [X.shape[1]] + self.sizes + [K]; np.random.seed(0)
        self.W = [np.random.randn(dims[i], dims[i + 1]) * 0.1
                  for i in range(len(dims) - 1)]
        self.b = [np.zeros(dims[i + 1]) for i in range(len(dims) - 1)]
        for _ in range(self.epochs):
            acts = [X]
            for i in range(len(self.W) - 1):
                acts.append(_relu(acts[-1] @ self.W[i] + self.b[i]))
            probs = _softmax(acts[-1] @ self.W[-1] + self.b[-1])
            dL = _ce_grad(probs, y_, K)
            for i in range(len(self.W) - 1, -1, -1):
                self.W[i] -= self.lr * acts[i].T @ dL
                self.b[i] -= self.lr * dL.mean(0)
                if i > 0:
                    dL = (dL @ self.W[i].T) * (acts[i] > 0)
        self.is_fitted = True; return self
    def predict(self, X):
        a = X
        for i in range(len(self.W) - 1):
            a = _relu(a @ self.W[i] + self.b[i])
        return np.argmax(a @ self.W[-1] + self.b[-1], axis=1).astype(float)


@registry.register
class BC_E83_LSTM(BaseAlgorithm):
    """E83 — LSTM classifier."""
    name = "BC E83 LSTM"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "LSTM gating captures long-range behaviour context"
    def __init__(self, hidden=16, epochs=30, lr=0.01):
        super().__init__(hidden=hidden, epochs=epochs, lr=lr)
        self.hidden = hidden; self.epochs = epochs; self.lr = lr
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        n, h = X.shape[1], self.hidden; s = 0.1; np.random.seed(42)
        self.Wf = np.random.randn(n + h, h) * s; self.bf = np.zeros(h)
        self.Wi = np.random.randn(n + h, h) * s; self.bi = np.zeros(h)
        self.Wc = np.random.randn(n + h, h) * s; self.bc = np.zeros(h)
        self.Wo = np.random.randn(n + h, h) * s; self.bo = np.zeros(h)
        self.Wy = np.random.randn(h, K) * s;     self.by = np.zeros(K)
        for _ in range(self.epochs):
            ht, ct = np.zeros(h), np.zeros(h)
            for t in range(len(X)):
                c = np.concatenate([X[t], ht])
                f = _sigmoid(c @ self.Wf + self.bf)
                i = _sigmoid(c @ self.Wi + self.bi)
                ct_ = np.tanh(c @ self.Wc + self.bc)
                ct = f * ct + i * ct_
                o = _sigmoid(c @ self.Wo + self.bo)
                ht = o * np.tanh(ct)
                p = _softmax((ht @ self.Wy + self.by).reshape(1, -1)).ravel()
                e = p.copy(); e[y_[t] % K] -= 1
                self.Wy -= self.lr * np.outer(ht, e)
                self.by -= self.lr * e
        self.is_fitted = True; return self
    def predict(self, X):
        h = self.hidden; ht, ct = np.zeros(h), np.zeros(h); out = []
        for t in range(len(X)):
            c = np.concatenate([X[t], ht])
            f = _sigmoid(c @ self.Wf + self.bf)
            i = _sigmoid(c @ self.Wi + self.bi)
            ct_ = np.tanh(c @ self.Wc + self.bc)
            ct = f * ct + i * ct_
            o = _sigmoid(c @ self.Wo + self.bo)
            ht = o * np.tanh(ct)
            out.append(np.argmax(ht @ self.Wy + self.by))
        return np.array(out, dtype=float)


@registry.register
class BC_E84_BiLSTM(BaseAlgorithm):
    """E84 — Bidirectional LSTM."""
    name = "BC E84 Bidirectional LSTM"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "BiLSTM concatenates forward and backward hidden states"
    def __init__(self, hidden=12, epochs=20, lr=0.01):
        super().__init__(hidden=hidden, epochs=epochs, lr=lr)
        self.fwd = BC_E83_LSTM(hidden=hidden, epochs=epochs, lr=lr)
        self.bwd = BC_E83_LSTM(hidden=hidden, epochs=epochs, lr=lr)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.fwd.fit(X, y_); self.bwd.fit(X[::-1], y_[::-1])
        self.is_fitted = True; return self
    def predict(self, X):
        pf = self.fwd.predict(X)
        pb = self.bwd.predict(X[::-1])[::-1]
        return np.round((pf + pb) / 2).astype(float)


@registry.register
class BC_E85_GRU(BaseAlgorithm):
    """E85 — GRU classifier."""
    name = "BC E85 GRU"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "GRU update/reset gates for efficient behaviour sequences"
    def __init__(self, hidden=16, epochs=30, lr=0.01):
        super().__init__(hidden=hidden, epochs=epochs, lr=lr)
        self.hidden = hidden; self.epochs = epochs; self.lr = lr
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        n, h = X.shape[1], self.hidden; s = 0.1; np.random.seed(42)
        self.Wz = np.random.randn(n + h, h) * s; self.bz = np.zeros(h)
        self.Wr = np.random.randn(n + h, h) * s; self.br = np.zeros(h)
        self.Wn = np.random.randn(n + h, h) * s; self.bn = np.zeros(h)
        self.Wy = np.random.randn(h, K) * s;     self.by = np.zeros(K)
        for _ in range(self.epochs):
            ht = np.zeros(h)
            for t in range(len(X)):
                c = np.concatenate([X[t], ht])
                z = _sigmoid(c @ self.Wz + self.bz)
                r = _sigmoid(c @ self.Wr + self.br)
                n_ = np.tanh(np.concatenate([X[t], r * ht]) @ self.Wn + self.bn)
                ht = (1 - z) * n_ + z * ht
                p = _softmax((ht @ self.Wy + self.by).reshape(1, -1)).ravel()
                e = p.copy(); e[y_[t] % K] -= 1
                self.Wy -= self.lr * np.outer(ht, e)
                self.by -= self.lr * e
        self.is_fitted = True; return self
    def predict(self, X):
        ht = np.zeros(self.hidden); out = []
        for t in range(len(X)):
            c = np.concatenate([X[t], ht])
            z = _sigmoid(c @ self.Wz + self.bz)
            r = _sigmoid(c @ self.Wr + self.br)
            n_ = np.tanh(np.concatenate([X[t], r * ht]) @ self.Wn + self.bn)
            ht = (1 - z) * n_ + z * ht
            out.append(np.argmax(ht @ self.Wy + self.by))
        return np.array(out, dtype=float)


@registry.register
class BC_E86_CNN1D(BaseAlgorithm):
    """E86 — 1D CNN over sliding movement windows."""
    name = "BC E86 1D CNN"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "Causal 1D convolution extracts local behaviour patterns"
    def __init__(self, n_filters=8, kernel_size=5, epochs=20):
        super().__init__(n_filters=n_filters, kernel_size=kernel_size, epochs=epochs)
        self.nf = n_filters; self.ks = kernel_size; self.epochs = epochs
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        np.random.seed(42)
        self.kernels_ = np.random.randn(self.nf, X.shape[1], self.ks) * 0.1
        self.Wout_ = np.random.randn(self.nf, K) * 0.1
        self.bout_ = np.zeros(K)
        self.is_fitted = True; return self
    def _conv(self, X):
        n, k = len(X), self.ks
        maps = np.zeros((n, self.nf))
        for fi in range(self.nf):
            for t in range(n):
                seg = X[max(0, t - k + 1): t + 1]
                if len(seg) < k:
                    seg = np.pad(seg, ((k - len(seg), 0), (0, 0)), mode="edge")
                maps[t, fi] = np.sum(self.kernels_[fi] * seg.T)
        return _relu(maps)
    def predict(self, X):
        return np.argmax(self._conv(X) @ self.Wout_ + self.bout_,
                         axis=1).astype(float)


@registry.register
class BC_E87_TCN(BaseAlgorithm):
    """E87 — Temporal Convolutional Network (dilated causal convolutions)."""
    name = "BC E87 TCN"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "Dilated causal convolutions capture multi-scale behaviour"
    def __init__(self, n_filters=8, kernel_size=3, n_layers=3):
        super().__init__(n_filters=n_filters, kernel_size=kernel_size,
                         n_layers=n_layers)
        self.nf = n_filters; self.ks = kernel_size; self.nl = n_layers
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        np.random.seed(42)
        self.layers_ = []
        in_ch = X.shape[1]
        for _ in range(self.nl):
            self.layers_.append(np.random.randn(self.nf, in_ch, self.ks) * 0.1)
            in_ch = self.nf
        self.Wout_ = np.random.randn(self.nf, K) * 0.1
        self.bout_ = np.zeros(K)
        self.is_fitted = True; return self
    def predict(self, X):
        a = X
        for l, W in enumerate(self.layers_):
            d = 2 ** l; n = len(a)
            out = np.zeros((n, self.nf))
            for fi in range(self.nf):
                for t in range(n):
                    idxs = [max(0, t - d * j) for j in range(self.ks - 1, -1, -1)]
                    seg = a[idxs]
                    out[t, fi] = np.sum(W[fi] * seg.T)
            a = _relu(out)
        return np.argmax(a @ self.Wout_ + self.bout_, axis=1).astype(float)


@registry.register
class BC_E88_Transformer(BaseAlgorithm):
    """E88 — Self-Attention Transformer classifier."""
    name = "BC E88 Transformer"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "Scaled dot-product attention over full behaviour sequence"
    def __init__(self, d_model=8, epochs=20, lr=0.005):
        super().__init__(d_model=d_model, epochs=epochs, lr=lr)
        self.d = d_model; self.epochs = epochs; self.lr = lr
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        np.random.seed(42)
        self.Wq_ = np.random.randn(X.shape[1], self.d) * 0.1
        self.Wk_ = np.random.randn(X.shape[1], self.d) * 0.1
        self.Wv_ = np.random.randn(X.shape[1], self.d) * 0.1
        self.Wo_ = np.random.randn(self.d, K) * 0.1
        self.bo_ = np.zeros(K)
        self.is_fitted = True; return self
    def _attend(self, X):
        Q = X @ self.Wq_; K_ = X @ self.Wk_; V = X @ self.Wv_
        sc = Q @ K_.T / np.sqrt(self.d)
        w = np.exp(sc - sc.max(1, keepdims=True))
        w /= w.sum(1, keepdims=True) + 1e-9
        return w @ V
    def predict(self, X):
        return np.argmax(self._attend(X) @ self.Wo_ + self.bo_,
                         axis=1).astype(float)


@registry.register
class BC_E89_CNNLSTM(BaseAlgorithm):
    """E89 — CNN + LSTM hybrid."""
    name = "BC E89 CNN+LSTM"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "CNN local features fed into LSTM temporal memory"
    def __init__(self, n_filters=6, hidden=12, epochs=20):
        super().__init__(n_filters=n_filters, hidden=hidden, epochs=epochs)
        self.cnn  = BC_E86_CNN1D(n_filters=n_filters, kernel_size=3, epochs=1)
        self.lstm = BC_E83_LSTM(hidden=hidden, epochs=epochs)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.cnn.fit(X, y_)
        self.lstm.fit(self.cnn._conv(X), y_)
        self.is_fitted = True; return self
    def predict(self, X):
        return self.lstm.predict(self.cnn._conv(X))


@registry.register
class BC_E90_CNNGRU(BaseAlgorithm):
    """E90 — CNN + GRU hybrid."""
    name = "BC E90 CNN+GRU"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "CNN feature maps then GRU for temporal behaviour labelling"
    def __init__(self, n_filters=6, hidden=12, epochs=20):
        super().__init__(n_filters=n_filters, hidden=hidden, epochs=epochs)
        self.cnn = BC_E86_CNN1D(n_filters=n_filters, kernel_size=3, epochs=1)
        self.gru = BC_E85_GRU(hidden=hidden, epochs=epochs)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.cnn.fit(X, y_)
        self.gru.fit(self.cnn._conv(X), y_)
        self.is_fitted = True; return self
    def predict(self, X):
        return self.gru.predict(self.cnn._conv(X))


@registry.register
class BC_E91_Autoencoder(BaseAlgorithm):
    """E91 — Autoencoder + softmax head (semi-supervised)."""
    name = "BC E91 Autoencoder+Softmax"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "AE bottleneck features fed to softmax behaviour head"
    def __init__(self, latent=4, epochs=80, lr=0.01):
        super().__init__(latent=latent, epochs=epochs, lr=lr)
        self.latent = latent; self.epochs = epochs; self.lr = lr
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        n = X.shape[1]; np.random.seed(42)
        self.We_ = np.random.randn(n, self.latent) * 0.1
        self.be_ = np.zeros(self.latent)
        self.Wd_ = np.random.randn(self.latent, n) * 0.1
        self.Wc_ = np.random.randn(self.latent, K) * 0.1
        self.bc_ = np.zeros(K)
        for _ in range(self.epochs):
            z = _relu(X @ self.We_ + self.be_)
            recon = z @ self.Wd_
            probs = _softmax(z @ self.Wc_ + self.bc_)
            re = recon - X
            ce = _ce_grad(probs, y_, K)
            self.Wc_ -= self.lr * z.T @ ce; self.bc_ -= self.lr * ce.mean(0)
            dz = re @ self.Wd_.T + ce @ self.Wc_.T; dz *= (z > 0)
            self.Wd_ -= self.lr * z.T @ re / len(X)
            self.We_ -= self.lr * X.T @ dz / len(X)
        self.is_fitted = True; return self
    def predict(self, X):
        z = _relu(X @ self.We_ + self.be_)
        return np.argmax(z @ self.Wc_ + self.bc_, axis=1).astype(float)


@registry.register
class BC_E92_VAEClassifier(BaseAlgorithm):
    """E92 — Variational Autoencoder + classifier head."""
    name = "BC E92 VAE Classifier"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "VAE encodes behaviour uncertainty then classifies from latent"
    def __init__(self, latent=3, epochs=60, lr=0.01):
        super().__init__(latent=latent, epochs=epochs, lr=lr)
        self.latent = latent; self.epochs = epochs; self.lr = lr
    def fit(self, X, y=None):
        y_ = _y(y, len(X)); K = len(np.unique(y_)); self.K_ = K
        n = X.shape[1]; np.random.seed(42)
        self.Wmu_  = np.random.randn(n, self.latent) * 0.1
        self.Wlog_ = np.random.randn(n, self.latent) * 0.1
        self.Wc_   = np.random.randn(self.latent, K) * 0.1
        self.bc_   = np.zeros(K)
        for _ in range(self.epochs):
            mu = _relu(X @ self.Wmu_)
            lv = _relu(X @ self.Wlog_)
            z  = mu + np.random.randn(*mu.shape) * np.exp(0.5 * lv)
            probs = _softmax(z @ self.Wc_ + self.bc_)
            ce = _ce_grad(probs, y_, K)
            self.Wc_ -= self.lr * z.T @ ce; self.bc_ -= self.lr * ce.mean(0)
            dmu = (ce @ self.Wc_.T) * (mu > 0)
            self.Wmu_ -= self.lr * X.T @ dmu / len(X)
        self.is_fitted = True; return self
    def predict(self, X):
        mu = _relu(X @ self.Wmu_)
        return np.argmax(mu @ self.Wc_ + self.bc_, axis=1).astype(float)


@registry.register
class BC_E93_HybridLSTMLR(BaseAlgorithm):
    """E93 — Hybrid LSTM + Logistic Regression head."""
    name = "BC E93 LSTM+LR Head"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "LSTM hidden states used as features for logistic regression"
    def __init__(self, hidden=12, epochs=20):
        super().__init__(hidden=hidden, epochs=epochs)
        self.lstm = BC_E83_LSTM(hidden=hidden, epochs=epochs)
        self.lr   = LogisticRegression(max_iter=300, solver="lbfgs")
    def _transform(self, X):
        ht, ct = np.zeros(self.lstm.hidden), np.zeros(self.lstm.hidden)
        out = []
        for t in range(len(X)):
            c = np.concatenate([X[t], ht])
            f = _sigmoid(c @ self.lstm.Wf + self.lstm.bf)
            i = _sigmoid(c @ self.lstm.Wi + self.lstm.bi)
            ct_ = np.tanh(c @ self.lstm.Wc + self.lstm.bc)
            ct = f * ct + i * ct_
            o = _sigmoid(c @ self.lstm.Wo + self.lstm.bo)
            ht = o * np.tanh(ct)
            out.append(ht.copy())
        return np.array(out)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.lstm.fit(X, y_)
        self.lr.fit(self._transform(X), y_)
        self.is_fitted = True; return self
    def predict(self, X):
        return self.lr.predict(self._transform(X)).astype(float)


@registry.register
class BC_E94_SelfAttentionMLP(BaseAlgorithm):
    """E94 — Self-Attention + MLP classifier."""
    name = "BC E94 Attention+MLP"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "Attention-weighted features then MLP for behaviour"
    def __init__(self, d_model=8, hidden=32, epochs=50):
        super().__init__(d_model=d_model, hidden=hidden, epochs=epochs)
        self.attn = BC_E88_Transformer(d_model=d_model, epochs=1)
        self.mlp  = BC_E81_MLP(h=hidden, epochs=epochs)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.attn.fit(X, y_)
        self.mlp.fit(self.attn._attend(X), y_)
        self.is_fitted = True; return self
    def predict(self, X):
        return self.mlp.predict(self.attn._attend(X))


@registry.register
class BC_E95_EnsembleDeep(BaseAlgorithm):
    """E95 — Ensemble of LSTM + GRU + MLP (majority vote)."""
    name = "BC E95 Deep Ensemble"
    service_id = 6; category = "E_deep"; library = "numpy"; animals = ["all"]
    description = "Majority vote of LSTM, GRU, and MLP for robust behaviour"
    def __init__(self, hidden=12, epochs=20):
        super().__init__(hidden=hidden, epochs=epochs)
        self.lstm = BC_E83_LSTM(hidden=hidden, epochs=epochs)
        self.gru  = BC_E85_GRU(hidden=hidden, epochs=epochs)
        self.mlp  = BC_E81_MLP(h=hidden * 4, epochs=epochs * 3)
    def fit(self, X, y=None):
        y_ = _y(y, len(X))
        self.lstm.fit(X, y_); self.gru.fit(X, y_); self.mlp.fit(X, y_)
        self.is_fitted = True; return self
    def predict(self, X):
        pl = self.lstm.predict(X).astype(int)
        pg = self.gru.predict(X).astype(int)
        pm = self.mlp.predict(X).astype(int)
        votes = np.stack([pl, pg, pm], axis=1)
        return np.apply_along_axis(
            lambda r: np.bincount(r).argmax(), 1, votes).astype(float)


