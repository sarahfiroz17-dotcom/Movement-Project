@registry.register
class EnvTerrainRuggedness(BaseAlgorithm):
    """Terrain Ruggedness Index from altitude gradient variance."""
    name        = "Env Terrain Ruggedness Index"
    service_id  = 3
    category    = "feature_engineering"
    library     = "numpy"
    animals     = ["all"]
    description = "TRI: local altitude variability as terrain ruggedness proxy"

    def __init__(self, window: int = 5):
        super().__init__(window=window)
        self.window = window

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        alt = X[:, 1]
        tri = np.array([
            np.std(alt[max(0, i - self.window): min(len(alt), i + self.window + 1)])
            for i in range(len(alt))
        ])
        return tri.astype(float)


@registry.register
class EnvNDVIProxy(BaseAlgorithm):
    """NDVI proxy: speed-turn interaction as vegetation friction estimate."""
    name        = "Env NDVI Proxy"
    service_id  = 3
    category    = "feature_engineering"
    library     = "numpy"
    animals     = ["all"]
    description = "NDVI proxy: low speed + high turn = dense vegetation"

    def __init__(self):
        super().__init__()

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        speed = X[:, 0]
        turn  = X[:, 2]
        ndvi  = (1 / (speed + 1)) * (turn / (turn.max() + 1e-9))
        return ndvi.astype(float)


