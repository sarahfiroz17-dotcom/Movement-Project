@registry.register
class EnvResourceSelectionFunction(BaseAlgorithm):
    """RSF: probability of habitat use relative to availability."""
    name        = "Env Resource Selection Function"
    service_id  = 3
    category    = "ecological"
    library     = "sklearn"
    animals     = ["all"]
    description = "Logistic RSF: which environmental conditions animals prefer"

    def __init__(self):
        super().__init__()
        from sklearn.linear_model import LogisticRegression
        self.model = LogisticRegression(max_iter=500)

    def fit(self, X, y=None):
        from sklearn.linear_model import LogisticRegression
        E = _env_features(X)
        # Label high-speed points as "used", low-speed as "available"
        used = (X[:, 0] > np.percentile(X[:, 0], 50)).astype(int)
        self.model.fit(E, used)
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict_proba(_env_features(X))[:, 1].astype(float)


@registry.register
class EnvStepSelectionFunction(BaseAlgorithm):
    """SSF: conditional logistic for step-level habitat selection."""
    name        = "Env Step Selection Function"
    service_id  = 3
    category    = "ecological"
    library     = "sklearn"
    animals     = ["all"]
    description = "SSF models habitat selection at each movement step"

    def __init__(self):
        super().__init__()
        self.model = Ridge(alpha=1.0)

    def fit(self, X, y=None):
        E = _env_features(X)
        # Relative selection: actual step vs previous step
        target = X[:, 6]  # step_length_m
        self.model.fit(E, target)
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict(_env_features(X)).astype(float)


@registry.register
class EnvMaxEntProxy(BaseAlgorithm):
    """MaxEnt proxy: maximum entropy habitat suitability model."""
    name        = "Env MaxEnt Proxy"
    service_id  = 3
    category    = "ecological"
    library     = "numpy"
    animals     = ["all"]
    description = "MaxEnt-inspired softmax suitability from environmental features"

    def __init__(self, n_components: int = 4):
        super().__init__(n_components=n_components)
        self.pca = PCA(n_components=n_components)
        self.lambdas_ = None

    def fit(self, X, y=None):
        E = _env_features(X)
        Z = self.pca.fit_transform(E)
        # Lambdas estimated from mean of used locations (high speed)
        used = X[:, 0] > np.percentile(X[:, 0], 50)
        self.lambdas_ = Z[used].mean(axis=0)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        Z = self.pca.transform(E)
        # Softmax-based suitability
        scores = Z @ self.lambdas_
        return (np.exp(scores) / (np.exp(scores).sum() + 1e-9)).astype(float)


@registry.register
class EnvHabitatSuitabilityIndex(BaseAlgorithm):
    """Habitat Suitability Index: expert-rule weighted environmental score."""
    name        = "Env Habitat Suitability Index"
    service_id  = 3
    category    = "ecological"
    library     = "numpy"
    animals     = ["all"]
    description = "HSI combines NDVI, terrain and water proximity into a score"

    def __init__(self):
        super().__init__()

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        ndvi    = (E[:, 2] - E[:, 2].min()) / (np.ptp(E[:, 2]) + 1e-9)
        terrain = 1 - (E[:, 0] - E[:, 0].min()) / (np.ptp(E[:, 0]) + 1e-9)
        water   = (E[:, 6] - E[:, 6].min()) / (np.ptp(E[:, 6]) + 1e-9)
        hsi = 0.4 * ndvi + 0.3 * terrain + 0.3 * water
        return hsi.astype(float)


@registry.register
class EnvEcologicalNicheModel(BaseAlgorithm):
    """Ecological niche model: bioclimate envelope from movement altitude proxy."""
    name        = "Env Ecological Niche Model"
    service_id  = 3
    category    = "ecological"
    library     = "sklearn"
    animals     = ["all"]
    description = "Mahalanobis-distance niche model from environmental centroids"

    def __init__(self):
        super().__init__()
        self.centroid_ = None
        self.cov_inv_  = None

    def fit(self, X, y=None):
        E = _env_features(X)
        self.centroid_ = E.mean(axis=0)
        cov = np.cov(E.T) + np.eye(E.shape[1]) * 1e-6
        self.cov_inv_ = np.linalg.inv(cov)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        diffs = E - self.centroid_
        dists = np.array([d @ self.cov_inv_ @ d for d in diffs])
        suitability = np.exp(-0.5 * dists)
        return suitability.astype(float)


@registry.register
class EnvBioclimaticEnvelope(BaseAlgorithm):
    """Bioclimatic envelope: min/max altitude bounding box habitat model."""
    name        = "Env Bioclimatic Envelope"
    service_id  = 3
    category    = "ecological"
    library     = "numpy"
    animals     = ["all"]
    description = "BIOCLIM-style bounding envelope for environmental tolerance"

    def __init__(self, percentile: float = 5.0):
        super().__init__(percentile=percentile)
        self.p = percentile

    def fit(self, X, y=None):
        E = _env_features(X)
        self.lower_ = np.percentile(E, self.p, axis=0)
        self.upper_ = np.percentile(E, 100 - self.p, axis=0)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        in_envelope = np.all((E >= self.lower_) & (E <= self.upper_), axis=1)
        return in_envelope.astype(float)


@registry.register
class EnvSDMRandomForest(BaseAlgorithm):
    """Species Distribution Model using Random Forest on environmental features."""
    name        = "Env SDM Random Forest"
    service_id  = 3
    category    = "ecological"
    library     = "sklearn"
    animals     = ["all"]
