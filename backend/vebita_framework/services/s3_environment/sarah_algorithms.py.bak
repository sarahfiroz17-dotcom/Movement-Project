        super().__init__(threshold_percentile=threshold_percentile)
        self.threshold_percentile = threshold_percentile
        self.threshold_ = None

    def fit(self, X, y=None):
        self.threshold_ = np.percentile(X[:, 2], self.threshold_percentile)
        self.is_fitted = True
