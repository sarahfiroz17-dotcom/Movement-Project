@registry.register
class EnvMixedEffectsProxy(BaseAlgorithm):
    """Mixed effects proxy: per-cluster intercept + environmental slope."""
    name        = "Env Mixed Effects Proxy"
    service_id  = 3
    category    = "statistical"
    library     = "sklearn"
    animals     = ["all"]
    description = "Group-level intercepts (land cover) + fixed environmental slopes"

    def __init__(self, n_groups: int = 4):
        super().__init__(n_groups=n_groups)
        self.n_groups = n_groups
        self.models = {}
        self.km = KMeans(n_clusters=n_groups, random_state=42, n_init=5)

    def fit(self, X, y=None):
        E = _env_features(X)
        groups = self.km.fit_predict(E)
        for g in range(self.n_groups):
            idx = groups == g
            if idx.sum() > 5:
                m = Ridge(alpha=1.0)
                m.fit(E[idx], X[idx, 0])
                self.models[g] = m
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        groups = self.km.predict(E)
        out = np.zeros(len(X))
        for g, m in self.models.items():
            idx = groups == g
            if idx.sum() > 0:
                out[idx] = m.predict(E[idx])
        return out.astype(float)


@registry.register
class EnvRobustRegression(BaseAlgorithm):
    """Robust regression using minimum covariance determinant outlier trim."""
    name        = "Env Robust Regression (MCD)"
    service_id  = 3
    category    = "statistical"
    library     = "sklearn"
    animals     = ["all"]
    description = "MCD-based outlier removal then linear regression on environment"

    def __init__(self):
        super().__init__()
        self.model = LinearRegression()
        self.mcd = None

    def fit(self, X, y=None):
        E = _env_features(X)
        try:
            mcd = MinCovDet(random_state=42).fit(E)
            distances = mcd.mahalanobis(E)
            threshold = np.percentile(distances, 90)
            mask = distances < threshold
            self.model.fit(E[mask], X[mask, 0])
        except Exception:
            self.model.fit(E, X[:, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict(_env_features(X)).astype(float)


