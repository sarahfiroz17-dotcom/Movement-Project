@registry.register
class EnvWeatherFeatureDerivation(BaseAlgorithm):
    """Weather proxy: speed variance as wind gust surrogate."""
    name        = "Env Weather Feature Derivation"
    service_id  = 3
    category    = "feature_engineering"
    library     = "numpy"
    animals     = ["all"]
    description = "Speed roll-std as wind proxy; temperature from altitude lapse rate"

    def __init__(self, lapse_rate: float = 6.5):
        super().__init__(lapse_rate=lapse_rate)
        self.lapse_rate = lapse_rate

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        wind_proxy = X[:, 5]  # speed_roll_std
        temp_proxy = 15 - self.lapse_rate * X[:, 1] / 1000  # lapse-rate T
        return (wind_proxy + temp_proxy / 30).astype(float)  # combined score


@registry.register
class EnvFractalDimension(BaseAlgorithm):
    """Fractal dimension of altitude series — environmental complexity."""
    name        = "Env Fractal Dimension"
    service_id  = 3
    category    = "feature_engineering"
    library     = "numpy"
    animals     = ["all"]
    description = "Local Higuchi fractal dimension of altitude time series"

    def __init__(self, window: int = 20, k_max: int = 4):
        super().__init__(window=window, k_max=k_max)
        self.window = window
        self.k_max = k_max

    def _higuchi_fd(self, x):
        n = len(x)
        if n < 4:
            return 1.5
        lk = []
        for k in range(1, self.k_max + 1):
            lengths = []
            for m in range(1, k + 1):
                idx = np.arange(m - 1, n, k)
                if len(idx) < 2:
                    continue
                vals = x[idx]
                lm = (np.sum(np.abs(np.diff(vals))) * (n - 1) / (k * len(vals))) / k
                lengths.append(lm)
            if lengths:
                lk.append(np.mean(lengths))
        if len(lk) < 2:
            return 1.5
        log_k = np.log(np.arange(1, len(lk) + 1))
        log_l = np.log(np.array(lk) + 1e-9)
        slope = np.polyfit(log_k, log_l, 1)[0]
        return abs(slope)

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        alt = X[:, 1]
        n = len(alt)
        w = self.window
        fd = np.zeros(n)
        for i in range(n):
            seg = alt[max(0, i - w): min(n, i + w + 1)]
            fd[i] = self._higuchi_fd(seg)
        return fd.astype(float)


@registry.register
class EnvHabitatBoundaryDetector(BaseAlgorithm):
    """Habitat boundary: abrupt turning-angle spikes signal edge crossings."""
    name        = "Env Habitat Boundary Detector"
    service_id  = 3
