# ═══════════════════════════════════════════════════════════════════════════════
# HELPER: synthetic environmental features derived from movement data
# In real Movebank use, these would come from raster layers (GEE, ERA5, SRTM).
# Here we derive proxies from the 8 movement features.
# ═══════════════════════════════════════════════════════════════════════════════

def _env_features(X: np.ndarray) -> np.ndarray:
    """
    Derive 12 synthetic environmental proxy features from movement features.
    Columns returned:
        0  terrain_ruggedness  (alt variability proxy)
        1  slope               (alt gradient)
        2  ndvi_proxy          (speed × turning, vegetation friction)
        3  land_cover          (cluster ID from altitude + speed)
        4  wind_proxy          (speed_roll_std — gust proxy)
        5  temperature_proxy   (−altitude, lapse-rate proxy)
        6  proximity_water     (low speed + low alt proxy)
        7  solar_radiation     (straightness × speed)
        8  resource_score      (1 / (turning_angle + 1))
        9  elevation_gradient  (alt_roll_mean gradient)
       10  habitat_boundary    (turning_angle spike)
       11  energy_expenditure  (speed² proxy)
    """
    speed       = X[:, 0]   # speed_ms
    alt         = X[:, 1]   # altitude_m
    turn        = X[:, 2]   # turning_angle
    straight    = X[:, 3]   # straightness
    spd_mean    = X[:, 4]   # speed_roll_mean
    spd_std     = X[:, 5]   # speed_roll_std
    step        = X[:, 6]   # step_length_m
    alt_mean    = X[:, 7]   # alt_roll_mean

    n = len(X)
    terrain_rug     = np.abs(np.gradient(alt))
    slope           = np.gradient(alt_mean)
    ndvi_proxy      = speed * (1 / (turn + 1))
    land_cover      = np.round(alt_mean / (alt_mean.max() + 1e-6) * 4).astype(float)
    wind_proxy      = spd_std
    temp_proxy      = -alt / (alt.max() + 1e-6)
    prox_water      = ((speed < np.percentile(speed, 25)) & (alt < np.percentile(alt, 25))).astype(float)
    solar           = straight * spd_mean
    resource        = 1 / (turn + 1)
    elev_grad       = np.gradient(alt)
    hab_boundary    = (turn > np.percentile(turn, 90)).astype(float)
    energy          = speed ** 2

    return np.column_stack([
        terrain_rug, slope, ndvi_proxy, land_cover,
        wind_proxy, temp_proxy, prox_water, solar,
        resource, elev_grad, hab_boundary, energy,
    ])


