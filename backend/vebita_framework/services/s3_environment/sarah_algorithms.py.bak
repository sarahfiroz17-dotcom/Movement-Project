@registry.register
class EnvARModel(BaseAlgorithm):
    """Autoregressive model: past speeds predict current environmental state."""
    name        = "Env AR Model"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "AR(p) model of speed as environmental-time proxy"

    def __init__(self, p: int = 5):
        super().__init__(p=p)
        self.p = p
        self.coefs_ = None
        self.intercept_ = 0.0

    def fit(self, X, y=None):
        s = X[:, 0]
        rows = np.array([s[i:i + self.p] for i in range(len(s) - self.p)])
        targets = s[self.p:]
        m = LinearRegression()
        m.fit(rows, targets)
        self.coefs_ = m.coef_
        self.intercept_ = m.intercept_
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 0]
        out = np.full(len(s), np.mean(s))
        for i in range(self.p, len(s)):
            window = s[i - self.p: i]
            out[i] = np.dot(self.coefs_, window) + self.intercept_
        return out.astype(float)


@registry.register
class EnvMovingAverage(BaseAlgorithm):
    """Moving average smoother for environmental influence detection."""
    name        = "Env Moving Average"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "Rolling mean isolates smooth environmental signal from noise"

    def __init__(self, window: int = 10):
        super().__init__(window=window)
        self.window = window

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 0]
        return np.convolve(s, np.ones(self.window) / self.window, mode="same").astype(float)


@registry.register
class EnvExponentialSmoothing(BaseAlgorithm):
    """Exponential smoothing — downweights distant environmental history."""
    name        = "Env Exponential Smoothing"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "EWMA of altitude as temperature/pressure proxy over time"

    def __init__(self, alpha: float = 0.2):
        super().__init__(alpha=alpha)
        self.alpha = alpha

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 1]  # altitude
        out = np.zeros(len(s))
        out[0] = s[0]
        for i in range(1, len(s)):
            out[i] = self.alpha * s[i] + (1 - self.alpha) * out[i - 1]
        return out.astype(float)


@registry.register
class EnvKalmanFilter(BaseAlgorithm):
    """Kalman filter — optimal state estimation of environmental trajectory."""
    name        = "Env Kalman Filter"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "1D Kalman filter smoothing altitude/temperature state"

    def __init__(self, process_noise: float = 1e-3, obs_noise: float = 0.1):
        super().__init__(process_noise=process_noise, obs_noise=obs_noise)
        self.Q = process_noise
        self.R = obs_noise

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        z = X[:, 1]  # altitude
        n = len(z)
        x_est = np.zeros(n)
        P = 1.0
        x_est[0] = z[0]
        for i in range(1, n):
            x_pred = x_est[i - 1]
            P_pred = P + self.Q
            K = P_pred / (P_pred + self.R)
            x_est[i] = x_pred + K * (z[i] - x_pred)
            P = (1 - K) * P_pred
        return x_est.astype(float)


@registry.register
class EnvHMMEnvironmental(BaseAlgorithm):
    """HMM over environmental bins — infers latent habitat states."""
    name        = "Env Hidden Markov Model"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "2-state HMM over altitude bins: low vs high environment"

    def __init__(self, n_states: int = 2):
        super().__init__(n_states=n_states)
        self.n_states = n_states
        self.means_ = None

    def fit(self, X, y=None):
        alt = X[:, 1]
        percentiles = np.linspace(0, 100, self.n_states + 1)
        self.boundaries = np.percentile(alt, percentiles)
        self.means_ = np.array([
            np.mean(alt[(alt >= self.boundaries[i]) & (alt < self.boundaries[i + 1])])
            for i in range(self.n_states)
        ])
        self.is_fitted = True
        return self

    def predict(self, X):
        alt = X[:, 1]
        states = np.zeros(len(alt), dtype=int)
        for i in range(self.n_states):
            mask = (alt >= self.boundaries[i]) & (alt < self.boundaries[i + 1])
            states[mask] = i
        return states.astype(float)


@registry.register
class EnvCrossCorrelation(BaseAlgorithm):
    """Cross-correlation: lag between altitude and speed responses."""
    name        = "Env Cross Correlation"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "Finds time lag between environmental change and speed response"

    def __init__(self, max_lag: int = 20):
        super().__init__(max_lag=max_lag)
        self.max_lag = max_lag
        self.lag_ = 0

    def fit(self, X, y=None):
        speed = X[:, 0] - X[:, 0].mean()
        alt   = X[:, 1] - X[:, 1].mean()
        xcorr = np.correlate(speed, alt, mode="full")
        lags  = np.arange(-len(speed) + 1, len(speed))
        mask  = np.abs(lags) <= self.max_lag
        self.lag_ = lags[mask][np.argmax(np.abs(xcorr[mask]))]
        self.is_fitted = True
        return self

    def predict(self, X):
        shift = int(self.lag_)
        shifted = np.roll(X[:, 1], -shift)
        return shifted.astype(float)


@registry.register
class EnvSeasonalDecomposition(BaseAlgorithm):
    """Seasonal decomposition: extract daily/periodic environmental signal."""
    name        = "Env Seasonal Decomposition"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "Decomposes movement speed into trend + seasonal + residual"

    def __init__(self, period: int = 48):
        super().__init__(period=period)
        self.period = period
        self.seasonal_ = None

    def fit(self, X, y=None):
        s = X[:, 0]
        n = len(s)
        trend = np.convolve(s, np.ones(self.period) / self.period, mode="same")
        detrended = s - trend
        self.seasonal_ = np.array([
            np.mean(detrended[i::self.period]) for i in range(self.period)
        ])
        self.is_fitted = True
        return self

    def predict(self, X):
        n = len(X)
        seasonal = np.array([self.seasonal_[i % self.period] for i in range(n)])
        return seasonal.astype(float)


@registry.register
class EnvFourierTransform(BaseAlgorithm):
    """Fourier transform: frequency content of environmental influence."""
    name        = "Env Fourier Transform"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "FFT extracts dominant frequencies in altitude-speed coupling"

    def __init__(self, n_harmonics: int = 5):
        super().__init__(n_harmonics=n_harmonics)
        self.n_harmonics = n_harmonics
        self.freqs_ = None
        self.amps_  = None

    def fit(self, X, y=None):
        s = X[:, 0]
        fft = np.fft.rfft(s)
        self.amps_  = np.abs(fft)
        self.freqs_ = np.fft.rfftfreq(len(s))
        top_idx = np.argsort(self.amps_)[-self.n_harmonics:]
        mask = np.zeros_like(fft)
        mask[top_idx] = fft[top_idx]
        self.filtered_ = np.fft.irfft(mask, n=len(s))
        self.is_fitted = True
        return self

    def predict(self, X):
        # Return the harmonic reconstruction
        if len(X) == len(self.filtered_):
            return self.filtered_.astype(float)
        s = X[:, 0]
        fft = np.fft.rfft(s)
        amps = np.abs(fft)
        top_idx = np.argsort(amps)[-self.n_harmonics:]
        mask = np.zeros_like(fft)
        mask[top_idx] = fft[top_idx]
        return np.fft.irfft(mask, n=len(s)).astype(float)


@registry.register
class EnvWaveletTransform(BaseAlgorithm):
    """Wavelet-based multi-scale environmental analysis."""
    name        = "Env Wavelet Analysis"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "Multi-resolution decomposition of environmental-movement signal"

    def __init__(self, level: int = 3):
        super().__init__(level=level)
        self.level = level

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 0].copy()
        result = np.zeros_like(s)
        # Haar DWT approximation
        for _ in range(self.level):
            n = len(s) // 2 * 2
            approx = (s[:n:2] + s[1:n:2]) / np.sqrt(2)
            detail = (s[:n:2] - s[1:n:2]) / np.sqrt(2)
            result[:len(approx)] += approx
            s = approx
        return result[:len(X)].astype(float)


@registry.register
class EnvGrangerCausality(BaseAlgorithm):
    """Granger causality proxy: does altitude predict future speed?"""
    name        = "Env Granger Causality Proxy"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "Granger-style test: altitude lag improves speed prediction"

    def __init__(self, lag: int = 5):
        super().__init__(lag=lag)
        self.lag = lag
        self.model_full = LinearRegression()
        self.model_restricted = LinearRegression()

    def fit(self, X, y=None):
        n = len(X)
        speed = X[:, 0]
        alt   = X[:, 1]
        # Restricted: speed only
        Xr = np.column_stack([speed[i:n - self.lag + i] for i in range(self.lag)])
        yr = speed[self.lag:]
        self.model_restricted.fit(Xr, yr)
        # Full: speed + lagged altitude
        Xf = np.column_stack([
            speed[i:n - self.lag + i] for i in range(self.lag)
        ] + [alt[i:n - self.lag + i] for i in range(self.lag)])
        self.model_full.fit(Xf, yr)
        self.is_fitted = True
        return self

    def predict(self, X):
        n = len(X)
        speed = X[:, 0]
        alt   = X[:, 1]
        out = np.zeros(n)
        Xf = np.column_stack([
            speed[i:n - self.lag + i] for i in range(self.lag)
        ] + [alt[i:n - self.lag + i] for i in range(self.lag)])
        out[self.lag:] = self.model_full.predict(Xf)
        return out.astype(float)


@registry.register
class EnvDTWAlignment(BaseAlgorithm):
    """DTW-based environmental profile matching across animal tracks."""
    name        = "Env DTW Alignment"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "Dynamic time warping aligns altitude profiles for comparison"

    def __init__(self):
        super().__init__()
        self.reference_ = None

    def fit(self, X, y=None):
        self.reference_ = X[:, 1].copy()  # altitude reference
        self.is_fitted = True
        return self

    def predict(self, X):
        query = X[:, 1]
        ref = self.reference_
        n, m = len(query), len(ref)
        # Compute DTW cost matrix
        D = np.full((n + 1, m + 1), np.inf)
        D[0, 0] = 0
        for i in range(1, n + 1):
            for j in range(max(1, i - 5), min(m + 1, i + 5)):
                cost = abs(query[i - 1] - ref[j - 1])
                D[i, j] = cost + min(D[i-1, j], D[i, j-1], D[i-1, j-1])
        # Return similarity score per point (approximation)
        sim = np.abs(query - np.interp(
            np.linspace(0, 1, n),
            np.linspace(0, 1, m),
            ref
        ))
        return sim.astype(float)


@registry.register
class EnvAutocorrelation(BaseAlgorithm):
    """Autocorrelation analysis of environmental time series."""
    name        = "Env Autocorrelation Analysis"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "ACF of altitude series reveals environmental persistence"

    def __init__(self, max_lag: int = 30):
        super().__init__(max_lag=max_lag)
        self.max_lag = max_lag
        self.acf_ = None

    def fit(self, X, y=None):
        s = X[:, 1] - X[:, 1].mean()
        var = np.var(s)
        self.acf_ = np.array([np.mean(s[i:] * s[:len(s) - i]) / (var + 1e-9)
                               for i in range(self.max_lag + 1)])
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 1]
        n = len(s)
        lag = int(np.argmax(np.abs(self.acf_[1:])) + 1)
        lag = min(lag, n - 1)
        return np.roll(s, lag).astype(float)


@registry.register
class EnvStateSpaceModel(BaseAlgorithm):
    """Simple state-space model: hidden environmental state drives speed."""
    name        = "Env State Space Model"
    service_id  = 3
    category    = "time_series"
    library     = "numpy"
    animals     = ["all"]
    description = "Linear Gaussian state-space model for environmental state"

    def __init__(self, process_var: float = 0.5, obs_var: float = 1.0):
        super().__init__(process_var=process_var, obs_var=obs_var)
        self.Q = process_var
        self.R = obs_var

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        obs = X[:, 0]
        n = len(obs)
        state = np.zeros(n)
        state[0] = obs[0]
        P = 1.0
        for i in range(1, n):
            P_pred = P + self.Q
            K = P_pred / (P_pred + self.R)
            state[i] = state[i - 1] + K * (obs[i] - state[i - 1])
            P = (1 - K) * P_pred
        return state.astype(float)


@registry.register
class EnvSavitzkyGolayFilter(BaseAlgorithm):
    """Savitzky-Golay smoothing — preserves environmental extremes."""
    name        = "Env Savitzky-Golay Filter"
    service_id  = 3
    category    = "time_series"
    library     = "scipy"
    animals     = ["all"]
    description = "Polynomial smoothing of altitude signal preserving peaks"

    def __init__(self, window_length: int = 11, polyorder: int = 3):
        super().__init__(window_length=window_length, polyorder=polyorder)
        self.window_length = window_length
        self.polyorder = polyorder

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 1]
        wl = min(self.window_length, len(s) if len(s) % 2 == 1 else len(s) - 1)
        wl = max(wl, self.polyorder + 2)
        if wl % 2 == 0:
            wl -= 1
        return savgol_filter(s, window_length=wl, polyorder=self.polyorder).astype(float)


@registry.register
class EnvPeriodogramAnalysis(BaseAlgorithm):
    """Periodogram: dominant environmental cycles in movement data."""
    name        = "Env Periodogram Analysis"
    service_id  = 3
    category    = "time_series"
    library     = "scipy"
    animals     = ["all"]
    description = "Power spectral density of altitude for cycle detection"

    def __init__(self):
        super().__init__()
        self.dominant_freq_ = None

    def fit(self, X, y=None):
        f, Pxx = periodogram(X[:, 1])
        self.dominant_freq_ = f[np.argmax(Pxx[1:]) + 1]
        self.is_fitted = True
        return self

    def predict(self, X):
        n = len(X)
        t = np.arange(n)
        return np.sin(2 * np.pi * self.dominant_freq_ * t).astype(float)


