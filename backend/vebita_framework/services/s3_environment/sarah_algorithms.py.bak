@registry.register
class EnvSpectralClusteringEnv(BaseAlgorithm):
    """Spectral clustering in environmental similarity graph."""
    name        = "Env Spectral Clustering"
    service_id  = 3
    category    = "unsupervised"
    library     = "sklearn"
    animals     = ["all"]
    description = "Graph-based spectral clustering of environmental affinity matrix"

    def __init__(self, n_clusters: int = 4):
        super().__init__(n_clusters=n_clusters)
        self.model = SpectralClustering(n_clusters=n_clusters, random_state=42, affinity="rbf")
        self.km_fallback = KMeans(n_clusters=n_clusters, random_state=42, n_init=5)

    def fit(self, X, y=None):
        E = _env_features(X)
        self.labels_ = self.model.fit_predict(E)
        self.cluster_centers_ = np.array([E[self.labels_ == k].mean(axis=0)
                                           for k in range(self.model.n_clusters)
                                           if (self.labels_ == k).any()])
        self.E_train_ = E
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        if len(E) == len(self.E_train_):
            return self.labels_.astype(float)
        D = cdist(E, self.cluster_centers_)
        return D.argmin(axis=1).astype(float)


@registry.register
class EnvSOMEnv(BaseAlgorithm):
    """Self-Organising Map: 2D environmental topology learning."""
    name        = "Env Self-Organising Map"
    service_id  = 3
    category    = "unsupervised"
    library     = "numpy"
    animals     = ["all"]
    description = "SOM preserves topological structure of environmental space"

    def __init__(self, n_units: int = 8, epochs: int = 200, lr: float = 0.5):
        super().__init__(n_units=n_units, epochs=epochs, lr=lr)
        self.n_units = n_units
        self.epochs = epochs
        self.lr = lr

    def fit(self, X, y=None):
        E = _env_features(X)
        n_in = E.shape[1]
        np.random.seed(42)
        self.weights_ = np.random.randn(self.n_units, n_in)
        for epoch in range(self.epochs):
            lr = self.lr * (1 - epoch / self.epochs)
            sigma = max(1, self.n_units // 2 * (1 - epoch / self.epochs))
            for x in E[np.random.choice(len(E), min(50, len(E)), replace=False)]:
                dists = np.linalg.norm(self.weights_ - x, axis=1)
                bmu = np.argmin(dists)
                hood = np.exp(-0.5 * (np.arange(self.n_units) - bmu) ** 2 / sigma ** 2)
                self.weights_ += lr * hood[:, None] * (x - self.weights_)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        return np.array([np.argmin(np.linalg.norm(self.weights_ - e, axis=1))
                         for e in E]).astype(float)


@registry.register
class EnvTSNEVisualization(BaseAlgorithm):
    """t-SNE embedding: 2D environmental feature visualization."""
    name        = "Env t-SNE Embedding"
    service_id  = 3
    category    = "unsupervised"
    library     = "sklearn"
    animals     = ["all"]
    description = "t-SNE reveals nonlinear environmental clusters in 2D"

    def __init__(self, perplexity: float = 30.0):
        super().__init__(perplexity=perplexity)
        self.perplexity = perplexity
        self.embedding_ = None

    def fit(self, X, y=None):
        E = _env_features(X)
        n = min(len(E), 500)
        perp = min(self.perplexity, n // 4)
        tsne = TSNE(n_components=2, perplexity=perp, random_state=42)
        self.embedding_ = tsne.fit_transform(E[:n])
        self.is_fitted = True
        return self

    def predict(self, X):
        n = min(len(X), len(self.embedding_))
        out = np.zeros(len(X))
        out[:n] = self.embedding_[:n, 0]
        return out.astype(float)


@registry.register
class EnvBayesianGMMEnv(BaseAlgorithm):
    """Bayesian GMM: automatic number of environmental components."""
    name        = "Env Bayesian GMM"
    service_id  = 3
    category    = "unsupervised"
    library     = "sklearn"
    animals     = ["all"]
    description = "Variational Bayesian GMM infers number of habitat components"

    def __init__(self, max_components: int = 6):
        super().__init__(max_components=max_components)
        self.model = BayesianGaussianMixture(n_components=max_components, random_state=42)

    def fit(self, X, y=None):
        self.model.fit(_env_features(X))
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict(_env_features(X)).astype(float)


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 11 — ADVANCED SPATIO-TEMPORAL  (algos 115–118)
# ═══════════════════════════════════════════════════════════════════════════════

@registry.register
class EnvSpatioTemporalKriging(BaseAlgorithm):
    """Spatio-temporal Kriging: interpolation across space and time."""
    name        = "Env Spatio-Temporal Kriging"
    service_id  = 3
    category    = "spatio_temporal"
    library     = "sklearn"
    animals     = ["all"]
    description = "GP interpolation with spatial + temporal covariance components"

    def __init__(self):
        super().__init__()
        kernel = Matern(length_scale=1.0, nu=1.5) + WhiteKernel(noise_level=0.01)
        self.gp = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=0)

    def fit(self, X, y=None):
        n = min(200, len(X))
        t = np.arange(n).reshape(-1, 1) / n  # temporal coordinate
        E = _env_features(X)[:n, :1]          # spatial proxy (terrain)
        ST = np.hstack([t, E])
        self.gp.fit(ST, X[:n, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        n = len(X)
        t = np.arange(n).reshape(-1, 1) / n
        E = _env_features(X)[:, :1]
        ST = np.hstack([t, E])
        return self.gp.predict(ST).astype(float)


@registry.register
class EnvSTCNN(BaseAlgorithm):
    """Spatio-temporal CNN: 1D conv over environmental temporal windows."""
    name        = "Env ST-CNN"
    service_id  = 3
    category    = "spatio_temporal"
    library     = "numpy"
    animals     = ["all"]
    description = "Spatio-temporal CNN: temporal convolution over env+movement"

    def __init__(self, kernel_size: int = 7, n_filters: int = 4, epochs: int = 20):
        super().__init__(kernel_size=kernel_size, n_filters=n_filters, epochs=epochs)
        self.kernel_size = kernel_size
        self.n_filters = n_filters
        self.epochs = epochs

    def _relu(self, x): return np.maximum(0, x)

    def fit(self, X, y=None):
        E = _env_features(X)
        n_channels = 2  # speed + altitude
        self.kernels = np.random.randn(self.n_filters, n_channels, self.kernel_size) * 0.1
        self.W_out = np.random.randn(self.n_filters, 1) * 0.1
        self.is_fitted = True
        return self

    def predict(self, X):
        seq = X[:, :2]  # speed, altitude
        n = len(seq)
        k = self.kernel_size
        maps = np.zeros((n, self.n_filters))
        for fi in range(self.n_filters):
            for t in range(n):
                seg = seq[max(0, t - k + 1): t + 1]  # causal window
                if len(seg) < k:
                    seg = np.pad(seg, ((k - len(seg), 0), (0, 0)), mode="edge")
                maps[t, fi] = np.sum(self.kernels[fi] * seg.T)
        return self._relu(maps @ self.W_out).ravel().astype(float)


@registry.register
class EnvRNNWithEnvInputs(BaseAlgorithm):
    """RNN conditioned on environmental feature stream alongside movement."""
    name        = "Env RNN with Env Inputs"
    service_id  = 3
    category    = "spatio_temporal"
    library     = "numpy"
    animals     = ["all"]
    description = "RNN receives both movement and environmental inputs each step"

    def __init__(self, hidden: int = 16, epochs: int = 30, lr: float = 0.005):
        super().__init__(hidden=hidden, epochs=epochs, lr=lr)
        self.hidden = hidden
        self.epochs = epochs
        self.lr = lr

    def fit(self, X, y=None):
        E = _env_features(X)
        n_in = 2 + 4  # speed, alt + 4 env features
        h = self.hidden
        self.Wx = np.random.randn(n_in, h) * 0.1
        self.Wh = np.random.randn(h, h) * 0.1
        self.Wy = np.random.randn(h, 1) * 0.1
        self.bh = np.zeros(h)
        self.by = np.zeros(1)
        seq = np.hstack([X[:, :2], E[:, :4]])
        for _ in range(self.epochs):
            ht = np.zeros(h)
            preds = []
            for t in range(len(seq)):
                ht = np.tanh(seq[t] @ self.Wx + ht @ self.Wh + self.bh)
                preds.append((ht @ self.Wy + self.by).item())
            err = np.array(preds) - X[:, 0]
            self.Wy -= self.lr * np.outer(ht, [err.mean()])
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        seq = np.hstack([X[:, :2], E[:, :4]])
        ht = np.zeros(self.hidden)
        out = []
        for t in range(len(seq)):
            ht = np.tanh(seq[t] @ self.Wx + ht @ self.Wh + self.bh)
            out.append((ht @ self.Wy + self.by).item())
        return np.array(out).astype(float)


@registry.register
class EnvSTGNN(BaseAlgorithm):
    """ST-GNN proxy: graph-structured environmental neighbourhood model."""
    name        = "Env ST-GNN Proxy"
    service_id  = 3
    category    = "spatio_temporal"
    library     = "numpy"
    animals     = ["all"]
    description = "Graph convolution over temporal neighbourhood in env feature space"

    def __init__(self, k_neighbors: int = 5, epochs: int = 30, lr: float = 0.01):
        super().__init__(k_neighbors=k_neighbors, epochs=epochs, lr=lr)
        self.k_neighbors = k_neighbors
        self.epochs = epochs
        self.lr = lr

    def _relu(self, x): return np.maximum(0, x)

    def fit(self, X, y=None):
        E = _env_features(X)
        # Build adjacency from temporal proximity (k-nearest in time)
        n = len(E)
        self.W = np.random.randn(E.shape[1], 4) * 0.1
        self.Wout = np.random.randn(4, 1) * 0.1
        target = X[:, 0]
        for _ in range(self.epochs):
            # Graph convolution: each node aggregates k temporal neighbours
            agg = np.zeros((n, E.shape[1]))
            for i in range(n):
                nb_idx = np.arange(max(0, i - self.k_neighbors),
                                    min(n, i + self.k_neighbors + 1))
                agg[i] = E[nb_idx].mean(axis=0)
            h = self._relu(agg @ self.W)
            pred = (h @ self.Wout).ravel()
            err = pred - target
            self.Wout -= self.lr * h.T @ err.reshape(-1, 1) / n
            self.W -= self.lr * agg.T @ (err.reshape(-1, 1) @ self.Wout.T * (h > 0)) / n
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        n = len(E)
        agg = np.zeros_like(E)
        for i in range(n):
            nb_idx = np.arange(max(0, i - self.k_neighbors),
                                min(n, i + self.k_neighbors + 1))
            agg[i] = E[nb_idx].mean(axis=0)
        h = self._relu(agg @ self.W)
        return (h @ self.Wout).ravel().astype(float)


