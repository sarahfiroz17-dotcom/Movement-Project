        presence = (X[:, 0] > np.percentile(X[:, 0], 40)).astype(int)
        self.model.fit(E, presence)
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict_proba(_env_features(X))[:, 1].astype(float)


