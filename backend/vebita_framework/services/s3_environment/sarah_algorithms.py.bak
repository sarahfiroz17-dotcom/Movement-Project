@registry.register
class EnvStructuralEquationModel(BaseAlgorithm):
    """SEM proxy: path coefficients for environment → movement chain."""
    name        = "Env Structural Equation Model"
    service_id  = 3
    category    = "causal"
    library     = "numpy"
    animals     = ["all"]
    description = "SEM proxy: causal path alt→ndvi→speed via chained regression"

    def __init__(self):
        super().__init__()
        self.m1 = LinearRegression()  # alt → ndvi proxy
        self.m2 = LinearRegression()  # ndvi → speed

    def fit(self, X, y=None):
        E = _env_features(X)
        ndvi = E[:, 2:3]
        self.m1.fit(X[:, 1:2], ndvi)  # alt → ndvi
        self.m2.fit(ndvi, X[:, 0])    # ndvi → speed
        self.is_fitted = True
        return self

    def predict(self, X):
        ndvi_hat = self.m1.predict(X[:, 1:2])
        return self.m2.predict(ndvi_hat).astype(float)


@registry.register
class EnvSHAPFeatureImportance(BaseAlgorithm):
    """SHAP-style permutation importance for environmental features."""
    name        = "Env SHAP Feature Importance"
    service_id  = 3
    category    = "causal"
    library     = "sklearn"
    animals     = ["all"]
    description = "Permutation importance reveals which env features drive speed"

    def __init__(self, n_estimators: int = 30):
        super().__init__(n_estimators=n_estimators)
        self.rf = RandomForestRegressor(n_estimators=n_estimators, random_state=42)
        self.importances_ = None

    def fit(self, X, y=None):
        E = _env_features(X)
        self.rf.fit(E, X[:, 0])
        self.importances_ = self.rf.feature_importances_
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        # Return weighted sum of env features by importance
        return (E * self.importances_).sum(axis=1).astype(float)


@registry.register
class EnvPartialDependencePlot(BaseAlgorithm):
    """Partial dependence: marginal effect of terrain on speed."""
    name        = "Env Partial Dependence"
    service_id  = 3
    category    = "causal"
    library     = "sklearn"
    animals     = ["all"]
    description = "Marginal effect of terrain ruggedness on movement speed"

    def __init__(self, feature_idx: int = 0):
        super().__init__(feature_idx=feature_idx)
        self.feature_idx = feature_idx
        self.model = GradientBoostingRegressor(n_estimators=50)
        self.grid_ = None
        self.pdp_  = None

    def fit(self, X, y=None):
        E = _env_features(X)
        self.model.fit(E, X[:, 0])
        self.grid_ = np.linspace(E[:, self.feature_idx].min(),
                                  E[:, self.feature_idx].max(), 20)
        pdp = []
        for val in self.grid_:
            E_mod = E.copy()
            E_mod[:, self.feature_idx] = val
            pdp.append(self.model.predict(E_mod).mean())
        self.pdp_ = np.array(pdp)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        feat_vals = E[:, self.feature_idx]
        return np.interp(feat_vals, self.grid_, self.pdp_).astype(float)


@registry.register
class EnvCausalForestProxy(BaseAlgorithm):
    """Causal forest proxy: treatment effect of high vs low altitude."""
    name        = "Env Causal Forest Proxy"
    service_id  = 3
    category    = "causal"
    library     = "sklearn"
    animals     = ["all"]
    description = "ITE estimate: speed difference due to high vs low altitude treatment"

    def __init__(self, n_estimators: int = 30):
        super().__init__(n_estimators=n_estimators)
        self.rf_treated   = RandomForestRegressor(n_estimators=n_estimators, random_state=1)
        self.rf_control   = RandomForestRegressor(n_estimators=n_estimators, random_state=2)

    def fit(self, X, y=None):
        E = _env_features(X)
        treatment = (X[:, 1] > np.median(X[:, 1])).astype(bool)
        self.rf_treated.fit(E[treatment], X[treatment, 0])
        self.rf_control.fit(E[~treatment], X[~treatment, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        ite = self.rf_treated.predict(E) - self.rf_control.predict(E)
        return ite.astype(float)


@registry.register
class EnvFeatureImportanceRankings(BaseAlgorithm):
    """Feature importance ranking across multiple environmental models."""
    name        = "Env Feature Importance Rankings"
    service_id  = 3
    category    = "causal"
    library     = "sklearn"
    animals     = ["all"]
    description = "Consensus ranking of environmental features across RF, GB, ET"

    def __init__(self):
        super().__init__()
        self.models = [
            RandomForestRegressor(n_estimators=20, random_state=0),
            GradientBoostingRegressor(n_estimators=20),
            ExtraTreesRegressor(n_estimators=20, random_state=0),
        ]
        self.consensus_importance_ = None

    def fit(self, X, y=None):
        E = _env_features(X)
        importances = []
        for m in self.models:
            m.fit(E, X[:, 0])
            importances.append(m.feature_importances_)
        self.consensus_importance_ = np.mean(importances, axis=0)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        return (E * self.consensus_importance_).sum(axis=1).astype(float)


