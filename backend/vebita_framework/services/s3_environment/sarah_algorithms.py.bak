    library     = "sklearn"
    animals     = ["all"]
    description = "CCA finds shared latent structure between environment and movement"

    def __init__(self, n_components: int = 2):
        super().__init__(n_components=n_components)
        self.cca = CCA(n_components=n_components)

    def fit(self, X, y=None):
        E = _env_features(X)
        self.cca.fit(E, X)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        Xc, _ = self.cca.transform(E, X)
        return Xc[:, 0].astype(float)


