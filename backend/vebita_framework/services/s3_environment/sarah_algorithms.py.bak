@registry.register
class EnvStackingEnsemble(BaseAlgorithm):
    """Stacking ensemble: RF + Ridge meta-learner for environmental prediction."""
    name        = "Env Stacking Ensemble"
    service_id  = 3
    category    = "ensemble"
    library     = "sklearn"
    animals     = ["all"]
    description = "Stacked generalisation combining RF and Ridge base learners"

    def __init__(self):
        super().__init__()
        self.model = StackingRegressor(
            estimators=[
                ("rf",    RandomForestRegressor(n_estimators=30, random_state=42)),
                ("ridge", Ridge(alpha=1.0)),
            ],
            final_estimator=Ridge(alpha=0.5),
            cv=3,
        )

    def fit(self, X, y=None):
        self.model.fit(_env_features(X), X[:, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict(_env_features(X)).astype(float)


@registry.register
class EnvVotingEnsemble(BaseAlgorithm):
    """Voting ensemble: averaged predictions from diverse environmental models."""
    name        = "Env Voting Ensemble"
    service_id  = 3
    category    = "ensemble"
    library     = "sklearn"
    animals     = ["all"]
    description = "Average of Ridge, KNN and Decision Tree environmental models"

    def __init__(self):
        super().__init__()
        self.model = VotingRegressor(estimators=[
            ("ridge", Ridge()),
            ("knn",   KNeighborsRegressor(n_neighbors=5)),
            ("dt",    DecisionTreeRegressor(max_depth=4, random_state=42)),
        ])

    def fit(self, X, y=None):
        self.model.fit(_env_features(X), X[:, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict(_env_features(X)).astype(float)


@registry.register
class EnvHybridDeepSpatial(BaseAlgorithm):
    """Hybrid MLP + spatial smoothing for combined env-movement modelling."""
    name        = "Env Hybrid Deep+Spatial"
    service_id  = 3
    category    = "ensemble"
    library     = "numpy"
    animals     = ["all"]
    description = "MLP predictions spatially smoothed with Gaussian kernel"

    def __init__(self, hidden: int = 32, epochs: int = 50, spatial_bw: int = 10):
        super().__init__(hidden=hidden, epochs=epochs, spatial_bw=spatial_bw)
        self.hidden = hidden
        self.epochs = epochs
        self.spatial_bw = spatial_bw

    def _relu(self, x): return np.maximum(0, x)

    def fit(self, X, y=None):
        E = _env_features(X)
        n_in = E.shape[1]
        self.W1 = np.random.randn(n_in, self.hidden) * 0.1
        self.b1 = np.zeros(self.hidden)
        self.W2 = np.random.randn(self.hidden, 1) * 0.1
        self.b2 = np.zeros(1)
        target = X[:, 0:1]
        lr = 0.01
        for _ in range(self.epochs):
            h = self._relu(E @ self.W1 + self.b1)
            pred = h @ self.W2 + self.b2
            err = pred - target
            self.W2 -= lr * h.T @ err / len(E)
            self.b2 -= lr * err.mean(axis=0)
            dh = err @ self.W2.T * (h > 0)
            self.W1 -= lr * E.T @ dh / len(E)
            self.b1 -= lr * dh.mean(axis=0)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        h = self._relu(E @ self.W1 + self.b1)
        raw = (h @ self.W2 + self.b2).ravel()
        # Spatial smoothing
        kernel = np.exp(-0.5 * (np.arange(-(self.spatial_bw), self.spatial_bw + 1) / (self.spatial_bw / 2)) ** 2)
        kernel /= kernel.sum()
        return np.convolve(raw, kernel, mode="same").astype(float)


@registry.register
class EnvModelAveraging(BaseAlgorithm):
    """Model averaging with AIC-based weights for environmental models."""
    name        = "Env Model Averaging (AIC)"
    service_id  = 3
    category    = "ensemble"
    library     = "sklearn"
    animals     = ["all"]
    description = "AIC-weighted average of linear, polynomial and ridge models"

    def __init__(self):
        super().__init__()
        self.models = [
            LinearRegression(),
            Ridge(alpha=1.0),
            Ridge(alpha=10.0),
        ]
        self.weights_ = None

    def fit(self, X, y=None):
        E = _env_features(X)
        target = X[:, 0]
        aics = []
        for m in self.models:
            m.fit(E, target)
            resid = target - m.predict(E)
            sse = np.sum(resid ** 2)
            n = len(target)
            k = E.shape[1] + 1
            aic = n * np.log(sse / n + 1e-9) + 2 * k
            aics.append(aic)
        aics = np.array(aics)
        delta = aics - aics.min()
        w = np.exp(-0.5 * delta)
        self.weights_ = w / w.sum()
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        preds = np.stack([m.predict(E) for m in self.models], axis=1)
        return (preds @ self.weights_).astype(float)


@registry.register
class EnvRandomSubspaceEnsemble(BaseAlgorithm):
    """Random subspace ensemble: each tree uses random env feature subset."""
    name        = "Env Random Subspace Ensemble"
    service_id  = 3
    category    = "ensemble"
    library     = "sklearn"
    animals     = ["all"]
    description = "Diverse models trained on random environmental feature subsets"

    def __init__(self, n_estimators: int = 20, max_features: int = 6):
        super().__init__(n_estimators=n_estimators, max_features=max_features)
        self.n_estimators = n_estimators
        self.max_features = max_features
        self.estimators_ = []
        self.feature_sets_ = []

    def fit(self, X, y=None):
        E = _env_features(X)
        n_feat = E.shape[1]
        np.random.seed(42)
        self.estimators_ = []
        self.feature_sets_ = []
        for _ in range(self.n_estimators):
            feat_idx = np.random.choice(n_feat, min(self.max_features, n_feat), replace=False)
            m = Ridge(alpha=1.0)
            m.fit(E[:, feat_idx], X[:, 0])
            self.estimators_.append(m)
            self.feature_sets_.append(feat_idx)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        preds = np.stack([m.predict(E[:, fidx])
                          for m, fidx in zip(self.estimators_, self.feature_sets_)], axis=1)
        return preds.mean(axis=1).astype(float)


@registry.register
class EnvBlendedNeuralStatistical(BaseAlgorithm):
    """Blended Neural + Ridge: 50/50 average of deep and statistical outputs."""
    name        = "Env Blended Neural+Statistical"
    service_id  = 3
    category    = "ensemble"
    library     = "numpy"
    animals     = ["all"]
    description = "Equal blend of MLP and Ridge for stable environmental predictions"

    def __init__(self, hidden: int = 32, epochs: int = 50):
        super().__init__(hidden=hidden, epochs=epochs)
        self.hidden = hidden
        self.epochs = epochs
        self.ridge = Ridge(alpha=1.0)

    def _relu(self, x): return np.maximum(0, x)

    def fit(self, X, y=None):
        E = _env_features(X)
        self.ridge.fit(E, X[:, 0])
        n_in = E.shape[1]
        self.W1 = np.random.randn(n_in, self.hidden) * 0.1
        self.b1 = np.zeros(self.hidden)
        self.W2 = np.random.randn(self.hidden, 1) * 0.1
        self.b2 = np.zeros(1)
        target = X[:, 0:1]
        lr = 0.01
        for _ in range(self.epochs):
            h = self._relu(E @ self.W1 + self.b1)
            pred = h @ self.W2 + self.b2
            err = pred - target
            self.W2 -= lr * h.T @ err / len(E)
            self.b2 -= lr * err.mean(axis=0)
            dh = err @ self.W2.T * (h > 0)
            self.W1 -= lr * E.T @ dh / len(E)
            self.b1 -= lr * dh.mean(axis=0)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        ridge_pred = self.ridge.predict(E)
        h = self._relu(E @ self.W1 + self.b1)
        nn_pred = (h @ self.W2 + self.b2).ravel()
        return ((ridge_pred + nn_pred) / 2).astype(float)


@registry.register
class EnvSpatioTemporalHybrid(BaseAlgorithm):
    """Spatio-temporal hybrid: Kalman spatial smoothing + temporal RF."""
    name        = "Env Spatio-Temporal Hybrid"
    service_id  = 3
    category    = "ensemble"
    library     = "sklearn"
    animals     = ["all"]
    description = "Combines Kalman-smoothed env state with RF temporal prediction"

    def __init__(self, n_estimators: int = 50):
        super().__init__(n_estimators=n_estimators)
        self.rf = RandomForestRegressor(n_estimators=n_estimators, random_state=42)

    def _kalman(self, s, Q=1e-3, R=0.1):
        out = np.zeros(len(s))
        out[0] = s[0]
        P = 1.0
        for i in range(1, len(s)):
            P_pred = P + Q
            K = P_pred / (P_pred + R)
            out[i] = out[i-1] + K * (s[i] - out[i-1])
            P = (1-K) * P_pred
        return out

    def fit(self, X, y=None):
        alt_smooth = self._kalman(X[:, 1])
        X_aug = np.column_stack([_env_features(X), alt_smooth])
        self.rf.fit(X_aug, X[:, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        alt_smooth = self._kalman(X[:, 1])
        X_aug = np.column_stack([_env_features(X), alt_smooth])
        return self.rf.predict(X_aug).astype(float)


