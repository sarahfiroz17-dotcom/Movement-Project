@registry.register
class EnvEnergyExpenditure(BaseAlgorithm):
    """Energy expenditure proxy: speed² × terrain ruggedness."""
    name        = "Env Energy Expenditure Proxy"
    service_id  = 3
    category    = "feature_engineering"
    library     = "numpy"
    animals     = ["all"]
    description = "Mechanical energy proxy: speed² scaled by terrain cost"

    def __init__(self):
        super().__init__()

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        speed = X[:, 0]
        tri   = np.abs(np.gradient(X[:, 1]))
        energy = speed ** 2 * (1 + tri / (tri.max() + 1e-9))
        return energy.astype(float)


