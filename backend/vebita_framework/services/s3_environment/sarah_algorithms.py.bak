@registry.register
class EnvLinearRegression(BaseAlgorithm):
    """Predict animal speed from environmental proxy features via OLS."""
    name        = "Env Linear Regression"
    service_id  = 3
    category    = "statistical"
    library     = "sklearn"
    animals     = ["all"]
    description = "OLS regression: environmental proxies → movement speed"

    def __init__(self):
        super().__init__()
        self.model = LinearRegression()

    def fit(self, X, y=None):
        E = _env_features(X)
        target = X[:, 0]  # predict speed_ms
        self.model.fit(E, target)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        return self.model.predict(E).astype(float)


