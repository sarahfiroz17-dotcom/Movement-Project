@registry.register
class EnvMLPRegressor(BaseAlgorithm):
    """Multi-layer perceptron for complex environmental-movement mapping."""
    name        = "Env MLP Regressor"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "2-layer neural network: env features → movement speed"

    def __init__(self, hidden: int = 64, lr: float = 0.01, epochs: int = 200):
        super().__init__(hidden=hidden, lr=lr, epochs=epochs)
        self.hidden = hidden
        self.lr = lr
        self.epochs = epochs

    def _relu(self, x):
        return np.maximum(0, x)

    def fit(self, X, y=None):
        E = _env_features(X)
        n_in = E.shape[1]
        self.W1 = np.random.randn(n_in, self.hidden) * 0.1
        self.b1 = np.zeros(self.hidden)
        self.W2 = np.random.randn(self.hidden, 1) * 0.1
        self.b2 = np.zeros(1)
        target = X[:, 0:1]
        for _ in range(self.epochs):
            h = self._relu(E @ self.W1 + self.b1)
            pred = h @ self.W2 + self.b2
            err = pred - target
            dW2 = h.T @ err / len(E)
            db2 = err.mean(axis=0)
            dh = (err @ self.W2.T) * (h > 0)
            dW1 = E.T @ dh / len(E)
            db1 = dh.mean(axis=0)
            self.W1 -= self.lr * dW1
            self.b1 -= self.lr * db1
            self.W2 -= self.lr * dW2
            self.b2 -= self.lr * db2
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        h = self._relu(E @ self.W1 + self.b1)
        return (h @ self.W2 + self.b2).ravel().astype(float)


@registry.register
class EnvRNNRegressor(BaseAlgorithm):
    """Vanilla RNN — temporal environmental sequence modelling."""
    name        = "Env Vanilla RNN"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "Simple RNN processes sequential environmental states"

    def __init__(self, hidden: int = 16, lr: float = 0.005, epochs: int = 50):
        super().__init__(hidden=hidden, lr=lr, epochs=epochs)
        self.hidden = hidden
        self.lr = lr
        self.epochs = epochs

    def fit(self, X, y=None):
        n_in = 2  # speed, altitude
        h = self.hidden
        self.Wx = np.random.randn(n_in, h) * 0.1
        self.Wh = np.random.randn(h, h) * 0.1
        self.Wy = np.random.randn(h, 1) * 0.1
        self.bh = np.zeros(h)
        self.by = np.zeros(1)
        seq = X[:, :2]
        for _ in range(self.epochs):
            ht = np.zeros(h)
            preds, hs = [], []
            for t in range(len(seq)):
                ht = np.tanh(seq[t] @ self.Wx + ht @ self.Wh + self.bh)
                hs.append(ht.copy())
                preds.append(ht @ self.Wy + self.by)
            preds = np.array(preds).squeeze()
            err = preds - X[:, 0]
            # Simplified BPTT (last step only for speed)
            dWy = np.outer(hs[-1], err[-1:])
            self.Wy -= self.lr * dWy
            self.by -= self.lr * err.mean()
        self.is_fitted = True
        return self

    def predict(self, X):
        seq = X[:, :2]
        ht = np.zeros(self.hidden)
        out = []
        for t in range(len(seq)):
            ht = np.tanh(seq[t] @ self.Wx + ht @ self.Wh + self.bh)
            out.append((ht @ self.Wy + self.by).item())
        return np.array(out).astype(float)


@registry.register
class EnvLSTMRegressor(BaseAlgorithm):
    """LSTM for long-range environmental memory in movement sequences."""
    name        = "Env LSTM Regressor"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "LSTM captures multi-day environmental effects on movement"

    def __init__(self, hidden: int = 16, epochs: int = 30, lr: float = 0.01):
        super().__init__(hidden=hidden, epochs=epochs, lr=lr)
        self.hidden = hidden
        self.epochs = epochs
        self.lr = lr

    def _sigmoid(self, x):
        return 1 / (1 + np.exp(-np.clip(x, -10, 10)))

    def fit(self, X, y=None):
        n_in, h = 2, self.hidden
        scale = 0.1
        self.Wf = np.random.randn(n_in + h, h) * scale
        self.Wi = np.random.randn(n_in + h, h) * scale
        self.Wc = np.random.randn(n_in + h, h) * scale
        self.Wo = np.random.randn(n_in + h, h) * scale
        self.bf = np.zeros(h)
        self.bi = np.zeros(h)
        self.bc = np.zeros(h)
        self.bo = np.zeros(h)
        self.Wy = np.random.randn(h, 1) * scale
        self.by = np.zeros(1)
        for _ in range(self.epochs):
            ht = np.zeros(h)
            ct = np.zeros(h)
            preds = []
            for t in range(len(X)):
                xt = X[t, :2]
                combined = np.concatenate([xt, ht])
                f = self._sigmoid(combined @ self.Wf + self.bf)
                i = self._sigmoid(combined @ self.Wi + self.bi)
                c_tilde = np.tanh(combined @ self.Wc + self.bc)
                ct = f * ct + i * c_tilde
                o = self._sigmoid(combined @ self.Wo + self.bo)
                ht = o * np.tanh(ct)
                preds.append((ht @ self.Wy + self.by).item())
            err = np.array(preds) - X[:, 0]
            self.Wy -= self.lr * np.outer(ht, [err.mean()])
            self.by -= self.lr * err.mean()
        self.is_fitted = True
        return self

    def predict(self, X):
        ht, ct = np.zeros(self.hidden), np.zeros(self.hidden)
        out = []
        for t in range(len(X)):
            xt = X[t, :2]
            combined = np.concatenate([xt, ht])
            f = self._sigmoid(combined @ self.Wf + self.bf)
            i = self._sigmoid(combined @ self.Wi + self.bi)
            c_tilde = np.tanh(combined @ self.Wc + self.bc)
            ct = f * ct + i * c_tilde
            o = self._sigmoid(combined @ self.Wo + self.bo)
            ht = o * np.tanh(ct)
            out.append((ht @ self.Wy + self.by).item())
        return np.array(out).astype(float)


@registry.register
class EnvGRURegressor(BaseAlgorithm):
    """GRU — efficient gated recurrent unit for environmental sequences."""
    name        = "Env GRU Regressor"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "GRU with update/reset gates for environmental sequence learning"

    def __init__(self, hidden: int = 16, epochs: int = 30, lr: float = 0.01):
        super().__init__(hidden=hidden, epochs=epochs, lr=lr)
        self.hidden = hidden
        self.epochs = epochs
        self.lr = lr

    def _sigmoid(self, x):
        return 1 / (1 + np.exp(-np.clip(x, -10, 10)))

    def fit(self, X, y=None):
        n_in, h = 2, self.hidden
        s = 0.1
        self.Wz = np.random.randn(n_in + h, h) * s
        self.Wr = np.random.randn(n_in + h, h) * s
        self.Wn = np.random.randn(n_in + h, h) * s
        self.bz = np.zeros(h); self.br = np.zeros(h); self.bn = np.zeros(h)
        self.Wy = np.random.randn(h, 1) * s; self.by = np.zeros(1)
        for _ in range(self.epochs):
            ht = np.zeros(h)
            preds = []
            for t in range(len(X)):
                xt = X[t, :2]
                combined = np.concatenate([xt, ht])
                z = self._sigmoid(combined @ self.Wz + self.bz)
                r = self._sigmoid(combined @ self.Wr + self.br)
                n = np.tanh(np.concatenate([xt, r * ht]) @ self.Wn + self.bn)
                ht = (1 - z) * n + z * ht
                preds.append((ht @ self.Wy + self.by).item())
            err = np.array(preds) - X[:, 0]
            self.Wy -= self.lr * np.outer(ht, [err.mean()])
            self.by -= self.lr * err.mean()
        self.is_fitted = True
        return self

    def predict(self, X):
        ht = np.zeros(self.hidden)
        out = []
        for t in range(len(X)):
            xt = X[t, :2]
            combined = np.concatenate([xt, ht])
            z = self._sigmoid(combined @ self.Wz + self.bz)
            r = self._sigmoid(combined @ self.Wr + self.br)
            n = np.tanh(np.concatenate([xt, r * ht]) @ self.Wn + self.bn)
            ht = (1 - z) * n + z * ht
            out.append((ht @ self.Wy + self.by).item())
        return np.array(out).astype(float)


@registry.register
class EnvAutoencoderEnv(BaseAlgorithm):
    """Autoencoder: compresses environmental features to latent code."""
    name        = "Env Autoencoder"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "Autoencoder learns compact environmental state representation"

    def __init__(self, latent_dim: int = 3, epochs: int = 100, lr: float = 0.01):
        super().__init__(latent_dim=latent_dim, epochs=epochs, lr=lr)
        self.latent_dim = latent_dim
        self.epochs = epochs
        self.lr = lr

    def _relu(self, x): return np.maximum(0, x)

    def fit(self, X, y=None):
        E = _env_features(X)
        n_in = E.shape[1]
        self.We = np.random.randn(n_in, self.latent_dim) * 0.1
        self.be = np.zeros(self.latent_dim)
        self.Wd = np.random.randn(self.latent_dim, n_in) * 0.1
        self.bd = np.zeros(n_in)
        for _ in range(self.epochs):
            z = self._relu(E @ self.We + self.be)
            recon = z @ self.Wd + self.bd
            err = recon - E
            dWd = z.T @ err / len(E)
            dz = err @ self.Wd.T * (z > 0)
            dWe = E.T @ dz / len(E)
            self.We -= self.lr * dWe
            self.Wd -= self.lr * dWd
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        z = self._relu(E @ self.We + self.be)
        return z[:, 0].astype(float)


@registry.register
class EnvCNN1D(BaseAlgorithm):
    """1D CNN over sliding windows of environmental signal."""
    name        = "Env 1D CNN"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "Convolutional feature extraction from environmental time windows"

    def __init__(self, kernel_size: int = 5, n_filters: int = 8, epochs: int = 30):
        super().__init__(kernel_size=kernel_size, n_filters=n_filters, epochs=epochs)
        self.kernel_size = kernel_size
        self.n_filters = n_filters
        self.epochs = epochs

    def _relu(self, x): return np.maximum(0, x)

    def _conv1d(self, x, kernel):
        n = len(x) - len(kernel) + 1
        return np.array([np.dot(x[i:i + len(kernel)], kernel) for i in range(n)])

    def fit(self, X, y=None):
        self.kernels = np.random.randn(self.n_filters, self.kernel_size) * 0.1
        self.W_out = np.random.randn(self.n_filters, 1) * 0.1
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 1]  # altitude
        maps = np.column_stack([
            np.pad(self._relu(self._conv1d(s, k)), (0, self.kernel_size - 1), "edge")
            for k in self.kernels
        ])
        return (maps @ self.W_out).ravel().astype(float)


@registry.register
class EnvTemporalCNN(BaseAlgorithm):
    """Temporal CNN with dilated convolutions for multi-scale env patterns."""
    name        = "Env Temporal CNN (Dilated)"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "Dilated causal convolution captures multi-scale environmental cycles"

    def __init__(self, kernel_size: int = 3, dilation: int = 2):
        super().__init__(kernel_size=kernel_size, dilation=dilation)
        self.kernel_size = kernel_size
        self.dilation = dilation

    def fit(self, X, y=None):
        self.kernels = [np.random.randn(self.kernel_size) * 0.1 for _ in range(3)]
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 1].copy()
        for k in self.kernels:
            d = self.dilation
            dilated = np.array([s[max(0, i - d * j)] for i in range(len(s))
                                for j in range(self.kernel_size)]).reshape(len(s), -1)
            s = np.maximum(0, dilated @ k[:dilated.shape[1]])
        return s.astype(float)


@registry.register
class EnvAttentionMechanism(BaseAlgorithm):
    """Self-attention to weight environmental time steps by relevance."""
    name        = "Env Self-Attention"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "Scaled dot-product attention over environmental feature sequence"

    def __init__(self, d_model: int = 8):
        super().__init__(d_model=d_model)
        self.d_model = d_model

    def fit(self, X, y=None):
        n_in = 2
        self.Wq = np.random.randn(n_in, self.d_model) * 0.1
        self.Wk = np.random.randn(n_in, self.d_model) * 0.1
        self.Wv = np.random.randn(n_in, self.d_model) * 0.1
        self.Wo = np.random.randn(self.d_model, 1) * 0.1
        self.is_fitted = True
        return self

    def predict(self, X):
        seq = X[:, :2]
        Q = seq @ self.Wq
        K = seq @ self.Wk
        V = seq @ self.Wv
        scores = Q @ K.T / np.sqrt(self.d_model)
        weights = np.exp(scores - scores.max(axis=1, keepdims=True))
        weights /= weights.sum(axis=1, keepdims=True)
        attended = weights @ V
        return (attended @ self.Wo).ravel().astype(float)


@registry.register
class EnvVariationalAutoencoder(BaseAlgorithm):
    """VAE: learns probabilistic environmental latent space."""
    name        = "Env Variational Autoencoder"
    service_id  = 3
    category    = "deep_learning"
    library     = "numpy"
    animals     = ["all"]
    description = "VAE encodes environmental variability as Gaussian latent code"

    def __init__(self, latent_dim: int = 2, epochs: int = 50, lr: float = 0.01):
        super().__init__(latent_dim=latent_dim, epochs=epochs, lr=lr)
        self.latent_dim = latent_dim
        self.epochs = epochs
        self.lr = lr

    def _relu(self, x): return np.maximum(0, x)

    def fit(self, X, y=None):
        E = _env_features(X)
        n_in = E.shape[1]
        self.We_mu  = np.random.randn(n_in, self.latent_dim) * 0.1
        self.We_log = np.random.randn(n_in, self.latent_dim) * 0.1
        self.Wd     = np.random.randn(self.latent_dim, n_in) * 0.1
        for _ in range(self.epochs):
            mu = self._relu(E @ self.We_mu)
            log_var = self._relu(E @ self.We_log)
            eps = np.random.randn(*mu.shape)
            z = mu + eps * np.exp(0.5 * log_var)
            recon = z @ self.Wd
            recon_loss = np.mean((recon - E) ** 2)
            kl_loss = -0.5 * np.mean(1 + log_var - mu ** 2 - np.exp(log_var))
            grad = (recon - E) @ self.Wd.T / len(E)
            self.We_mu  -= self.lr * E.T @ (grad * (mu > 0)) / len(E)
            self.Wd     -= self.lr * z.T @ (recon - E) / len(E)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        mu = self._relu(E @ self.We_mu)
        return mu[:, 0].astype(float)


