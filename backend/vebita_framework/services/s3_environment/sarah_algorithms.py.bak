@registry.register
class EnvHierarchicalClustering(BaseAlgorithm):
    """Agglomerative clustering of environmental conditions."""
    name        = "Env Hierarchical Clustering"
    service_id  = 3
    category    = "unsupervised"
    library     = "sklearn"
    animals     = ["all"]
    description = "Ward linkage hierarchical clustering of env feature space"

    def __init__(self, n_clusters: int = 4):
        super().__init__(n_clusters=n_clusters)
        self.model = AgglomerativeClustering(n_clusters=n_clusters, linkage="ward")
        self.cluster_centers_ = None

    def fit(self, X, y=None):
        E = _env_features(X)
        labels = self.model.fit_predict(E)
        self.cluster_centers_ = np.array([E[labels == k].mean(axis=0)
                                           for k in range(self.model.n_clusters)])
        self.labels_train_ = labels
        self.E_train_ = E
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        # Assign to nearest cluster centre
        D = cdist(E, self.cluster_centers_)
        return D.argmin(axis=1).astype(float)


@registry.register
class EnvDBSCANEnv(BaseAlgorithm):
    """DBSCAN: density-based detection of environmental use clusters."""
    name        = "Env DBSCAN Clustering"
    service_id  = 3
    category    = "unsupervised"
    library     = "sklearn"
    animals     = ["all"]
    description = "DBSCAN finds arbitrary-shaped clusters in environmental space"

    def __init__(self, eps: float = 0.5, min_samples: int = 5):
        super().__init__(eps=eps, min_samples=min_samples)
        self.model = DBSCAN(eps=eps, min_samples=min_samples)

    def fit(self, X, y=None):
        E = _env_features(X)
        self.labels_ = self.model.fit_predict(E)
        self.E_train_ = E
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        if len(E) == len(self.E_train_):
            return self.labels_.astype(float)
        D = cdist(E, self.E_train_)
        nearest = D.argmin(axis=1)
        return self.labels_[nearest].astype(float)


@registry.register
class EnvHDBSCANEnv(BaseAlgorithm):
    """HDBSCAN: hierarchical density clustering for varying env densities."""
    name        = "Env HDBSCAN Clustering"
    service_id  = 3
    category    = "unsupervised"
    library     = "hdbscan"
    animals     = ["all"]
    description = "HDBSCAN adapts cluster density to environmental heterogeneity"

    def __init__(self, min_cluster_size: int = 10):
        super().__init__(min_cluster_size=min_cluster_size)
        self.min_cluster_size = min_cluster_size

    def fit(self, X, y=None):
        E = _env_features(X)
        if _HAS_HDBSCAN:
            clusterer = hdbscan.HDBSCAN(min_cluster_size=self.min_cluster_size)
            self.labels_ = clusterer.fit_predict(E)
        else:
            km = KMeans(n_clusters=4, random_state=42, n_init=5)
            self.labels_ = km.fit_predict(E)
        self.E_train_ = E
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        if len(E) == len(self.E_train_):
            return self.labels_.astype(float)
        D = cdist(E, self.E_train_)
        nearest = D.argmin(axis=1)
        return self.labels_[nearest].astype(float)


