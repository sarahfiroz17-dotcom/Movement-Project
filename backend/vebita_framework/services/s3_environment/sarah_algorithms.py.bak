@registry.register
class EnvGaussianProcessEnv(BaseAlgorithm):
    """GP with Matern kernel for smooth environmental response curves."""
    name        = "Env Gaussian Process (Matern)"
    service_id  = 3
    category    = "ml_supervised"
    library     = "sklearn"
    animals     = ["all"]
    description = "GP Matern kernel models spatial environmental smoothness"

    def __init__(self):
        super().__init__()
        kernel = Matern(length_scale=1.0, nu=1.5)
        self.model = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=0)

    def fit(self, X, y=None):
        E = _env_features(X)[:150, :4]
        self.model.fit(E, X[:150, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.model.predict(_env_features(X)[:, :4]).astype(float)


