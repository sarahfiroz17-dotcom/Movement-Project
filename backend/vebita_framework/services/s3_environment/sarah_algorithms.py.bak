@registry.register
class EnvKernelDensityEstimation(BaseAlgorithm):
    """KDE over environmental space — identifies habitat use intensity."""
    name        = "Env Kernel Density Estimation"
    service_id  = 3
    category    = "spatial"
    library     = "scipy"
    animals     = ["all"]
    description = "KDE in alt-speed space reveals environmental use intensity"

    def __init__(self, bandwidth: float = 0.3):
        super().__init__(bandwidth=bandwidth)
        self.bandwidth = bandwidth
        self.kde_ = None

    def fit(self, X, y=None):
        data = X[:, :2].T  # speed, altitude
        self.kde_ = stats.gaussian_kde(data, bw_method=self.bandwidth)
        self.is_fitted = True
        return self

    def predict(self, X):
        return self.kde_(X[:, :2].T).astype(float)


@registry.register
class EnvSpatialAutocorrelationMoransI(BaseAlgorithm):
    """Moran's I proxy: spatial autocorrelation of altitude zones."""
    name        = "Env Moran's I Proxy"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "Local spatial autocorrelation of altitude for habitat clustering"

    def __init__(self, window: int = 10):
        super().__init__(window=window)
        self.window = window

    def fit(self, X, y=None):
        self.global_mean_ = X[:, 1].mean()
        self.is_fitted = True
        return self

    def predict(self, X):
        alt = X[:, 1]
        n = len(alt)
        w = self.window
        z = alt - self.global_mean_
        local_I = np.zeros(n)
        for i in range(n):
            j_start = max(0, i - w)
            j_end   = min(n, i + w + 1)
            neighbors = np.concatenate([z[j_start:i], z[i+1:j_end]])
            if len(neighbors) > 0:
                local_I[i] = z[i] * neighbors.mean()
        return local_I.astype(float)


@registry.register
class EnvKriging(BaseAlgorithm):
    """Ordinary Kriging proxy: spatial interpolation of environmental scores."""
    name        = "Env Ordinary Kriging"
    service_id  = 3
    category    = "spatial"
    library     = "sklearn"
    animals     = ["all"]
    description = "Kriging-style GP spatial interpolation of altitude field"

    def __init__(self):
        super().__init__()
        kernel = RBF(length_scale=1.0) + WhiteKernel(noise_level=0.01)
        self.gp = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=0)

    def fit(self, X, y=None):
        # Use step index as 1D spatial coordinate
        coords = np.arange(len(X)).reshape(-1, 1).astype(float) / len(X)
        self.gp.fit(coords[:200], X[:200, 1])
        self.is_fitted = True
        return self

    def predict(self, X):
        coords = np.arange(len(X)).reshape(-1, 1).astype(float) / len(X)
        return self.gp.predict(coords).astype(float)


@registry.register
class EnvGeographicallyWeightedRegression(BaseAlgorithm):
    """GWR proxy: spatially varying environmental coefficients."""
    name        = "Env Geographically Weighted Regression"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "Local regression with Gaussian spatial weighting function"

    def __init__(self, bandwidth: int = 50):
        super().__init__(bandwidth=bandwidth)
        self.bandwidth = bandwidth
        self.local_means_ = None

    def fit(self, X, y=None):
        n = len(X)
        self.local_preds_ = np.zeros(n)
        E = _env_features(X)
        speed = X[:, 0]
        positions = np.arange(n)
        for i in range(n):
            w = np.exp(-0.5 * ((positions - i) / self.bandwidth) ** 2)
            wsum = w.sum()
            if wsum > 1e-9:
                self.local_preds_[i] = np.sum(w * speed) / wsum
        self.is_fitted = True
        return self

    def predict(self, X):
        n = len(X)
        preds = np.zeros(n)
        speed = X[:, 0]
        positions = np.arange(n)
        for i in range(n):
            w = np.exp(-0.5 * ((positions - i) / self.bandwidth) ** 2)
            wsum = w.sum()
            preds[i] = np.sum(w * speed) / wsum if wsum > 1e-9 else speed[i]
        return preds.astype(float)


@registry.register
class EnvPointPatternAnalysis(BaseAlgorithm):
    """Point pattern analysis — environmental clustering of GPS fixes."""
    name        = "Env Point Pattern Analysis"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "Nearest-neighbour distances reveal environmental aggregation"

    def __init__(self):
        super().__init__()
        self.mean_nn_dist_ = None

    def fit(self, X, y=None):
        E = _env_features(X)[:, :2]
        D = cdist(E, E)
        np.fill_diagonal(D, np.inf)
        nn_dists = D.min(axis=1)
        self.mean_nn_dist_ = nn_dists.mean()
        self.nn_dists_train_ = nn_dists
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)[:, :2]
        E_train = _env_features(X)[:, :2]  # same X
        D = cdist(E, E_train)
        np.fill_diagonal(D, np.inf)
        return D.min(axis=1).astype(float)


@registry.register
class EnvSpatialScanStatistic(BaseAlgorithm):
    """Spatial scan proxy — detect environmental hotspot windows."""
    name        = "Env Spatial Scan Statistic"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "Sliding window scan for high-density environmental use zones"

    def __init__(self, window: int = 20):
        super().__init__(window=window)
        self.window = window
        self.global_rate_ = None

    def fit(self, X, y=None):
        self.global_rate_ = X[:, 0].mean()
        self.is_fitted = True
        return self

    def predict(self, X):
        speed = X[:, 0]
        n = len(speed)
        w = self.window
        scores = np.zeros(n)
        for i in range(n):
            window_data = speed[max(0, i - w): min(n, i + w + 1)]
            local_rate = window_data.mean()
            scores[i] = (local_rate - self.global_rate_) / (self.global_rate_ + 1e-9)
        return scores.astype(float)


@registry.register
class EnvRipleysK(BaseAlgorithm):
    """Ripley's K function: clustering scale in environmental space."""
    name        = "Env Ripley's K"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "K-function evaluates environmental clustering at multiple scales"

    def __init__(self, r: float = 0.5):
        super().__init__(r=r)
        self.r = r

    def fit(self, X, y=None):
        E = _env_features(X)[:, :2]
        self.E_train_ = E
        n = len(E)
        D = cdist(E, E)
        self.K_ = np.sum(D < self.r) / (n * (n - 1))
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)[:, :2]
        D = cdist(E, self.E_train_)
        k_local = (D < self.r).sum(axis=1) / len(self.E_train_)
        return k_local.astype(float)


@registry.register
class EnvLandscapeConnectivity(BaseAlgorithm):
    """Landscape connectivity: path resistance from terrain and NDVI."""
    name        = "Env Landscape Connectivity"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "Resistance surface: high turn + high terrain = low connectivity"

    def __init__(self):
        super().__init__()

    def fit(self, X, y=None):
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        terrain = E[:, 0]  # terrain ruggedness
        ndvi    = E[:, 2]  # NDVI proxy (higher = more vegetation friction)
        resistance = (terrain / (terrain.max() + 1e-9) + ndvi / (ndvi.max() + 1e-9)) / 2
        connectivity = 1 - resistance
        return connectivity.astype(float)


@registry.register
class EnvThiessenPolygons(BaseAlgorithm):
    """Thiessen polygon proxy: assigns env zone by nearest cluster centroid."""
    name        = "Env Thiessen Polygon Proxy"
    service_id  = 3
    category    = "spatial"
    library     = "sklearn"
    animals     = ["all"]
    description = "Voronoi-style habitat zone assignment from cluster centroids"

    def __init__(self, n_zones: int = 5):
        super().__init__(n_zones=n_zones)
        self.km = KMeans(n_clusters=n_zones, random_state=42, n_init=5)

    def fit(self, X, y=None):
        E = _env_features(X)[:, :2]
        self.km.fit(E)
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)[:, :2]
        return self.km.predict(E).astype(float)


@registry.register
class EnvSpatialRegressionProxy(BaseAlgorithm):
    """Spatial lag regression: movement influenced by neighbourhood environment."""
    name        = "Env Spatial Lag Regression"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "Spatial lag model: neighbouring altitude predicts local speed"

    def __init__(self, lag: int = 5, rho: float = 0.5):
        super().__init__(lag=lag, rho=rho)
        self.lag = lag
        self.rho = rho
        self.model = LinearRegression()

    def fit(self, X, y=None):
        alt = X[:, 1]
        # Spatial lag = average altitude of neighbours (window)
        lag_alt = np.convolve(alt, np.ones(self.lag) / self.lag, mode="same")
        E = _env_features(X)
        Xlr = np.column_stack([E, lag_alt])
        self.model.fit(Xlr, X[:, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        alt = X[:, 1]
        lag_alt = np.convolve(alt, np.ones(self.lag) / self.lag, mode="same")
        E = _env_features(X)
        Xlr = np.column_stack([E, lag_alt])
        return self.model.predict(Xlr).astype(float)


@registry.register
class EnvGetisOrd(BaseAlgorithm):
    """Getis-Ord Gi*: local hotspot detection in environmental use space."""
    name        = "Env Getis-Ord Gi*"
    service_id  = 3
    category    = "spatial"
    library     = "numpy"
    animals     = ["all"]
    description = "Local G-statistic identifies environmental hotspots and coldspots"

    def __init__(self, window: int = 15):
        super().__init__(window=window)
        self.window = window

    def fit(self, X, y=None):
        s = X[:, 0]
        self.global_mean_ = s.mean()
        self.global_std_  = s.std() + 1e-9
        self.is_fitted = True
        return self

    def predict(self, X):
        s = X[:, 0]
        n = len(s)
        w = self.window
        G = np.zeros(n)
        for i in range(n):
            window = s[max(0, i - w): min(n, i + w + 1)]
            G[i] = (window.mean() - self.global_mean_) / self.global_std_ * np.sqrt(len(window))
        return G.astype(float)


