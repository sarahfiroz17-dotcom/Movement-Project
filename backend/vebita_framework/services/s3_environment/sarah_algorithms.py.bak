@registry.register
class EnvStepwiseRegression(BaseAlgorithm):
    """Stepwise-style regression via iterative feature importance pruning."""
    name        = "Env Stepwise Regression"
    service_id  = 3
    category    = "statistical"
    library     = "sklearn"
    animals     = ["all"]
    description = "Forward selection of significant environmental predictors"

    def __init__(self, max_features: int = 6):
        super().__init__(max_features=max_features)
        self.max_features = max_features
        self.selected = None
        self.model = LinearRegression()

    def fit(self, X, y=None):
        E = _env_features(X)
        n_feat = E.shape[1]
        selected = []
        remaining = list(range(n_feat))
        for _ in range(min(self.max_features, n_feat)):
            best_score = -np.inf
            best_f = None
            for f in remaining:
                cols = selected + [f]
                m = LinearRegression()
                m.fit(E[:, cols], X[:, 0])
                score = r2_score(X[:, 0], m.predict(E[:, cols]))
                if score > best_score:
                    best_score = score
                    best_f = f
            if best_f is not None:
                selected.append(best_f)
                remaining.remove(best_f)
        self.selected = selected
        self.model.fit(E[:, self.selected], X[:, 0])
        self.is_fitted = True
        return self

    def predict(self, X):
        E = _env_features(X)
        return self.model.predict(E[:, self.selected]).astype(float)


